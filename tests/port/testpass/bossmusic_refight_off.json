{
 "desc": "No fight is silent: with \"pm64_boss_music\" off, Paper Mario 64's Jr. Troopa refight plays TTYD's own boss theme, not PM64's",
 "groups": [
  "pm64",
  "bossmusic"
 ],
 "versions": [
  "us"
 ],
 "settings": {
  "pm64_bosses": 1,
  "pm64_join": 0,
  "pm64_boss_music": 0,
  "skip_scenes": 1,
  "skip_any_scene": 1
 },
 "env": {
  "TTYD_PM64_ROM": "{pm64rom}",
  "TTYD_PM64_LOG": 1,
  "TTYD_MAP": "gor_01",
  "TTYD_STORY": 405,
  "TTYD_MODE_TEST": "pm64:0:2",
  "TTYD_AUTO_TEXT": 1,
  "TTYD_EXIT_FRAMES": 9000
 },
 "input": [
  "wait_seq 4 6000",
  "wait 300",
  "end"
 ],
 "log_must": [
  "\\[pm64\\] boss: Jr\\. Troopa",
  "\\[music\\] battle music: BGM_CHUBOSS_BATTLE1"
 ],
 "log_must_not": [
  "\\[music\\] battle with no music",
  "\\[pm64\\] music: Paper Mario 64: Jr\\. Troopa Battle"
 ],
 "timeout": 600
}
