  "TTYD_MAP": "gon_11",
  "TTYD_STORY": "54",
  "TTYD_PARTY": "1,2,3,4,5,6,7",
  "TTYD_AUTO_BATTLE": "1",
  "TTYD_AUTO_TATTLE": "1",
  "TTYD_AUTO_TEXT": "1",
  "TTYD_GOD": "1",
