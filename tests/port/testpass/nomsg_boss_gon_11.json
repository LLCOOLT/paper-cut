{
 "desc": "No messages sweep: Hooktail's room entered as the story reaches it (gon_11, story 54), its scene, the fight (Goombella Tattles it) and after; no tag may be missing",
 "groups": [
  "nomsg"
 ],
 "versions": [
  "us"
 ],
