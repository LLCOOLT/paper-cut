{
 "desc": "items and coins both ways through a relay room, the host's and then the guest's connection dropped by the relay mid-session (tickets, re-key, resume)",
 "groups": [
  "online"
 ],
 "versions": [
  "us"
 ],
 "backend": "headless",
 "env": {
  "TTYD_MAP": "gor_01",
  "TTYD_EXIT_FRAMES": 2700
 },
 "online": {
  "players": [
   {
    "role": "host",
    "input": [
     "wait 60",
     "give 148",
     "give 148",
     "coins 150",
     "flag 1000",
     "story 20",
     "join 2",
     "wait 900",
     "give 149",
     "coins 77",
     "wait 300",
     "give 150",
     "flag 1001",
     "wait 1200"
    ],
    "log_must": [
     "connection to the relay was lost"
    ],
    "env": {
     "TTYD_SYNC_PICK": -1
    }
   },
   {
    "role": "guest",
    "input": [
     "wait 60",
     "give 154",
     "give 62",
     "wait 900",
     "give 240",
     "coins 10",
     "wait 300",
     "give 155",
     "flag 1002",
     "wait 1200"
    ],
    "env": {
     "TTYD_SYNC_AT": 600
    },
    "log_must": [
     "connection to the relay was lost"
    ]
   }
  ],
  "link": "relay",
  "relay_args": [
   "--kill",
   "host:3.5",
   "guest:3"
  ]
 },
 "timeout": 300
}
