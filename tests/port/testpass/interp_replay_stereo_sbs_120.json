{
 "desc": "Stereoscopic 3D side by side at 120 Hz by replay (gor_01 walk): the game draws the right eye once; the left eye and every in-between frame's two eyes are its recording replayed with the eye's shift",
 "groups": [
  "interp",
  "stereo"
 ],
 "versions": [
  "us"
 ],
 "env": {
  "TTYD_MAP": "gor_01",
  "TTYD_FRAMERATE": 120,
  "TTYD_INTERP_MODE": "replay",
  "TTYD_DRAWONCE_STRICT": 1
 },
 "settings": {
  "stereo_3d": 1
 },
 "input": "tests/port/input/gor_01_walk.txt",
 "stereo_check": {
  "layout": "sbs",
  "shots": [
   "walk_0_start",
   "walk_1_right"
  ],
  "depth": true
 },
 "log_must": [
  "^\\[input\\] end$"
 ],
 "log_must_not": [
  "\\*\\*\\* crash",
  "^\\[drawonce\\] FAIL",
  "^\\[interp-replay\\] a frame not replayed"
 ],
 "timeout": 180
}
