{
 "desc": "a shared script battle (hei_03's four Goombas): the host's game quits mid-battle; the guest finishes it alone, as run away",
 "groups": [
  "online"
 ],
 "versions": [
  "us"
 ],
 "backend": "headless",
 "env": {
  "TTYD_AUTO_BATTLE": 1,
  "TTYD_GOD": 1,
  "TTYD_AUTO_TEXT": 1,
  "TTYD_MAP": "hei_03",
  "TTYD_STORY": 11,
  "TTYD_EXIT_FRAMES": 5600
 },
 "online": {
  "players": [
   {
    "role": "host",
    "env": {
     "TTYD_EXIT_FRAMES": 1300,
     "TTYD_SYNC_PICK": -1
    },
    "input": [
     "wait_peer here 6000",
     "wait_peer field 4000",
     "wait 200",
     "give 148",
     "battle 4",
     "wait 1000"
    ]
   },
   {
    "role": "guest",
    "input": [
     "wait_peer battle 8000",
     "wait 5200"
    ],
    "log_must": [
     "this battle alone, as run away",
     "the shared battle ends"
    ]
   }
  ],
  "check": {
   "battle_ended": false,
   "progress": false,
   "names": true
  }
 },
 "timeout": 480
}
