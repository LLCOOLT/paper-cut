{
 "desc": "A party game from a co-op session (Aurora, no window): the host of a relay room plays the full run's segment 3 checkpoint with a co-op guest, they walk together, then the host picks Bingo on the Multiplayer page (its Party... pick); a card beside the adventure, so the room's pick is back to the adventure the same frame (pick 15 is never there to wait for), the room goes back to the adventure and both games agree again (same room, story, partner, Mario's place, settled)",
 "groups": [
  "mpparty"
 ],
 "versions": [
  "us"
 ],
 "backend": "offscreen",
 "user_gen": [
  {
   "script": "tools/port/mp_card.py",
   "dest": "start.gci",
   "args": [
    "tests/port/full_run/checkpoints/{version}/03_sewers.sav",
    "--region",
    "{version}",
    "--card"
   ]
  }
 ],
 "env": {
  "TTYD_LOAD_SAVE": "{out}/user/start.gci",
  "TTYD_AUTO_BATTLE": "1",
  "TTYD_GOD": "1",
  "TTYD_AUTO_TEXT": "1",
  "TTYD_STORY_WATCH": "1200",
  "TTYD_SYNC_END_PICK": "back"
 },
 "online": {
  "link": "relay",
  "players": [
   {
    "role": "host",
    "backend": "offscreen",
    "input": [
     "wait_seq 2 3000",
     "press_until_control a 3000",
     "wait_peer coop 6000",
     "wait 120",
     "where coop 180",
     "walk_to -250 200 900",
     "where coop 180",
     "together bingo",
     "wait 300",
     "press_until_control a 6000",
     "wait_peer field 3000",
     "wait 240",
     "where coop 300",
     "wait 1800"
    ],
    "env": {
     "TTYD_SYNC_PICK": 1
    },
    "log_must": [
     "\\[input\\] together bingo .*: done",
     "\\[together\\] pick 15 ",
     "\\[together\\] the party game is over: back to the adventure",
     "\\[mp\\] where: map 'gor_02' .* \\| settled$"
    ]
   },
   {
    "role": "guest",
    "backend": "offscreen",
    "input": [
     "wait_seq 2 3000",
     "wait_peer here 6000",
     "wait 120",
     "wait_peer field 6000",
     "wait 360",
     "where coop",
     "wait 600"
    ],
    "env": {
     "TTYD_SYNC_AT": 400
    },
    "log_must": [
     "\\[together\\] the host picked 15 ",
     "\\[mp\\] where: map 'gor_02' .*guest 1"
    ]
   }
  ],
  "check": {
   "same_where": true
  }
 },
 "log_must_not": [
  "\\[mp\\] where: .*NOT SETTLED"
 ],
 "timeout": 900
}
