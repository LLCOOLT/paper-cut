{
 "desc": "An online guest leaves the host's card duel against it (Aurora, no window): from the full run's segment 3 checkpoint in a co-op relay room, the host picks Tattle cards (a duel between the players); during the draft the guest presses Z: its game closes the duel at once and tells the host, whose game ends it with a notice (the other player left), the room goes back to the adventure and both games agree again (same room, story, partner, Mario's place, settled)",
 "groups": [
  "mpparty"
 ],
 "versions": [
  "us"
 ],
 "backend": "offscreen",
 "user_gen": [
  {
   "script": "tools/port/mp_card.py",
   "dest": "start.gci",
   "args": [
    "tests/port/full_run/checkpoints/{version}/03_sewers.sav",
    "--region",
    "{version}",
    "--card"
   ]
  }
 ],
 "env": {
  "TTYD_LOAD_SAVE": "{out}/user/start.gci",
  "TTYD_AUTO_BATTLE": "1",
  "TTYD_GOD": "1",
  "TTYD_AUTO_TEXT": "1",
  "TTYD_STORY_WATCH": "1200",
  "TTYD_SYNC_END_PICK": "back"
 },
 "online": {
  "link": "relay",
  "players": [
   {
    "role": "host",
    "backend": "offscreen",
    "input": [
     "wait_seq 2 3000",
     "press_until_control a 3000",
     "wait_peer coop 6000",
     "wait 120",
     "where coop 180",
     "walk_to -250 200 900",
     "where coop 180",
     "together cards",
     "press_until_pick none 14 3000",
     "press_until_pick none 1 9000",
     "press_until_control a 6000",
     "wait_peer field 3000",
     "wait 240",
     "where coop 300",
     "wait 1800"
    ],
    "env": {
     "TTYD_SYNC_PICK": 1
    },
    "log_must": [
     "\\[input\\] together cards .*: done",
     "\\[together\\] pick 14 ",
     "\\[cards\\] duel against ",
     "\\[cards\\] player 2 left the duel: over",
     "\\[coop\\] The other player left the duel\\.",
     "\\[together\\] the party game is over: back to the adventure",
     "\\[mp\\] where: map 'gor_02' .* \\| settled$"
    ],
    "log_must_not": [
     "\\[cards\\] the duel is over: "
    ]
   },
   {
    "role": "guest",
    "backend": "offscreen",
    "input": [
     "wait_seq 2 3000",
     "wait_peer here 6000",
     "press_until_pick none 14 9000",
     "wait 240",
     "press z",
     "press_until_pick none 1 9000",
     "wait_peer field 6000",
     "wait 360",
     "where coop",
     "wait 600"
    ],
    "env": {
     "TTYD_SYNC_AT": 400
    },
    "log_must": [
     "\\[together\\] the host picked 14 ",
     "\\[cards\\] the host's duel against this player shown here",
     "\\[cards\\] this player left the host's duel",
     "\\[cards\\] the host's duel this player left is over",
     "\\[mp\\] where: map 'gor_02' .*guest 1"
    ]
   }
  ],
  "check": {
   "same_where": true
  }
 },
 "log_must_not": [
  "\\[mp\\] where: .*NOT SETTLED"
 ],
 "timeout": 900
}
