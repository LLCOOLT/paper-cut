{
 "desc": "Aurora: Brothers mode on both, a shared battle (Luigi is player 2)",
 "groups": [
  "online",
  "online_aurora"
 ],
 "versions": [
  "us"
 ],
 "backend": "headless",
 "env": {
  "TTYD_AUTO_BATTLE": 1,
  "TTYD_GOD": 1,
  "TTYD_AUTO_TEXT": 1,
  "TTYD_MAP": "hei_03",
  "TTYD_STORY": 11,
  "TTYD_EXIT_FRAMES": 7000
 },
 "online": {
  "players": [
   {
    "role": "host",
    "input": [
     "wait_peer here 6000",
     "wait_peer field 4000",
     "wait 900",
     "give 148",
     "battle 4",
     "wait 5300"
    ],
    "env": {
     "TTYD_SET_brothers_mode": 1,
     "TTYD_SYNC_PICK": -1
    },
    "backend": "offscreen"
   },
   {
    "role": "guest",
    "input": [
     "wait_peer battle 8000",
     "wait 5500"
    ],
    "env": {
     "TTYD_SET_brothers_mode": 1
    },
    "backend": "offscreen"
   }
  ],
  "check": {
   "battle_ended": true
  }
 },
 "timeout": 700
}
