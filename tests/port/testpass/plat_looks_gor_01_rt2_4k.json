{
 "desc": "Looks: gor_01 with rt2_4k (rt_lighting=2, resolution=6)",
 "groups": [
  "platform",
  "looks"
 ],
 "versions": [
  "us"
 ],
 "env": {
  "TTYD_MAP": "gor_01",
  "TTYD_EXIT_FRAMES": 400
 },
 "settings": {
  "rt_lighting": 2,
  "resolution": 6
 },
 "input": [
  "wait 200",
  "shot rt2_4k",
  "end"
 ],
 "expect_shots": [
  "rt2_4k"
 ],
 "log_must_not": [
  "rt_lighting: not supported",
  "(?i)validation error",
  "(?i)WGSL",
  "(?i)shader.*(error|failed)",
  "(?i)device lost"
 ],
 "timeout": 150
}
