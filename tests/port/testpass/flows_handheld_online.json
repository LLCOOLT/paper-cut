{
 "desc": "Handheld online through the local test relay: a desktop host (keyboard plus a controller) opens a room, a handheld guest (an AYN Odin sideways: touch controls and its built-in controller) joins by the code and plays together as player 2; the guest walks on the touch stick and jumps on the built-in controller (still its game's player 1, the touch controls hiding for it), the host walks; the host walks into the Spiky Goomba: a battle together (played by the computer), both back in the field; the guest leaves the room and joins the same code again; both walk again; both games' progress the same at the end",
 "groups": [
  "flows",
  "online"
 ],
 "versions": [
  "us"
 ],
 "backend": "offscreen",
 "env": {
  "TTYD_AUTO_BATTLE": 1,
  "TTYD_GOD": 1,
  "TTYD_AUTO_TEXT": 1,
  "TTYD_MAP": "tik_01",
  "TTYD_STORY": 21
 },
 "settings": {
  "background_input": 1
 },
 "online": {
  "players": [
   {
    "role": "host",
    "input": [
     "dev pad 1 attach xbox",
     "dev watch 240",
     "wait_peer coop 4000",
     "wait_peer room 4000",
     "dev wait 60",
     "dev key left 30",
     "dev pad 1 a 6",
     "dev wait 60",
     "dev until settled 300",
     "goto 443 -50 -40",
     "dev key down 40",
     "dev until battle 900",
     "dev until field 6000",
     "dev wait 120",
     "dev state after_battle",
     "wait_peer !here 6000",
     "dev state guest_left",
     "wait_peer coop 6000",
     "wait_peer room 4000",
     "dev wait 120",
     "dev state guest_back",
     "dev pad 1 right 30",
     "dev wait 60",
     "dev expect pad 1 port 1",
     "dev wait 2000"
    ],
    "env": {
     "TTYD_SYNC_PICK": 1
    },
    "log_must": [
     "^\\[flows\\] state guest_back"
    ]
   },
   {
    "role": "guest",
    "build": "touch",
    "input": [
     "dev pad 1 attach xbox",
     "dev watch 240",
     "wait_peer here 4000",
     "wait_peer room 4000",
     "dev wait 60",
     "dev expect pad 1 port 1",
     "dev touch stick-left 30",
     "dev wait 10",
     "dev expect touch shown",
     "dev pad 1 a 6",
     "dev wait 60",
     "dev expect touch hidden",
     "dev expect pad 1 port 1",
     "wait_peer battle 3000",
     "wait_peer field 6000",
     "dev wait 120",
     "dev state after_battle",
     "dev expect pad 1 port 1",
     "dev online leave",
     "dev wait 300",
     "dev state left",
     "dev online join 2TST-RXYM",
     "wait_peer here 4000",
     "wait_peer room 4000",
     "dev wait 120",
     "dev state back",
     "dev touch stick-right 30",
     "dev touch a 6",
     "dev wait 60",
     "dev expect pad 1 port 1",
     "dev wait 600"
    ],
    "env": {
     "TTYD_SYNC_END_PICK": "title",
     "TTYD_TOUCH_DEVICE": "1920x1080@370"
    },
    "log_must": [
     "end: You left the room\\.",
     "^\\[flows\\] state back"
    ]
   }
  ],
  "link": "relay",
  "check": {
   "battle_ended": true
  }
 },
 "timeout": 600,
 "log_must_not": [
  "STUCK"
 ]
}
