 },
 "input": [
  "wait 300",
  "press a",
  "wait 40",
  "shot quiz_join",
  "press start",
  "wait 90",
  "shot quiz_question",
  "press a",
  "wait 120",
  "shot quiz_reveal",
  "wait 10",
  "end"
 ],
 "log_must": [
  "\\[quiz\\] up",
  "\\[quiz\\] 1: "
 ],
