{
 "desc": "Looks: tik_00 with shadows1 (paper_shadows=1)",
 "groups": [
  "platform",
  "looks"
 ],
 "versions": [
  "us"
 ],
 "env": {
  "TTYD_MAP": "tik_00",
  "TTYD_EXIT_FRAMES": 400
 },
 "settings": {
  "paper_shadows": 1
 },
 "input": [
  "wait 200",
  "shot shadows1",
  "end"
 ],
 "expect_shots": [
  "shadows1"
 ],
 "log_must_not": [
  "rt_lighting: not supported",
  "(?i)validation error",
  "(?i)WGSL",
  "(?i)shader.*(error|failed)",
  "(?i)device lost"
 ],
 "timeout": 150
}
