{
 "desc": "Looks: jin_00 with rt2 (rt_lighting=2)",
 "groups": [
  "platform",
  "looks"
 ],
 "versions": [
  "us"
 ],
 "env": {
  "TTYD_MAP": "jin_00",
  "TTYD_EXIT_FRAMES": 400
 },
 "settings": {
  "rt_lighting": 2
 },
 "input": [
  "wait 200",
  "shot rt2",
  "end"
 ],
 "expect_shots": [
  "rt2"
 ],
 "log_must_not": [
  "rt_lighting: not supported",
  "(?i)validation error",
  "(?i)WGSL",
  "(?i)shader.*(error|failed)",
  "(?i)device lost"
 ],
 "timeout": 150,
 "log_must": [
  "^\\[rt\\] lighting level 2$"
 ]
}
