{
 "desc": "launcher_pm64_link on a phone held upright (touch sizes, 540x1170): the entry's buttons wrap in the stacked disc card",
 "groups": ["menus", "pm64"],
 "versions": ["us"],
 "library": ["us"],
 "settings": {"window_w": 540, "window_h": 1170},
 "env": {
  "TTYD_NO_LAUNCHER": null,
  "TTYD_LAUNCHER_TOUCH": 1,
  "TTYD_LAUNCHER_ADD": "2:{pm64rom}",
  "TTYD_PM64_ASK_ANSWER": "no",
  "TTYD_LAUNCHER_SHOT": "6:launcher_pm64_linked_phone",
  "TTYD_LAUNCHER_STILL": 1
 },
 "expect_shots": ["launcher_pm64_linked_phone"],
 "log_must": ["\\[pm64\\] linked US"],
 "exit": "any",
 "timeout": 30,
 "disc": false
}
