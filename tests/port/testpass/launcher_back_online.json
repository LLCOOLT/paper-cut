{
 "desc": "Back to the launcher while playing together online: the guest's leaves the room first (as Leave the room; its 'where now' window dropped, the player chose), goes back to its title and shows its launcher in this process ($TTYD_LAUNCHER_BACK_HERE), whose Play comes back to its title; the host goes on alone",
 "groups": [
  "online",
  "online_aurora",
  "launcher"
 ],
 "versions": [
  "us"
 ],
 "backend": "offscreen",
 "env": {
  "TTYD_MAP": "gor_01",
  "TTYD_STORY": "21",
  "TTYD_GOD": 1,
  "TTYD_EXIT_FRAMES": 2600
 },
 "online": {
  "players": [
   {
    "role": "host",
    "input": [
     "wait 2500"
    ],
    "env": {
     "TTYD_SYNC_PICK": 1
    },
    "log_must": [
     "co-op"
    ]
   },
   {
    "role": "guest",
    "input": [
     "wait 2500"
    ],
    "env": {
