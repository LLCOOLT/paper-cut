     "TTYD_LAUNCHER_SHOT": "1:launcher_back_online",
     "TTYD_LAUNCHER_STILL": 1
    },
    "log_must": [
     "\\[launcher-back\\] asked \\(.*, online",
     "\\[launcher-back\\] online: left the room",
     "\\[launcher-back\\] at the title",
     "\\[launcher-back\\] the launcher, in this process",
     "\\[launcher-back\\] back from the launcher: the game at its title"
    ],
    "log_must_not": [
