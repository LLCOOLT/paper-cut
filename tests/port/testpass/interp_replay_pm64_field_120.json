{
 "desc": "PM64 partners in the field at 120 Hz by replay (gor_01, Kooper's wheel): their own models and animations drawn once a game frame, in-between frames replayed",
 "groups": [
  "interp",
  "pm64"
 ],
 "versions": [
  "us"
 ],
 "env": {
  "TTYD_MAP": "gor_01",
  "TTYD_STORY": 405,
  "TTYD_PARTY": "2,1,3,4,5,6,7",
  "TTYD_PM64_ROM": "{pm64rom}",
  "TTYD_WHEEL_TEST": "10,90",
  "TTYD_EXIT_FRAMES": 3000,
  "TTYD_FRAMERATE": 120,
  "TTYD_INTERP_MODE": "replay",
  "TTYD_DRAWONCE_STRICT": 1
 },
 "settings": {
  "pm64_join": 0,
  "pm64_partners": 1,
  "pm64_met_all": 1
 },
 "input": "tests/port/input/pm64_field.txt",
 "log_must": [
  "\\[pm64\\] TTYD_PM64_ROM: linked US",
  "^\\[interp\\] 2 frames per game frame",
  "^\\[interp-replay\\] mode replay"
 ],
 "log_must_not": [
  "^\\[interp-replay\\] a frame not replayed",
  "\\*\\*\\* crash",
  "^\\[drawonce\\] FAIL"
 ],
 "timeout": 200
}
