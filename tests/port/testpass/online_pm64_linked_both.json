{
 "desc": "both games with their ROM linked and the PM64 partners on: they play together, a shared battle with Bombette ($PAPERCUT_PM64_ROM)",
 "groups": [
  "online",
  "pm64"
 ],
 "versions": [
  "us"
 ],
 "backend": "headless",
 "env": {
  "TTYD_AUTO_BATTLE": 1,
  "TTYD_GOD": 1,
  "TTYD_AUTO_TEXT": 1,
  "TTYD_MAP": "hei_03",
  "TTYD_STORY": 11,
  "TTYD_EXIT_FRAMES": 6600,
  "TTYD_PARTY": "3,1,2,4,5,6,7"
 },
 "online": {
  "players": [
   {
    "role": "host",
    "input": [
     "wait_peer here 6000",
     "wait_peer field 4000",
     "wait 900",
     "give 148",
     "battle 4",
     "wait 5300"
    ],
    "env": {
     "TTYD_PM64_ROM": "{pm64rom}",
     "TTYD_SET_pm64_partners": 1,
     "TTYD_SET_pm64_met_all": 1,
     "TTYD_SYNC_PICK": -1
    },
    "backend": "offscreen"
   },
   {
    "role": "guest",
    "input": [
     "wait_peer battle 8000",
     "wait 5500"
    ],
    "env": {
     "TTYD_PM64_ROM": "{pm64rom}",
     "TTYD_SET_pm64_partners": 1,
     "TTYD_SET_pm64_met_all": 1
    },
    "backend": "offscreen"
   }
  ],
  "check": {
   "battle_ended": true
  }
 },
 "timeout": 420
}
