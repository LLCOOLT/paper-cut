    ]
   },
   {
    "role": "guest2",
    "input": [
     "wait_peer battle 8000",
     "wait 5500"
    ]
   },
   {
    "role": "guest3",
    "input": [
     "wait_peer battle 8000",
     "wait 5500"
    ]
   }
