{
 "desc": "Dead ends: the settings page (F1) left with Esc's back",
 "groups": [
  "dead"
 ],
 "versions": [
  "us"
 ],
 "backend": "offscreen",
 "env": {
  "TTYD_MAP": "gor_01",
  "TTYD_STORY": "21",
  "TTYD_PARTY": "1",
  "TTYD_AUTO_TEXT": "1"
 },
 "settings": {
  "background_input": 1
 },
 "input": [
  "dev wait 120",
  "dev key f1 4",
  "dev wait 40",
  "dev expect page open",
  "dev key esc 4",
  "dev wait 30",
  "dev ifnot page closed then key esc 4",
  "dev wait 30",
  "dev ifnot page closed then key esc 4",
  "dev wait 30",
  "dev ifnot page closed then key esc 4",
  "dev wait 30",
  "dev ifnot page closed then key esc 4",
  "dev wait 30",
  "dev ifnot page closed then key esc 4",
  "dev wait 30",
  "dev expect page closed",
  "end"
 ],
 "timeout": 300,
 "log_must": [
  "^\\[flows\\] ok: page open",
  "^\\[flows\\] ok: page closed"
 ],
 "log_must_not": [
  "STUCK"
 ]
}
