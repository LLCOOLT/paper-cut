{
 "desc": "PM64 everything on: Goombario picked on the wheel in Rogueport's plaza, then the file saved into file 1 (input 'save') of a card that has one (olddata_make_2's, --run old041)",
 "groups": [
  "pm64x"
 ],
 "versions": [
  "us",
  "jp",
  "eu"
 ],
 "env": {
  "TTYD_PM64_ROM": "{pm64rom}",
  "TTYD_PM64_LOG": 1,
  "TTYD_PARTY": "1,2,3,4,5,6,7",
  "TTYD_WHEEL_TEST": "9,60",
  "TTYD_MAP": "gor_01",
  "TTYD_STORY": 405,
  "TTYD_EXIT_FRAMES": 1500,
  "TTYD_SET_pm64_partners": 1,
  "TTYD_SET_pm64_join": 0,
  "TTYD_SET_pm64_met_all": 1,
  "TTYD_SET_pm64_field": 0,
  "TTYD_SET_pm64_enemies": 1,
  "TTYD_SET_pm64_story_enemies": 2,
  "TTYD_SET_pm64_bosses": 1,
  "TTYD_SET_pm64_boss_music": 1,
  "TTYD_SET_pm64_music": 1,
  "TTYD_SET_pm64_badges": 1,
  "TTYD_SET_pm64_recipes": 1,
  "TTYD_SET_pm64_star_spirits": 1,
  "TTYD_SET_pm64_sfx": 1,
  "TTYD_SET_pm64_sfx_general": 1
 },
 "input": [
  "wait 200",
  "shot goombario",
  "save",
  "wait 300",
  "end"
 ],
 "expect_shots": [
  "goombario"
 ],
 "log_must": [
  "\\[pm64\\] TTYD_PM64_ROM: linked US",
  "\\[pm64\\] Goombario in 1's place",
  "\\[input\\] save: slot 0, map 'gor_01', story 405"
 ],
 "log_must_not": [
  "OSPanic",
  "\\bassert",
  "DRIFT"
 ],
 "timeout": 300,
 "user_files": [
  "local-docs/testpass/old041/olddata_make_2/{version}/user/"
 ]
}
