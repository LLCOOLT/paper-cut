{
 "desc": "Looks: gor_01 with rt1 (rt_lighting=1)",
 "groups": [
  "platform",
  "looks"
 ],
 "versions": [
  "us"
 ],
 "env": {
  "TTYD_MAP": "gor_01",
  "TTYD_EXIT_FRAMES": 400
 },
 "settings": {
  "rt_lighting": 1
 },
 "input": [
  "wait 200",
  "shot rt1",
  "end"
 ],
 "expect_shots": [
  "rt1"
 ],
 "log_must_not": [
  "rt_lighting: not supported",
  "(?i)validation error",
  "(?i)WGSL",
  "(?i)shader.*(error|failed)",
  "(?i)device lost"
 ],
 "timeout": 150,
 "log_must": [
  "^\\[rt\\] lighting level [12]$"
 ]
}
