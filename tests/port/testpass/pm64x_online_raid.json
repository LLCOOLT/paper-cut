{
 "desc": "online raid boss with both games linked, PM64 everything on (bosses too), Goombario out in both",
 "groups": [
  "pm64x"
 ],
 "versions": [
  "us"
 ],
 "backend": "headless",
 "env": {
  "TTYD_MAP": "gor_01",
  "TTYD_EXIT_FRAMES": 9000,
  "TTYD_AUTO_BATTLE": 1,
  "TTYD_GOD": 1,
  "TTYD_AUTO_TEXT": 1
 },
 "online": {
  "players": [
   {
    "role": "host",
    "input": [
     "wait 3000",
     "shot raid",
     "wait 5900"
    ],
    "backend": "offscreen",
    "env": {
     "TTYD_PM64_ROM": "{pm64rom}",
     "TTYD_PM64_LOG": 1,
     "TTYD_SYNC_MENU_AT": "900:raid",
     "TTYD_WHEEL_TEST": "9,60",
     "TTYD_PARTY": "1,2,3,4,5,6,7"
    },
    "settings": {
     "pm64_partners": 1,
     "pm64_join": 0,
     "pm64_met_all": 1,
     "pm64_field": 0,
     "pm64_enemies": 1,
     "pm64_story_enemies": 2,
     "pm64_bosses": 1,
     "pm64_boss_music": 1,
     "pm64_music": 1,
     "pm64_badges": 1,
     "pm64_recipes": 1,
     "pm64_star_spirits": 1,
     "pm64_sfx": 1,
     "pm64_sfx_general": 1
    },
    "log_must": [
     "\\[pm64\\] TTYD_PM64_ROM: linked US",
     "raid: started here",
     "a script.s battle. here"
    ],
    "log_must_not": [
     "OSPanic",
     "\\bassert"
    ]
   },
   {
    "role": "guest",
    "input": [
     "wait 3000",
     "shot raid",
     "wait 5900"
    ],
    "backend": "offscreen",
    "env": {
     "TTYD_PM64_ROM": "{pm64rom}",
     "TTYD_PM64_LOG": 1,
     "TTYD_WHEEL_TEST": "9,60",
     "TTYD_PARTY": "1,2,3,4,5,6,7"
    },
    "settings": {
     "pm64_partners": 1,
     "pm64_join": 0,
     "pm64_met_all": 1,
     "pm64_field": 0,
     "pm64_enemies": 1,
     "pm64_story_enemies": 2,
     "pm64_bosses": 1,
     "pm64_boss_music": 1,
     "pm64_music": 1,
     "pm64_badges": 1,
     "pm64_recipes": 1,
     "pm64_star_spirits": 1,
     "pm64_sfx": 1,
     "pm64_sfx_general": 1
    },
    "log_must": [
     "\\[pm64\\] TTYD_PM64_ROM: linked US",
     "raid: the host started one",
     "the shared battle begins"
    ],
    "log_must_not": [
     "OSPanic",
     "\\bassert",
     "fighting alone"
    ]
   }
  ],
  "check": {
   "progress": false
  }
 },
 "timeout": 700
}
