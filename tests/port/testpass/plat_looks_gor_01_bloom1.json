{
 "desc": "Looks: gor_01 with bloom1 (bloom=1)",
 "groups": [
  "platform",
  "looks"
 ],
 "versions": [
  "us"
 ],
 "env": {
  "TTYD_MAP": "gor_01",
  "TTYD_EXIT_FRAMES": 400
 },
 "settings": {
  "bloom": 1
 },
 "input": [
  "wait 200",
  "shot bloom1",
  "end"
 ],
 "expect_shots": [
  "bloom1"
 ],
 "log_must_not": [
  "rt_lighting: not supported",
  "(?i)validation error",
  "(?i)WGSL",
  "(?i)shader.*(error|failed)",
  "(?i)device lost"
 ],
 "timeout": 150,
 "log_must": [
  "^\\[bloom\\] preset 1$"
 ]
}
