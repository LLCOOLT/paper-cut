{
 "desc": "online: only the host linked (PM64 everything on), the guest has no ROM: both refuse with the PM64 note",
 "groups": [
  "pm64x"
 ],
 "versions": [
  "us"
 ],
 "backend": "headless",
 "env": {
  "TTYD_MAP": "gor_01",
  "TTYD_EXIT_FRAMES": 900
 },
 "online": {
  "players": [
   {
    "role": "host",
    "input": [
     "wait 800"
    ],
    "backend": "offscreen",
    "env": {
     "TTYD_PM64_ROM": "{pm64rom}",
     "TTYD_PM64_LOG": 1
    },
    "settings": {
     "pm64_partners": 1,
     "pm64_join": 0,
     "pm64_met_all": 1,
     "pm64_field": 0,
     "pm64_enemies": 1,
     "pm64_story_enemies": 2,
     "pm64_bosses": 1,
     "pm64_boss_music": 1,
     "pm64_music": 1,
     "pm64_badges": 1,
     "pm64_recipes": 1,
     "pm64_star_spirits": 1,
     "pm64_sfx": 1,
     "pm64_sfx_general": 1
    },
    "log_must": [
     "\\[pm64\\] TTYD_PM64_ROM: linked US",
     "Paper Mario 64 partners are on in one game"
    ],
    "log_must_not": [
     "OSPanic",
     "\\bassert"
    ]
   },
   {
    "role": "guest",
    "input": [
     "wait 800"
    ],
    "backend": "offscreen",
    "env": {
     "TTYD_PM64_LOG": 1
    },
    "settings": {},
    "log_must": [
     "Paper Mario 64 partners are on in one game"
    ],
    "log_must_not": [
     "OSPanic",
     "\\bassert"
    ]
   }
  ],
  "check": {
   "linked": false,
   "progress": false,
   "names": false
  }
 },
 "timeout": 420
}
