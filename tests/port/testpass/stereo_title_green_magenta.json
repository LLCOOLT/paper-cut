{
 "desc": "Stereoscopic 3D: the title screen and the title menu, anaglyph green-magenta (stereo_3d=6), widescreen",
 "groups": [
  "platform",
  "stereo"
 ],
 "versions": [
  "us"
 ],
 "env": {
  "TTYD_TITLE_MENU": 1
 },
 "settings": {
  "stereo_3d": 6,
  "widescreen": 1
 },
 "input": [
  "wait 900",
  "shot title",
  "press start",
  "wait 120",
  "shot title_menu",
  "end"
 ],
 "expect_shots": [
  "title",
  "title_menu"
 ],
 "log_must_not": [
  "(?i)validation error",
  "(?i)WGSL",
  "(?i)shader.*(error|failed)",
  "(?i)device lost",
  "stereo: no custom draws"
 ],
 "timeout": 150,
 "stereo_check": {
  "layout": "green_magenta",
  "shots": [
   "title",
   "title_menu"
  ],
  "depth": false,
  "max_moving": 1.0
 }
}
