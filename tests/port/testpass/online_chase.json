{
 "desc": "Rogueport Sewers (tik_01): the host (the room's owner) stays by the entrance, the guest stops near the Spiky Goomba; the host's game moves it after the guest (the nearest player), who meets it and starts the shared battle in their own game",
 "groups": [
  "online"
 ],
 "versions": [
  "us"
 ],
 "backend": "headless",
 "env": {
  "TTYD_AUTO_BATTLE": 1,
  "TTYD_GOD": 1,
  "TTYD_AUTO_TEXT": 1,
  "TTYD_MAP": "tik_01",
  "TTYD_STORY": 21,
  "TTYD_EXIT_FRAMES": 5800
 },
 "online": {
  "players": [
   {
    "role": "host",
    "input": [
     "wait 5600"
    ],
    "log_must": [
     "the shared battle begins"
    ],
    "env": {
     "TTYD_SYNC_PICK": -1
    }
   },
   {
    "role": "guest",
    "input": [
     "wait 150",
     "goto 443 -50 -40",
     "wait 5300"
    ],
    "log_must": [
     "met.*invited|invited.*met|fought .*invited"
    ]
   }
  ],
  "check": {
   "battle_ended": true
  }
 },
 "timeout": 420
}
