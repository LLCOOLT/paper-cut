{
 "desc": "Multiplayer page, Party: the host picks Quiz party; it starts in the host's game once the field is free, and the guest follows the pick",
 "groups": [
  "online",
  "online_aurora",
  "together"
 ],
 "versions": [
  "us"
 ],
 "backend": "headless",
 "env": {
  "TTYD_MAP": "gor_01",
  "TTYD_EXIT_FRAMES": 4000,
  "TTYD_AUTO_TEXT": 1,
  "TTYD_GOD": 1
 },
 "online": {
  "players": [
   {
    "role": "host",
    "input": [
     "wait 3900"
    ],
    "env": {
     "TTYD_TOGETHER_PICK": "900:quiz"
    },
    "log_must": [
     "\\[together\\] pick 13 "
    ],
    "log_must_not": [
     "couldn't start",
     "[together] test pick .* refused",
     "Player 2 left: the partner follows Mario"
    ],
    "backend": "offscreen"
   },
   {
    "role": "guest",
    "input": [
     "wait 3900"
    ],
    "env": {},
    "log_must": [
     "\\[together\\] the host picked 13 "
    ],
    "backend": "offscreen"
   }
  ],
  "check": {
   "progress": false
  }
 },
 "timeout": 600
}