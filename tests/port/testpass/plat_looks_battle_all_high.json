{
 "desc": "Looks: Petal Meadows battle (hei_01, battle 0), everything high (ray tracing High, shadows High, bloom Strong, MSAA, widescreen); MSAA: TTYD_SHOT's readback is off with MSAA, so the player's screenshot (TTYD_USER_SHOT, in the user folder's photos: run with --keep-user)",
 "groups": [
  "platform",
  "looks"
 ],
 "versions": [
  "us"
 ],
 "env": {
  "TTYD_MAP": "hei_01",
  "TTYD_EXIT_FRAMES": 1300,
  "TTYD_USER_SHOT": 1100,
  "TTYD_STORY": 24
 },
 "settings": {
  "rt_lighting": 2,
  "paper_shadows": 2,
  "bloom": 2,
  "msaa": 1,
  "widescreen": 1
 },
 "input": "tests/port/input/plat_battle.txt",
 "expect_shots": [],
 "log_must_not": [
  "rt_lighting: not supported",
  "(?i)validation error",
  "(?i)WGSL",
  "(?i)shader.*(error|failed)",
  "(?i)device lost"
 ],
 "timeout": 200,
 "log_must": [
  "^\\[warp\\] frame \\d+: to hei_01\\b",
  "^\\[shot\\] wrote .*Paper Cut [^/\\\\]*\\.png$",
  "^\\[input\\] end$"
 ]
}
