{
 "desc": "An online guest leaves the host's quiz (Aurora, no window): from the full run's segment 3 checkpoint in a co-op relay room, the host picks Quiz party; both join with A and the host starts it; during the first question the guest presses Z: its game closes the quiz at once and tells the host, whose game takes player 2 out (a notice) and plays on alone, B through its ten questions, B on the results; the guest's game shows nothing more of it until the host's quiz is over, then the room goes back to the adventure and both games agree again (same room, story, partner, Mario's place, settled)",
 "groups": [
  "mpparty"
 ],
 "versions": [
  "us"
 ],
 "backend": "offscreen",
 "user_gen": [
  {
   "script": "tools/port/mp_card.py",
   "dest": "start.gci",
   "args": [
    "tests/port/full_run/checkpoints/{version}/03_sewers.sav",
    "--region",
    "{version}",
    "--card"
   ]
  }
 ],
 "env": {
  "TTYD_LOAD_SAVE": "{out}/user/start.gci",
  "TTYD_AUTO_BATTLE": "1",
  "TTYD_GOD": "1",
  "TTYD_AUTO_TEXT": "1",
  "TTYD_STORY_WATCH": "1200",
  "TTYD_SYNC_END_PICK": "back"
 },
 "online": {
  "link": "relay",
  "players": [
   {
    "role": "host",
    "backend": "offscreen",
    "input": [
     "wait_seq 2 3000",
     "press_until_control a 3000",
     "wait_peer coop 6000",
     "wait 120",
     "where coop 180",
     "walk_to -250 200 900",
     "where coop 180",
     "together quiz",
     "press_until_pick none 13 3000",
     "wait 120",
     "press a",
     "wait 150",
     "press start",
     "press_until_pick b 1 15000",
     "press_until_control a 6000",
     "wait_peer field 3000",
     "wait 240",
     "where coop 300",
     "wait 1800"
    ],
    "env": {
     "TTYD_SYNC_PICK": 1
    },
    "log_must": [
     "\\[input\\] together quiz .*: done",
     "\\[together\\] pick 13 ",
     "\\[quiz\\] player 2 left the quiz$",
     "\\[coop\\] Player 2 left the quiz\\.",
     "\\[quiz\\] 10: ",
     "\\[quiz\\] result: 1 player, P1 ",
     "\\[quiz\\] over",
     "\\[together\\] the party game is over: back to the adventure",
     "\\[mp\\] where: map 'gor_02' .* \\| settled$"
    ]
   },
   {
    "role": "guest",
    "backend": "offscreen",
    "input": [
     "wait_seq 2 3000",
     "wait_peer here 6000",
     "press_until_pick none 13 9000",
     "wait 60",
     "press a",
     "wait 300",
     "press z",
     "press_until_pick none 1 15000",
     "wait_peer field 6000",
     "wait 360",
     "where coop",
     "wait 600"
    ],
    "env": {
     "TTYD_SYNC_AT": 400
    },
    "log_must": [
     "\\[together\\] the host picked 13 ",
     "\\[quiz\\] the host's quiz shown here",
     "\\[quiz\\] this player left the host's quiz",
     "\\[quiz\\] the host's quiz this player left is over",
     "\\[mp\\] where: map 'gor_02' .*guest 1"
    ]
   }
  ],
  "check": {
   "same_where": true
  }
 },
 "log_must_not": [
  "\\[mp\\] where: .*NOT SETTLED"
 ],
 "timeout": 900
}
