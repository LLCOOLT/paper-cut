{
 "desc": "a 0.5.0 game hosts by address; a 0.4.1 game (lockstep, Aurora offscreen) joins it: refused cleanly, both play on",
 "groups": [
  "online",
  "online_old"
 ],
 "versions": [
  "us"
 ],
 "backend": "headless",
 "env": {
  "TTYD_MAP": "gor_01",
  "TTYD_EXIT_FRAMES": 12000
 },
 "online": {
  "players": [
   {
    "role": "host",
    "input": [
     "wait 11900"
    ],
    "log_must": [
     "a connection that isn.t a guest.s sync game: closed"
    ],
    "env": {
     "TTYD_SYNC_PICK": -1
    }
   },
   {
    "role": "guest",
    "tree": "ref041",
    "backend": "offscreen",
    "link": false,
    "checked": false,
    "exit": "any",
    "allow_failures": [
     "stall"
    ],
    "env": {
     "TTYD_ONLINE_JOIN": "[::1]:{port}"
    },
    "input": [
     "wait 11900"
    ]
   }
  ],
  "check": {
   "linked": false,
   "progress": false,
   "names": false
  }
 },
 "timeout": 420
}
