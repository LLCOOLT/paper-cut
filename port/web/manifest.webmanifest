{
  "name": "Paper Cut",
  "short_name": "Paper Cut",
  "description": "Paper Mario: The Thousand-Year Door, from your own disc image.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#1d1030",
  "theme_color": "#1d1030",
  "categories": ["games"],
  "icons": [
    { "src": "papercut-256.png", "sizes": "256x256", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/octet-stream": [".iso", ".gcm", ".ciso", ".gcz", ".rvz", ".wia", ".wbfs", ".nfs", ".tgc"]
      }
    }
  ]
}
