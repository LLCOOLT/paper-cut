# ---- the gem (5 whole, 6 glowing, 7 cracked; on the loose one 17 cracked, 18 glinting): the game's
# star (hoshi_2's), ruby
colours CRACK #2a0605 PALE #ffc8a0 HOT #ffe8c8

image art/models/c_lp_statue/5.png
  canvas 72 72
  piece gem model hoshi_2 2
  @gem hsv where a>=128 s>0.4 : hue -48 sat *0.95
  paste gem 4 4
  alpha cut 128
end

image art/models/c_lp_statue/6.png
  canvas 72 72
  piece gem model hoshi_2 2
  @gem hsv where a>=128 s>0.4 : hue -38 sat *0.75 val *1.1
  paste gem 4 4
  grow 3 PALE
  alpha cut 128
end

image art/models/c_lp_statue/7.png
  canvas 72 72
  piece gem model hoshi_2 2
  @gem hsv where a>=128 s>0.4 : hue -48 sat *0.95 val *0.9
  paste gem 4 4
  mask crack poly 33,10 37,10 40,26 33,34 42,44 36,62 33,62 37,45 29,34 36,26
  mask crack + poly 39,34 56,28 57,30 40,38
  stamp crack CRACK
  alpha cut 128
end

