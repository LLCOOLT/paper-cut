  mask arm poly 163,110 172,106 192,114 210,134 216,150 224,176 222,196 200,204 176,198 168,176 170,160 178,146 172,132 164,124
  mask out rect 0 0 231 207
  mask out - mask arm
  alpha set 0 in out
  crop 156 102 72 112
  alpha cut 128
end

