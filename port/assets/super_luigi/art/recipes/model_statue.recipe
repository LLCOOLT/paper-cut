# The walking statue (c_lp_statue, ART_PLAN row 8): the game's own stone golem (c_oko-ru's one sheet,
# 232x208), its blue camouflage turned to sandstone, cut into the rig's cards. The cards are at the
# game's giant-boss density (4 texels a unit, as Hooktail's): half the drawn ones' texels on the same
# quads, so no motion changes. The drawn cards stay in the model as the fallbacks.
# Card numbers: python tools/port/sl_models.py cards c_lp_statue

colours LINE #1a1410 PIT #33291f GLOW #ffa030 CORE #ffe08a

# ---- the head (8): the golem's block from crown to mouth, its dials made a niche for the gem
image art/models/c_lp_statue/8.png
  load model c_oko-ru 0
  hsv hue =35 sat *0.5
  colours FACE sample 64 130
  # the dials: a dark carved niche (the gem's own card sits in it)
  mask niche poly 67,36 80,28 103,25 127,28 140,36 132,66 106,62 79,65
  fill in niche where v>0.14 PIT
  # its eyes filled in: the eyes are their own card, lit or dark
  mask eyes poly 49,95 92,95 90,108 76,127 66,127 56,112
  mask eyes + poly 95,95 139,95 134,110 120,127 110,127 98,110
  fill in eyes FACE
  # the block alone, cut along the middle of its line; the fist and the chest gone
  mask block poly 55,22 75,12 104,8 138,10 166,21 169,40 163,66 170,84 171,106 164,112 164,156 46,156 48,128 49,104 52,82 60,66 58,48
  mask out rect 0 0 231 207
  mask out - mask block
  alpha set 0 in out
  crop 38 4 130 156
  scale 200 176 texel
  crop -4 -4 208 184
  grow 4 LINE
  alpha cut 128
end

# ---- the eyes (3 lit, 4 dark): the golem's own eye shapes, in the eyes' band of the head
image art/models/c_lp_statue/3.png
  canvas 144 48
  piece l model c_oko-ru 0
  @l crop 50 95 42 31
  @l alpha set 0 where l>=70
  @l scale 56 40 texel
  piece r model c_oko-ru 0
  @r crop 96 95 42 31
  @r alpha set 0 where l>=70
  @r scale 56 40 texel
  @l fill where a>=128 GLOW
  @r fill where a>=128 GLOW
  paste l 8 4
  paste r 80 4
  mask core poly 22,12 50,12 38,28 34,28
  mask core + poly 94,12 122,12 110,28 106,28
  stamp core CORE
  alpha cut 128
end

image art/models/c_lp_statue/4.png
  canvas 144 48
  piece l model c_oko-ru 0
  @l crop 50 95 42 31
  @l alpha set 0 where l>=70
  @l scale 56 40 texel
  piece r model c_oko-ru 0
  @r crop 96 95 42 31
  @r alpha set 0 where l>=70
  @r scale 56 40 texel
  @l fill where a>=128 PIT
  @r fill where a>=128 PIT
  paste l 8 4
  paste r 80 4
  alpha cut 128
end

# ---- the body (2): plain mottle from the block, above the eyes and under the mouth, one course over the other
image art/models/c_lp_statue/2.png
  canvas 216 104
  piece top model c_oko-ru 0
  @top hsv hue =35 sat *0.5
  @top crop 56 66 110 30
  @top scale 216 56 texel
  piece bot model c_oko-ru 0
  @bot hsv hue =35 sat *0.5
  @bot crop 52 150 118 26
  @bot scale 216 50 texel
  paste bot 0 54
  paste top 0 0
  mask torso poly 8,8 208,8 200,30 170,96 46,96 16,30
  mask out rect 0 0 215 103
  mask out - mask torso
  alpha set 0 in out
  grow 4 LINE
  alpha cut 128
end

