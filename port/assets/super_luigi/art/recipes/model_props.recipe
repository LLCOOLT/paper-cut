image art/models/c_sl_set_volcano/1.png   # a flame
  canvas 128 192
  piece f model c_bubble 17
  @f scale 124 188 texel
  paste f 2 2
  alpha cut 128
end

image art/models/c_sl_set_volcano/2.png   # a flame
  canvas 128 192
  piece f model c_bubble 19
  @f scale 124 188 texel
  paste f 2 2
  alpha cut 128
end

