  alpha cut 128
end

image art/models/c_sl_fiery_hat/2.png   # the hat: red, its band gold
  canvas 96 128
  piece h model c_papab 4
  @h map where h=340..20 s>0.5 : #e03030 -> #d8ac38
  @h ramp where s<0.25 l>26 base #38383e to red
  @h scale 96 80 texel
  paste h 0 44
  alpha cut 128
end

image art/models/c_sl_chandelier/4.png   # the arms, flames and drops
  canvas 320 224
  piece t tpl m/pik_02/t 12
  @t scale 256 128 texel
  paste t 32 16
  piece c0 model c_bubble 17
  @c0 scale 24 32 texel
  paste c0 48 0
  piece c1 model c_bubble 17
  @c1 scale 24 32 texel
  paste c1 96 0
  piece c2 model c_bubble 17
  @c2 scale 24 32 texel
  paste c2 148 0
  piece c3 model c_bubble 17
  @c3 scale 24 32 texel
  paste c3 200 0
  piece c4 model c_bubble 17
  @c4 scale 24 32 texel
  paste c4 248 0
  piece d0 tpl e/us/effect.tpl 31
  @d0 scale 24 24 texel
  paste d0 44 144
  piece d1 tpl e/us/effect.tpl 31
  @d1 scale 24 24 texel
  paste d1 92 152
  piece d2 tpl e/us/effect.tpl 31
  @d2 scale 24 24 texel
  paste d2 148 156
  piece d3 tpl e/us/effect.tpl 31
  @d3 scale 24 24 texel
  paste d3 204 152
  piece d4 tpl e/us/effect.tpl 31
  @d4 scale 24 24 texel
  paste d4 252 144
  piece d5 tpl e/us/effect.tpl 31
  @d5 scale 24 24 texel
  paste d5 120 180
  piece d6 tpl e/us/effect.tpl 31
  @d6 scale 24 24 texel
  paste d6 176 180
  alpha cut 128
end

