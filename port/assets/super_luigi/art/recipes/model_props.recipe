# The props (ART_PLAN rows 14, 19, 22 to 25, 27, 33, 34, 36 to 39, 41, 43 to 48): each a real card recoloured, or real
# cards cut and joined. The drawn cards stay in the models as the fallbacks. Numbers: sl_models.py cards MODEL.

gradient red 0.0 #200808 0.35 #3a0c0c 0.6 #801414 1.0 #c02020 2.2 #e05a50 4.5 #f0a8a0
gradient pale 0.0 #2a80d0 0.5 #5aa4dc 1.0 #9ac8e8 1.5 #d8ecf8
gradient goo 0.0 #16300a 0.7 #2a5a10 1.0 #3a7a1a 1.25 #5aa02a 1.5 #7ac040
gradient stone 0.0 #2a2620 0.45 #6a6458 0.7 #9c9688 1.0 #c8c2b4 1.3 #e4dfd2

image art/models/c_sl_dazzlina_tiara/0.png   # Dazzlina's tiara
  load model c_peach 87
  hsv where s>=0.5 h=280..360 : hue =330
  hsv where h=180..260 s>=0.3 : hue =160
  scale 48 32 texel
  alpha cut 128
end

image art/models/c_sl_crown/0.png   # the crown
  load model c_peach 87
  hsv where h=180..260 s>=0.3 : hue =140
  scale 64 48 texel
  alpha cut 128
end

image art/models/c_luigi_crown/39.png   # on Luigi
  canvas 64 64
  piece c model c_peach 87
  @c hsv where h=180..260 s>=0.3 : hue =140
  @c scale 64 48 texel
  paste c 0 8
  alpha cut 128
end

image art/models/c_sl_petunia/22.png   # her petals (swap of c_pansy's 8)
  load model c_pansy 8
  hsv where h=270..330 s>=0.05 : hue =335 sat *1.1
  alpha cut 128
end

image art/models/c_sl_mic/0.png   # the reporter's microphone
  canvas 32 64
  piece m model c_report 4
  @m scale 32 56 texel
  paste m 0 4
  alpha cut 128
end

image art/models/c_sl_baron_hat/0.png   # the Baron
  canvas 40 40
  piece h model c_papab 4
  @h scale 40 32 texel
  paste h 0 4
  alpha cut 128
end

image art/models/c_sl_leaf/0.png   # a paper leaf
  canvas 40 64
  piece s model MOBJ_Signboard 0
  @s crop 108 170 32 86
  @s scale 8 28 texel
  paste s 16 36
  piece l model c_flower 23
  @l crop 0 -12 72 72
  @l rotate 90
  @l scale 40 40 texel
  paste l 0 2
  alpha cut 128
end

image art/models/c_sl_leaf/1.png   # paper grass
  canvas 40 64
  piece s model MOBJ_Signboard 0
  @s crop 108 170 32 86
  @s scale 8 28 texel
  paste s 16 36
  piece l tpl m/jin_05/t 6
  @l crop 32 0 32 24
  @l scale 40 36 texel
  paste l 0 4
  alpha cut 128
end

image art/models/c_sl_look_edge_25/0.png   # its strip
  load tpl e/us/effect.tpl 92
  scale 16 16 texel
  rotate 90
  scale 128 16 texel
  alpha set 255 where l>=190
  alpha set 170 where l<190
  alpha set 110 where l<130
  alpha set 56 where l<80
  alpha set 0 where l<28
  fill where a>0 #c8dcff
end

image art/models/c_sl_look_edge_25/1.png   # dimmed
  load tpl e/us/effect.tpl 92
  scale 16 16 texel
  rotate 90
  hsv val *0.75
  scale 128 16 texel
  alpha set 255 where l>=190
  alpha set 170 where l<190
  alpha set 110 where l<130
  alpha set 56 where l<80
  alpha set 0 where l<28
  fill where a>0 #c8dcff
end

