image art/models/c_sl_socket_moon/0.png   # the socket: the white stone cut to a stand
  canvas 88 112
  piece s tpl m/hei_10/t 0
  @s crop 0 0 88 112
  @s ramp base #a8a8a0 to stone
  paste s 0 0
  mask ped poly 6,6 82,6 82,40 62,44 58,88 78,100 84,108 4,108 10,100 30,88 26,44 6,40
  mask no rect 0 0 87 111
  mask no - mask ped
  alpha set 0 in no
  mask nich poly 44,10 54,14 58,24 54,34 44,38 34,34 30,24 34,14
  stamp nich #6a6458
  mask sh poly 44,10 54,14 58,24 44,20 30,24 34,14
  stamp sh #4a4438
  grow 2 #3a342a
  alpha cut 128
end

