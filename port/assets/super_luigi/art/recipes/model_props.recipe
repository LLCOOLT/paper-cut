# c_sl_gear_gate at four times the game's texels (cutout.py's DENSITY, wave 3): every size, place and mask below is the
# 8-texel cut's times 4, the disc's textures taken up by `scale ... smooth` so the outlines stay smooth in game
image art/models/c_sl_gear_gate/1.png   # the white brick frame
  canvas 576 640
  piece w tpl m/hei_10/t 0
  @w crop 0 0 128 128
  @w ramp base #a8a8a0 to stone
  @w scale 544 608 smooth
  paste w 16 16
  mask hole rect 128 176 447 639
  alpha set 0 in hole
  grow 12 #4a4438
  alpha cut 128
end

image art/models/c_sl_gear_gate/0.png   # the teeth: tik_05's spikes in stone
  canvas 384 544
  piece t tpl m/tik_05/t 1
  @t hsv sat *0.2 val *0.75
  @t scale 384 544 smooth
  paste t 0 0
  alpha cut 128
end

image art/models/c_sl_gear_gate/3.png   # the gear clean, after the Tune-up (gear[1], S_2 and the pushes)
  canvas 288 288
  piece o tpl m/pik_02/t 21
  @o scale 288 288 smooth
  paste o 0 0
  mask out poly 144,0 248,40 288,144 248,248 144,288 40,248 0,144 40,40
  mask no rect 0 0 287 287
  mask no - mask out
  alpha set 0 in no
  alpha set 0 in no
  alpha cut 128
end

image art/models/c_sl_gear_gate/2.png   # the gear jammed with grit (gear[0], S_1 and J_1): the same gold gear, dulled, with grit caked on in clumps
  canvas 288 288
  piece o tpl m/pik_02/t 21
  @o scale 288 288 smooth
  paste o 0 0
  mask out poly 144,0 248,40 288,144 248,248 144,288 40,248 0,144 40,40
  mask no rect 0 0 287 287
  mask no - mask out
  alpha set 0 in no
  hsv sat *0.7 val *0.8
  mask smear poly 56,80 120,56 160,88 136,136 72,128
  mask smear + poly 160,160 232,144 248,200 200,240 152,216
  mask smear + poly 32,176 72,160 96,208 56,240
  mask smear + poly 176,32 232,40 240,88 200,96
  hsv in smear hue =32 sat *0.75 val *0.55
  mask grit poly 72,80 112,68 132,96 108,120 76,112
  mask grit + poly 176,168 216,160 228,192 196,220 168,200
  mask grit + poly 44,184 68,176 80,208 52,220
  mask grit + poly 192,48 220,52 224,76 196,80
  mask grit + poly 120,176 140,168 148,188 128,196
  mask grit + poly 152,104 168,100 172,116 156,120
  mask grit + rect 92 224 107 239
  mask grit + rect 232 112 243 127
  mask grit + rect 32 120 43 131
  mask grit + rect 120 32 131 43
  mask nogrit rect 0 0 287 287
  mask nogrit - mask grit
  piece g tpl m/hei_10/t 4
  @g scale 288 288 smooth
  @g hsv hue =30 sat =0.35 val *0.55
  @g alpha set 0 in nogrit
  paste g 0 0
  alpha set 0 in no
  alpha cut 128
end

