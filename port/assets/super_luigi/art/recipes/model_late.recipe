image art/models/c_sl_set_road/0.png   # Petal Meadows' painted sky and hills, its own leafy path
  load tpl b/hei_00.tpl 0
  scale 512 256 texel
  piece r0 tpl m/hei_00/t 3
  @r0 rotate 90
  @r0 scale 180 72 texel
  paste r0 -6 184
  piece r1 tpl m/hei_00/t 3
  @r1 rotate 90
  @r1 scale 180 72 texel
  paste r1 166 184
  piece r2 tpl m/hei_00/t 3
  @r2 rotate 90
  @r2 scale 180 72 texel
  paste r2 338 184
  alpha cut 128
end

# c_sl_set_ballroom/0 (the backdrop) is the style model's painted ballroom, ch4_sets/set_ballroom.png (wave 3)

