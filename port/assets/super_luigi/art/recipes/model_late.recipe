# The murals (row 26: the game's storybook pictures), the Slam's sets (row 21). Cranberry and the Nightmare are cut from the
# style model's pieces (art/tools/cut_cranberry.py, cut_nightmare.py).

gradient sepia 0.0 #2a2010 0.4 #6a5430 0.8 #b4a070 1.0 #d4c498 1.3 #e8e0c0

image art/models/c_sl_mural/0.png   # the white city was happy
  load tpl demo.tpl 8
  crop 0 110 608 304
  scale 256 128 texel
  hsv hue =38 sat *0.95
  piece f0 model c_kamek_w 23
  @f0 hsv hue =38 sat *1.0 val *0.98
  @f0 scale 26 24 texel
  piece g0 model c_luigi 14
  @g0 hsv hue =38 sat *0.6 val *0.95
  @g0 scale 12 16 texel
  paste f0 60 88
  paste g0 67 77
  piece f1 model c_kamek_w 23
  @f1 hsv hue =38 sat *1.0 val *0.98
  @f1 scale 26 24 texel
  piece g1 model c_luigi 14
  @g1 hsv hue =38 sat *0.6 val *0.95
  @g1 scale 12 16 texel
  paste f1 100 88
  paste g1 107 77
  piece f2 model c_kamek_w 23
  @f2 hsv hue =38 sat *1.0 val *0.98
  @f2 scale 26 24 texel
  piece g2 model c_luigi 14
  @g2 hsv hue =38 sat *0.6 val *0.95
  @g2 scale 12 16 texel
  paste f2 150 88
  paste g2 157 77
  piece f3 model c_kamek_w 23
  @f3 hsv hue =38 sat *1.0 val *0.98
  @f3 scale 26 24 texel
  piece g3 model c_luigi 14
  @g3 hsv hue =38 sat *0.6 val *0.95
  @g3 scale 12 16 texel
  paste f3 190 88
  paste g3 197 77
  mask fr rect 0 0 255 2
  mask fr + rect 0 125 255 127
  mask fr + rect 0 0 2 127
  mask fr + rect 253 0 255 127
  stamp fr #3a2e18
end

image art/models/c_sl_mural/1.png   # the compass
  load tpl demo.tpl 10
  crop 0 0 608 304
  scale 256 128 texel
  hsv hue =38 sat *0.95
  piece cp icon ICON_1A2
  @cp hsv hue =38 sat *0.4
  @cp scale 40 40 texel
  paste cp 150 20
  piece f0 model c_kamek_w 23
  @f0 hsv hue =38 sat *1.0 val *0.98
  @f0 scale 26 24 texel
  piece g0 model c_luigi 14
  @g0 hsv hue =38 sat *0.6 val *0.95
  @g0 scale 12 16 texel
  paste f0 110 80
  paste g0 117 69
  mask fr rect 0 0 255 2
  mask fr + rect 0 125 255 127
  mask fr + rect 0 0 2 127
  mask fr + rect 253 0 255 127
  stamp fr #3a2e18
end

