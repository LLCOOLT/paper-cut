image art/models/c_sl_mural/4.png   # everyone went to sleep
  load tpl demo.tpl 9
  crop 0 150 608 304
  scale 256 128 texel
  hsv hue =38 sat *0.95
  hsv val *0.7
  piece cp icon ICON_1A2
  @cp hsv hue =38 sat *0.4
  @cp scale 40 40 texel
  mask cr poly 118,18 122,18 120,34 126,44 118,58 116,58 122,44 116,34
  paste cp 100 12
  stamp cr #2a2010
  piece f0 model c_kamek_w 23
  @f0 hsv hue =38 sat *1.0 val *0.98
  @f0 scale 40 28 texel
  piece g0 model c_luigi 14
  @g0 hsv hue =38 sat *0.6 val *0.95
  @g0 scale 12 16 texel
  @f0 crop 0 6 40 40
  @f0 rotate 90
  paste f0 50 96
  piece f1 model c_kamek_w 23
  @f1 hsv hue =38 sat *1.0 val *0.98
  @f1 scale 40 28 texel
  piece g1 model c_luigi 14
  @g1 hsv hue =38 sat *0.6 val *0.95
  @g1 scale 12 16 texel
  @f1 crop 0 6 40 40
  @f1 rotate 90
  paste f1 120 96
  piece f2 model c_kamek_w 23
  @f2 hsv hue =38 sat *1.0 val *0.98
  @f2 scale 40 28 texel
  piece g2 model c_luigi 14
  @g2 hsv hue =38 sat *0.6 val *0.95
  @g2 scale 12 16 texel
  @f2 crop 0 6 40 40
  @f2 rotate 90
  paste f2 190 96
  mask fr rect 0 0 255 2
  mask fr + rect 0 125 255 127
  mask fr + rect 0 0 2 127
  mask fr + rect 253 0 255 127
  stamp fr #3a2e18
end

