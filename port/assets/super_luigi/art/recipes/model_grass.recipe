# Luigi as the Grass (c_luigi_grass on c_luigi_pc, ART_PLAN row 6): no blade is drawn. Each clump is the game's own
# leaves (the Petal Meadows flower's c_flower 21 to 24, the Piranha's c_pakflwr) turned about their stems and
# overlapped, as a bush would be cut from them. Every leaf keeps its own line. Numbers: sl_models.py cards c_luigi_grass.

# the far clump, behind him
image art/models/c_luigi_grass/39.png
  canvas 184 264
  piece l0 model c_pakflwr 0
  @l0 crop 8 28 92 60
  @l0 scale 110 62 texel
  @l0 crop -4 -28 118 118
  @l0 rotate -152
  paste l0 -10 174
  piece l1 model c_pakflwr 0
  @l1 crop 8 28 92 60
  @l1 scale 110 62 texel
  @l1 crop -4 -28 118 118
  @l1 rotate -28
  paste l1 76 174
  piece l2 model c_flower 23
  @l2 scale 170 62 texel
  @l2 crop -4 -58 178 178
  @l2 rotate -136
  paste l2 -62 114
  piece l3 model c_flower 23
  @l3 scale 170 62 texel
  @l3 crop -4 -58 178 178
  @l3 rotate -44
  paste l3 68 114
  piece l4 model c_flower 24
  @l4 scale 220 66 texel
  @l4 crop -4 -81 228 228
  @l4 rotate -118
  paste l4 -77 54
  piece l5 model c_flower 24
  @l5 scale 220 66 texel
  @l5 crop -4 -81 228 228
  @l5 rotate -60
  paste l5 36 56
  piece l6 model c_flower 21
  @l6 scale 248 66 texel
  @l6 crop -4 -95 256 256
  @l6 rotate -102
  paste l6 -65 19
  piece l7 model c_flower 21
  @l7 scale 248 66 texel
  @l7 crop -4 -95 256 256
  @l7 rotate -76
  paste l7 -3 20
  piece l8 model c_flower 23
  @l8 scale 150 56 texel
  @l8 crop -4 -51 158 158
  @l8 rotate -128
  paste l8 -51 127
  piece l9 model c_flower 23
  @l9 scale 150 56 texel
  @l9 crop -4 -51 158 158
  @l9 rotate -52
  paste l9 75 127
  piece l10 model c_flower 24
  @l10 scale 200 60 texel
  @l10 crop -4 -74 208 208
  @l10 rotate -90
  paste l10 -12 64
  alpha cut 128
end

