image art/future_sight/guard_ring.png
  fallback art/future_sight/drawn/guard_ring.png
  canvas 128 128
  piece a0 tpl e/us/effect.tpl 115
  @a0 alpha set 0 where l<128
  @a0 fill where a>=128 #d8ac38
  @a0 rotate 0
  paste a0 0 0
  piece a1 tpl e/us/effect.tpl 115
  @a1 alpha set 0 where l<128
  @a1 fill where a>=128 #d8ac38
  @a1 rotate 90
  paste a1 64 0
  piece a2 tpl e/us/effect.tpl 115
  @a2 alpha set 0 where l<128
  @a2 fill where a>=128 #d8ac38
  @a2 rotate 180
  paste a2 64 64
  piece a3 tpl e/us/effect.tpl 115
  @a3 alpha set 0 where l<128
  @a3 fill where a>=128 #d8ac38
  @a3 rotate 270
  paste a3 0 64
  grow 1 #5a4000
  alpha cut 128
end

image art/future_sight/guard_ring_closed.png
  fallback art/future_sight/drawn/guard_ring_closed.png
  canvas 128 128
  piece a0 tpl e/us/effect.tpl 115
  @a0 alpha set 0 where l<128
  @a0 fill where a>=128 #d8ac38
  @a0 rotate 0
  paste a0 0 0
  piece a1 tpl e/us/effect.tpl 115
  @a1 alpha set 0 where l<128
  @a1 fill where a>=128 #d8ac38
  @a1 rotate 90
  paste a1 64 0
  piece a2 tpl e/us/effect.tpl 115
  @a2 alpha set 0 where l<128
  @a2 fill where a>=128 #d8ac38
  @a2 rotate 180
  paste a2 64 64
  piece a3 tpl e/us/effect.tpl 115
  @a3 alpha set 0 where l<128
  @a3 fill where a>=128 #d8ac38
  @a3 rotate 270
  paste a3 0 64
  grow 2 #f0d478
  alpha cut 128
end


# ---- row 20: the sergeant's stripe: three chevrons, 2 golds, on the game's navy (a repaint by the rules: nothing close exists)
image art/models/c_sl_bulkhead/18.png
  canvas 48 56
  mask sh poly 4,4 44,4 44,36 24,52 4,36
  stamp sh #2a3a6a
  mask ch1 poly 10,14 24,6 38,14 38,20 24,12 10,20
  mask ch2 poly 10,24 24,16 38,24 38,30 24,22 10,30
  mask ch3 poly 10,34 24,26 38,34 38,40 24,32 10,40
  stamp ch1 #e8b028
  stamp ch2 #e8b028
  stamp ch3 #c08818
  grow 2 #3a2a10
  alpha cut 128
end

# ---- row 40: the trophy, 3 golds from the coin, one hard sheen; its piece the coin
image art/models/c_sl_trophy/0.png
  canvas 80 128
  mask cup poly 18,6 62,6 58,44 48,62 44,86 56,108 24,108 36,86 32,62 22,44
  stamp cup #d8ac38
  mask sh poly 42,6 62,6 58,44 48,62 44,86 56,108 44,108 40,86 42,62 50,40
  stamp sh #a87c20
  mask gl poly 24,10 30,10 32,38 28,38
  stamp gl #f8e8a0
  piece hl model MOBJ_Signboard 0
  grow 3 #5a4000
  alpha cut 128
end

image art/models/c_sl_trophy/1.png
  load icon ICON_1B4
  scale 32 32 texel
  alpha cut 128
end

# ---- row 42: the shutter, slats of the white boards, the hazard stripe in 2 flat tones
image art/models/c_sl_shutter/0.png
  load tpl m/muj_10/t 23
  rotate 90
  scale 288 224 texel
  crop 0 0 288 256
  mask hz rect 0 224 287 255
  stamp hz #d8b020
  mask st poly 0,224 24,224 56,255 32,255
  mask st + poly 64,224 88,224 120,255 96,255
  mask st + poly 128,224 152,224 184,255 160,255
  mask st + poly 192,224 216,224 248,255 224,255
  mask st + poly 256,224 280,224 287,232 287,255 288,255
  stamp st #2a2a30
  alpha cut 128
end

# ---- row 47: Mossbeard's button, the coin in red with four holes
image art/icons/button.png
  fallback art/icons/drawn/button.png
  load icon ICON_1B4
  hsv where h=30..70 : hue =0 sat *0.9
  mask holes rect 12 12 16 16
  mask holes + rect 24 12 28 16
  mask holes + rect 12 24 16 28
  mask holes + rect 24 24 28 28
  stamp holes #3a0c0c
  alpha cut 128
end

