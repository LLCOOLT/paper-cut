image art/future_sight/vision_bubble.png
  fallback art/future_sight/drawn/vision_bubble.png
  load tpl battle/win/menuwin.tpl 1
  hsv hue =42 sat =0.16 val =0.97
  scale 184 104 texel
  crop -4 -4 192 112
  grow 2 #6a5434
  alpha cut 128
end

image art/future_sight/vision_puff_big.png
  fallback art/future_sight/drawn/vision_puff_big.png
  load tpl e/us/effect.tpl 11
  scale 24 24 texel
  alpha cut 128
end

image art/future_sight/vision_puff_small.png
  fallback art/future_sight/drawn/vision_puff_small.png
  load tpl e/us/effect.tpl 11
  scale 16 16 texel
  alpha cut 128
