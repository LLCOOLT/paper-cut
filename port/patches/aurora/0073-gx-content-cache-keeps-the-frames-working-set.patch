+  uint64_t workingSetFrames = 0;
 };
 
 inline constexpr LruCacheLimits RenderTextureCacheLimits{
@@ -109,7 +114,11 @@ public:
   }
 
   void end_frame() {
-    if (!m_limits.idleFrames || ++m_frame % m_limits.sweepFrames != 0) {
+    ++m_frame; // (every frame, a budget-only cache's too: the working set's age)
+    if (m_limits.workingSetFrames != 0 && cached_bytes() > m_limits.bytes) {
+      trim(); // what aged out of the working set while over the budget
+    }
+    if (!m_limits.idleFrames || m_frame % m_limits.sweepFrames != 0) {
       return;
     }
     for (auto it = m_lru.end(); it != m_lru.begin();) {
@@ -134,7 +143,7 @@ public:
 
   void set_budget(uint64_t bytes) {
     m_limits.bytes = bytes;
-    trim();
+    trim(true);
   }
 
   bool contains(const Key& key) const { return m_entries.contains(key); }
@@ -176,9 +185,15 @@ private:
     m_lru.erase(entry);
   }
 
-  void trim() {
+  // the least recently used out until the budget is met; the working set stays (the LRU's front: once the walk
+  // from its back meets an entry of it, all before it are too) unless the budget itself was set
+  void trim(bool budgetSet = false) {
     for (auto it = m_lru.end(); it != m_lru.begin() && cached_bytes() > m_limits.bytes;) {
       auto entry = std::prev(it);
+      if (!budgetSet && m_limits.workingSetFrames != 0 &&
+          m_frame - entry->lastUsedFrame < m_limits.workingSetFrames) {
+        break;
+      }
       if (entry->pinned) {
         it = entry;
       } else {
