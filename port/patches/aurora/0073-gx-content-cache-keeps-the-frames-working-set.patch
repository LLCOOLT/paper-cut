diff --git a/lib/gx/texture.hpp b/lib/gx/texture.hpp
index 7f2fd35..65b369e 100644
--- a/lib/gx/texture.hpp
+++ b/lib/gx/texture.hpp
@@ -33,6 +33,9 @@ const TextureStats& texture_stats() noexcept;
 
 namespace texture {
 constexpr uint64_t ContentCacheBudgetBytes = 128ull * 1024ull * 1024ull;
+// textures drawn in this frame or the last stay past the budget: a frame that draws more than it (upscaled 4x, a
+// room full of sprites) would otherwise evict most of them and upload them again, every frame
+constexpr uint64_t ContentCacheWorkingSetFrames = 2;
 constexpr uint64_t ObjectCacheIdleFrames = 600;
 #if defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
 constexpr bool AsyncTextureReplacements = false; // one thread (the browser): loaded where they are asked for
diff --git a/tests/gx_texture_cache_test.cpp b/tests/gx_texture_cache_test.cpp
index 9949fb2..0ad3729 100644
--- a/tests/gx_texture_cache_test.cpp
+++ b/tests/gx_texture_cache_test.cpp
@@ -547,12 +547,41 @@ TEST_F(GxTextureCacheTest, ContentCacheEvictsLeastRecentlyUsedEntry) {
   c[0] = 2;
   texture::resolve_static_texture(make_texture(a.data(), 1, GX_TF_RGBA8_PC, 4, 4));
   texture::resolve_static_texture(make_texture(b.data(), 2, GX_TF_RGBA8_PC, 4, 4));
+  for (uint64_t i = 0; i < texture::ContentCacheWorkingSetFrames; ++i) {
+    texture::end_frame(); // (a and b out of the working set)
+  }
   texture::resolve_static_texture(make_texture(a.data(), 3, GX_TF_RGBA8_PC, 4, 4));
   texture::resolve_static_texture(make_texture(c.data(), 4, GX_TF_RGBA8_PC, 4, 4));
+  EXPECT_EQ(texture_stats().evictions, 1); // b, the least recently used
   texture::resolve_static_texture(make_texture(b.data(), 5, GX_TF_RGBA8_PC, 4, 4));
 
+  // a and c are this frame's: kept past the budget, not evicted to make b again
+  EXPECT_EQ(testing::texture_allocations(), 4);
+  EXPECT_EQ(texture_stats().evictions, 1);
+  EXPECT_EQ(texture_stats().contentCacheBytes, 192);
+  EXPECT_EQ(texture_stats().contentCacheEntries, 3);
+}
+
+TEST_F(GxTextureCacheTest, ContentCacheKeepsAFramesWorkingSetPastItsBudget) {
+  texture::set_content_cache_budget_for_testing(128);
+  std::array<std::array<uint8_t, 64>, 4> pixels{};
+  for (uint8_t i = 0; i < pixels.size(); ++i) {
+    pixels[i][0] = i;
+  }
+  // four textures a frame over a budget of two, frame after frame: made once each
+  for (int frame = 0; frame < 8; ++frame) {
+    for (uint32_t i = 0; i < pixels.size(); ++i) {
+      texture::resolve_static_texture(make_texture(pixels[i].data(), 1 + frame * 4 + i, GX_TF_RGBA8_PC, 4, 4));
+    }
+    texture::end_frame();
+  }
   EXPECT_EQ(testing::texture_allocations(), 4);
-  EXPECT_EQ(texture_stats().evictions, 2);
+  EXPECT_EQ(texture_stats().contentCacheEntries, 4);
+
+  // left alone, they are trimmed back to the budget
+  for (uint64_t i = 0; i < texture::ContentCacheWorkingSetFrames; ++i) {
+    texture::end_frame();
+  }
   EXPECT_EQ(texture_stats().contentCacheBytes, 128);
   EXPECT_EQ(texture_stats().contentCacheEntries, 2);
 }
diff --git a/tests/lru_cache_test.cpp b/tests/lru_cache_test.cpp
index 13052f0..be8b787 100644
--- a/tests/lru_cache_test.cpp
+++ b/tests/lru_cache_test.cpp
@@ -25,6 +25,33 @@ TEST(LruCacheTest, BudgetOnlyCacheRetainsIdleEntriesAndStillUsesLruOrder) {
   EXPECT_EQ(cache.cached_bytes(), 64);
 }
 
+TEST(LruCacheTest, WorkingSetStaysPastTheBudgetUntilLeftAlone) {
+  LruCache<int, int> cache{{.bytes = 64, .workingSetFrames = 2}};
+  // a frame that uses more than the budget: nothing it uses is evicted to make the next
+  for (int frame = 0; frame < 4; ++frame) {
+    for (int key = 1; key <= 3; ++key) {
+      if (cache.find(key) == nullptr) {
+        ASSERT_EQ(frame, 0);
+        cache.insert(key, key * 10, 32);
+      }
+    }
+    cache.end_frame();
+  }
+  EXPECT_EQ(cache.cached_count(), 3);
+  EXPECT_EQ(cache.cached_bytes(), 96);
+
+  // used again only in part: the rest ages out and the cache is back within its budget
+  ASSERT_NE(cache.find(3), nullptr);
+  cache.end_frame();
+  cache.end_frame();
+  EXPECT_TRUE(cache.contains(3));
+  EXPECT_EQ(cache.cached_bytes(), 64);
+
+  // a set budget is met at once, working set or not
+  cache.set_budget(0);
+  EXPECT_EQ(cache.cached_count(), 0);
+}
+
 TEST(LruCacheTest, ZeroIdleLimitExpiresAtNextSweep) {
   LruCache<int, int> cache{{.bytes = 64, .idleFrames = 0, .sweepFrames = 4}};
   cache.insert(1, 10, 32);
