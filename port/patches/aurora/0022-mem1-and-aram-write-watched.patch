From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 13:00:00 +0000
Subject: [PATCH] os, ar: MEM1 and ARAM write-watched on Windows, for rewind

---
diff --git a/lib/dolphin/AR.cpp b/lib/dolphin/AR.cpp
index ab9306b..06514b1 100644
--- a/lib/dolphin/AR.cpp
+++ b/lib/dolphin/AR.cpp
@@ -1,3 +1,8 @@
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <Windows.h>
+#endif
 #include <dolphin/arq.h>
 #include "../internal.hpp"
 #include "dolphin/os.h"
@@ -62,6 +67,12 @@ u32 ARInit(u32* stack_index_addr, u32 num_entries) {
     return ARAM_STACK_START;
   }
 
+#ifdef _WIN32
+  // Write-watched, as MEM1 (OSMemory.cpp): the pages written since last asked (GetWriteWatch)
+  sAramBuffer = (u8*)VirtualAlloc(nullptr, aurora::g_config.mem2Size, MEM_RESERVE | MEM_COMMIT | MEM_WRITE_WATCH,
+                                  PAGE_READWRITE);
+  if (!sAramBuffer)
+#endif
   sAramBuffer = (u8*)calloc(1, aurora::g_config.mem2Size);
   if (sAramBuffer) {
     Log.debug("Initialized 0x{:X} bytes of ARAM!", aurora::g_config.mem2Size);
diff --git a/lib/dolphin/os/OSMemory.cpp b/lib/dolphin/os/OSMemory.cpp
index 2a963a5..7f0e90e 100644
--- a/lib/dolphin/os/OSMemory.cpp
+++ b/lib/dolphin/os/OSMemory.cpp
@@ -138,6 +138,14 @@ static void* AllocMEM1(u32 size) {
 }
 #else
 static void* AllocMEM1(u32 size) {
+#if _WIN32
+  // Write-watched (zeroed, as calloc's): the application can ask which pages were written since it last looked
+  // (GetWriteWatch) instead of comparing all of MEM1 with a copy.
+  void* p = VirtualAlloc(nullptr, size, MEM_RESERVE | MEM_COMMIT | MEM_WRITE_WATCH, PAGE_READWRITE);
+  if (p != nullptr) {
+    return p;
+  }
+#endif
   return calloc(1, size);
 }
 #endif
