index c30a605..1858e8d 100644
--- a/lib/aurora.cpp
+++ b/lib/aurora.cpp
@@ -32,8 +32,10 @@
 #include <SDL3/SDL_init.h>
 #include <SDL3/SDL_messagebox.h>
 #include <fmt/format.h>
+#include <algorithm>
 #include <cstdio>
