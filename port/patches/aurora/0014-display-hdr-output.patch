+void set_metal_layer_hdr(SDL_Window* window, bool enabled) {
+  // on: set after every configure (whatever Dawn did to the layer); off: only put back a layer that was changed
+  static bool s_edr = false;
+  if (window == nullptr || (!enabled && !s_edr)) {
+    return;
+  }
+  const auto view =
+      static_cast<SDL_MetalView>(SDL_GetPointerProperty(SDL_GetWindowProperties(window), MetalViewProperty, nullptr));
+  if (view == nullptr) {
+    return;
+  }
+  CAMetalLayer* layer = (__bridge CAMetalLayer*)SDL_Metal_GetLayer(view);
+  if (layer == nil) {
+    return;
+  }
+  if (@available(macOS 10.12, iOS 16.0, tvOS 16.0, *)) {
+    layer.wantsExtendedDynamicRangeContent = enabled ? YES : NO;
+    if (enabled) {
+      CGColorSpaceRef colorSpace = CGColorSpaceCreateWithName(kCGColorSpaceExtendedLinearSRGB);
+      layer.colorspace = colorSpace;
+      CGColorSpaceRelease(colorSpace);
+    } else {
+      layer.colorspace = nullptr;
+    }
+    s_edr = enabled;
+  }
+}
 } // namespace aurora::webgpu::utils
