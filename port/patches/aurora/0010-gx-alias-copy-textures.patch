From: Claude <noreply@anthropic.com>
Subject: [PATCH] gx: GXAliasCopyTex, a copy texture standing for another address

On the hardware an EFB copy writes its pixels to memory, and games copy
that memory into buffers of their own to keep a capture (TTYD's paper
effects). Aurora keeps copies on the GPU, so the copied memory was
empty and the capture black. GXAliasCopyTex(src, dest) (FIFO command
GX_AURORA_ALIAS_COPY_TEX) makes the copy texture at src also stand for
dest.
---
--- a/include/dolphin/gx/GXAurora.h
+++ b/include/dolphin/gx/GXAurora.h
@@ -81,6 +81,13 @@
 
 #define GX_AURORA_LOAD_COPY_DEST 0x0037
 
+/**
+ * The EFB copy at one address also stands for another (GXAliasCopyTex): a game that copies a copy's memory to a
+ * buffer of its own (on the hardware, the pixels) samples the same texture from there. Followed by the u64 source and
+ * u64 destination addresses.
+ */
+#define GX_AURORA_ALIAS_COPY_TEX 0x0038
+
 #define GX_AURORA_BEGIN_OFFSCREEN 0x0039
 
 #define GX_AURORA_END_OFFSCREEN 0x003A
--- a/include/dolphin/gx/GXExtra.h
+++ b/include/dolphin/gx/GXExtra.h
@@ -19,6 +19,8 @@
 void GXDestroyTexObj(GXTexObj* obj);
 void GXDestroyTlutObj(GXTlutObj* obj);
 void GXDestroyCopyTex(void* dest);
+/* The copy texture at src also stands for dest (the game copied src's memory there). */
+void GXAliasCopyTex(const void* src, const void* dest);
 
 void GXColor4f32(float r, float g, float b, float a);
 
--- a/lib/dolphin/gx/GXExtra.cpp
+++ b/lib/dolphin/gx/GXExtra.cpp
@@ -21,6 +21,14 @@
   obj->tlutObjId = 0;
 }
 
+void GXAliasCopyTex(const void* src, const void* dest) {
+  if (src != nullptr && dest != nullptr && src != dest) {
+    GX_WRITE_AURORA(GX_AURORA_ALIAS_COPY_TEX);
+    GX_WRITE_U64(reinterpret_cast<u64>(src));
+    GX_WRITE_U64(reinterpret_cast<u64>(dest));
+  }
+}
+
 void GXDestroyCopyTex(void* dest) {
   if (dest != nullptr) {
     GX_WRITE_AURORA(GX_AURORA_DESTROY_COPY_TEX);
--- a/lib/gx/command_processor.cpp
+++ b/lib/gx/command_processor.cpp
@@ -856,6 +856,10 @@
     evict_tlut_object(reader.read<u32>());
   } else if (subCmd == GX_AURORA_DESTROY_COPY_TEX) {
     evict_copy_texture(reinterpret_cast<const void*>(reader.read<u64>()));
+  } else if (subCmd == GX_AURORA_ALIAS_COPY_TEX) {
+    const auto* src = reinterpret_cast<const void*>(reader.read<u64>());
+    const auto* dest = reinterpret_cast<const void*>(reader.read<u64>());
+    alias_copy_texture(src, dest);
   } else if (subCmd == GX_AURORA_DRAW_SIZED) {
     const u8 cmd = reader.read<u8>();
     const u32 byteLen = reader.read<u32>();
--- a/lib/gx/gx.hpp
+++ b/lib/gx/gx.hpp
@@ -438,6 +438,8 @@
 struct ShaderInfo;
 
 void initialize() noexcept;
+// GXAliasCopyTex (texture.cpp)
+void alias_copy_texture(const void* src, const void* dest) noexcept;
 void shutdown() noexcept;
 void update() noexcept;
 void set_viewport_policy(AuroraViewportPolicy policy) noexcept;
--- a/lib/gx/texture.cpp
+++ b/lib/gx/texture.cpp
@@ -121,6 +121,8 @@
     [](const gfx::TextureHandle&) { ++s_stats.evictions; },
 };
 void retire_copy_texture(const GXState::CopyTextureRef& copy);
+// GXAliasCopyTex destinations whose source was not copied yet (dest -> src)
+absl::flat_hash_map<const void*, const void*> s_copyAliases;
 gfx::LruCache<GXState::CopyTextureKey, GXState::CopyTextureRef> s_copyCache{
     gfx::RenderTextureCacheLimits,
     retire_copy_texture,
@@ -810,15 +812,29 @@
 
 void clear_copy_texture_cache() noexcept {
   g_gxState.copyTextures.clear();
+  s_copyAliases.clear();
   s_copyCache.clear();
   update_cache_stats();
   texture::invalidate_bindings();
 }
 
 void clear_static_texture_cache() noexcept { s_pendingCacheClears.fetch_add(1, std::memory_order_release); }
+
+void alias_copy_texture(const void* src, const void* dest) noexcept {
+  const auto it = g_gxState.copyTextures.find(src);
+  if (it == g_gxState.copyTextures.end() || !it->second) {
+    s_copyAliases[dest] = src; // the copy is still to come: resolved when dest is sampled
+    return;
+  }
+  // the reference holds the texture (shared); the cache's pin stays the source's
+  g_gxState.copyTextures[dest] = it->second;
+  s_copyAliases.erase(dest);
+  texture::invalidate_bindings();
+}
 
 void evict_copy_texture(const void* dest) noexcept {
   g_gxState.copyTextures.erase(dest);
+  s_copyAliases.erase(dest);
   s_copyCache.erase_if([&](const auto& key) { return key.dest == dest; });
   update_cache_stats();
   texture::invalidate_bindings();
@@ -842,7 +858,17 @@
