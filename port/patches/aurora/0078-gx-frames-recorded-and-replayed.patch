+
+// Frame recording and replay (GXAurora.h)
+struct AuroraRec {
+  std::vector<u8> stream;
+  // the arrays the draws read; an array the frame before read unchanged is shared with it (map geometry)
+  std::vector<std::shared_ptr<const std::vector<u8>>> arrays;
+  std::vector<const u8*> arrayPtrs;
+  u64 arrayBytes = 0;
+  u64 arrayBytesNew = 0;
+  std::vector<AuroraRecEvent> events;
+  std::vector<u32> texObjs; // evictions held until the replays are done
+  std::vector<u32> tluts;
+  aurora::gx::GXState start;
+  aurora::gx::CopyAliases startAliases;
+  const char* unreplayable = nullptr;
+};
+
+namespace aurora::gx::fifo {
+namespace {
+// arrays kept by (address, size): the last recording's, and the one being made's
+struct ArrayKey {
+  const void* data;
+  u32 size;
+  bool operator==(const ArrayKey& o) const { return data == o.data && size == o.size; }
+  template <typename H>
+  friend H AbslHashValue(H h, const ArrayKey& k) {
+    return H::combine(std::move(h), k.data, k.size);
+  }
+};
+using ArrayMap = absl::flat_hash_map<ArrayKey, std::shared_ptr<const std::vector<u8>>>;
+ArrayMap sLastArrays, sNewArrays;
+} // namespace
+
+static u32 rec_keep_array(const u8* data, u32 size) noexcept {
+  AuroraRec& rec = *sRec.rec;
+  std::shared_ptr<const std::vector<u8>> blob;
+  const ArrayKey key{data, size};
+  for (const ArrayMap* map : {&sNewArrays, &sLastArrays}) {
+    if (const auto it = map->find(key); it != map->end() && std::memcmp(it->second->data(), data, size) == 0) {
+      blob = it->second;
+      break;
+    }
+  }
+  if (!blob) {
+    blob = std::make_shared<const std::vector<u8>>(data, data + size);
+    rec.arrayBytesNew += size;
+  }
+  sNewArrays[key] = blob;
+  rec.arrayBytes += size;
+  rec.arrays.push_back(blob);
+  rec.arrayPtrs.push_back(blob->data());
+  return static_cast<u32>(rec.arrays.size() - 1);
+}
+
+namespace {
+AuroraRec* sRecording = nullptr; // (game thread) the live frame being recorded
+bool sMainPaused = false;         // (game thread) GX_AURORA_REC_PAUSE as last written
+// what a replay found and puts back: the state outside it
+GXState sOutside;
+CopyAliases sOutsideAliases;
+BoundingBox sOutsideBbox;
+bool sInReplay = false;
+
+void apply_deferred(AuroraRec& rec) noexcept {
+  for (const u32 id : rec.texObjs) {
+    evict_texture_object(id);
+  }
+  for (const u32 id : rec.tluts) {
+    evict_tlut_object(id);
+  }
+  rec.texObjs.clear();
+  rec.tluts.clear();
+}
+} // namespace
+
+// a gfx call that draws outside the FIFO (push_custom_draw and such: recording.cpp) while a frame is recorded and
+// not paused: a replay of the stream wouldn't have it
+void rec_direct_call(const char* what) noexcept {
+  if (sRecording != nullptr && !sMainPaused && sRecording->unreplayable == nullptr) {
+    sRecording->unreplayable = what;
+  }
+}
+} // namespace aurora::gx::fifo
+
+using namespace aurora::gx;
+
+extern "C" {
+AuroraRec* AuroraRecordBegin(void) {
+  if (fifo::sRecording != nullptr || fifo::sInReplay || fifo::in_display_list()) {
+    return nullptr;
+  }
+  fifo::drain();
+  auto* rec = new AuroraRec;
+  // the first draw merges into none before it and reads every array again: as in a replay, which begins afresh
+  fifo::clear_draw_cache();
+  for (auto& array : g_gxState.arrays) {
+    array.cachedRange = {};
+  }
+  g_gxState.dirty |= DirtyImmediates;
+  rec->start = g_gxState;
+  rec->startAliases = copy_aliases();
+  fifo::sRec = {};
+  fifo::sRec.logging = true;
+  fifo::sRec.startAbs = fifo::stream_position();
+  fifo::sRec.events = &rec->events;
+  fifo::sRec.rec = rec;
+  fifo::sLastArrays = std::move(fifo::sNewArrays); // (the last frame's arrays: shared when unchanged)
+  fifo::sNewArrays.clear();
+  fifo::sRec.deferredTexObjs = &rec->texObjs;
+  fifo::sRec.deferredTluts = &rec->tluts;
+  fifo::rec_capture_start(&rec->stream);
+  fifo::sRecording = rec;
+  fifo::sMainPaused = false;
+  return rec;
+}
+
+void AuroraRecordEnd(AuroraRec* rec) {
+  if (rec == nullptr || rec != fifo::sRecording) {
+    return;
+  }
+  fifo::drain();
+  fifo::rec_capture_stop();
+  if (fifo::sRec.sawMove && rec->unreplayable == nullptr) {
+    rec->unreplayable = "memory moved under the frame's draws (AuroraMoveMemory)";
+  }
+  if (fifo::sRec.paused && rec->unreplayable == nullptr) {
+    rec->unreplayable = "a pause not ended";
+  }
+  fifo::sRec = {};
+  fifo::sRecording = nullptr;
+  fifo::sMainPaused = false;
+}
+
+void AuroraRecordView(const AuroraRec* rec, AuroraRecView* out) {
+  *out = {};
+  if (rec == nullptr) {
+    return;
+  }
+  out->stream = rec->stream.data();
+  out->streamSize = static_cast<u32>(rec->stream.size());
+  out->arrays = rec->arrayPtrs.data();
+  out->arrayCount = static_cast<u32>(rec->arrayPtrs.size());
+  out->arrayBytes = static_cast<u32>(std::min<u64>(rec->arrayBytes, UINT32_MAX));
+  out->arrayBytesNew = static_cast<u32>(std::min<u64>(rec->arrayBytesNew, UINT32_MAX));
+  out->events = rec->events.data();
+  out->eventCount = static_cast<u32>(rec->events.size());
+  out->unreplayable = rec->unreplayable;
+}
+
+void AuroraRecordFree(AuroraRec* rec) {
+  if (rec == nullptr) {
+    return;
+  }
+  if (rec == fifo::sRecording) {
+    AuroraRecordEnd(rec);
+  }
+  fifo::drain();
+  fifo::apply_deferred(*rec);
+  if (!fifo::sInReplay) {
+    trim_replay_copies(); // (a recording let go each frame: the replays' own copies kept from growing)
+  }
+  delete rec;
+}
+
+void AuroraRecordTag(u32 tag) {
+  if (fifo::sRecording == nullptr || fifo::in_display_list()) {
+    return;
+  }
+  fifo::write_u8(GX_AURORA);
+  fifo::write_u16(GX_AURORA_REC_TAG);
+  fifo::write_u32(tag);
+}
+
+u32 AuroraRecordPause(GXBool paused) {
+  if ((fifo::sRecording == nullptr && !fifo::sInReplay) || fifo::in_display_list()) {
+    return 0;
+  }
+  fifo::write_u8(GX_AURORA);
+  fifo::write_u16(GX_AURORA_REC_PAUSE);
+  fifo::write_u8(paused ? 1 : 0);
+  fifo::sMainPaused = paused != 0;
+  return fifo::sRecording != nullptr ? static_cast<u32>(fifo::stream_position() - fifo::sRec.startAbs) : 0;
+}
+
+void AuroraReplayBegin(const AuroraRec* rec, const void* const* subst, u32 count) {
+  if (rec == nullptr || fifo::sRecording != nullptr || fifo::sInReplay) {
+    return;
+  }
+  fifo::drain();
+  fifo::sOutside = g_gxState;
+  fifo::sOutsideAliases = copy_aliases();
+  fifo::sOutsideBbox = fifo::sBbox;
+  g_gxState = rec->start;
+  set_copy_aliases(rec->startAliases);
+  fifo::clear_draw_cache();
+  g_replayCopies = true;
+  fifo::sRec = {};
+  fifo::sRec.replaying = true;
+  fifo::sRec.subst = subst;
+  fifo::sRec.substCount = subst != nullptr ? count : 0;
+  fifo::sRec.recorded = rec->events.data();
+  fifo::sRec.recordedCount = static_cast<u32>(rec->events.size());
+  fifo::sRec.arrays = rec->arrayPtrs.data();
+  fifo::detail::sReplaying.store(true, std::memory_order_relaxed);
+  fifo::sInReplay = true;
+}
+
+void AuroraReplayWrite(const void* data, u32 size) {
+  if (!fifo::sInReplay || data == nullptr || size == 0) {
+    return;
+  }
+  fifo::write_data(data, size);
+  fifo::publish();
+}
+
+void AuroraReplayEnd(void) {
+  if (!fifo::sInReplay) {
+    return;
+  }
+  fifo::drain();
+  fifo::sRec = {};
+  fifo::detail::sReplaying.store(false, std::memory_order_relaxed);
+  g_replayCopies = false;
+  // the state as it was outside the replay (the live frame's, and what was set after it)
+  g_gxState = fifo::sOutside;
+  set_copy_aliases(fifo::sOutsideAliases);
+  fifo::sBbox = fifo::sOutsideBbox;
+  fifo::clear_draw_cache();
+  fifo::sInReplay = false;
+  fifo::sMainPaused = false;
+}
+
+u64 AuroraProcessorBusyNs(void) { return fifo::detail::sBusyNs.load(std::memory_order_relaxed); }
+
+void AuroraReplayFinish(AuroraRec* rec) {
+  if (rec == nullptr || fifo::sInReplay) {
+    return;
+  }
+  fifo::drain();
+  fifo::apply_deferred(*rec);
+  trim_replay_copies();
+}
+}
