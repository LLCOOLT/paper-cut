 // it to size offscreen captures (paper-form models, shadows) and to cull.
@@ -545,7 +674,30 @@ static void push_gx_draw(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, gfx::Rang
     }
     auto& array = state.arrays[i];
     if (array.cachedRange.size == 0) {
-      array.cachedRange = gfx::push_storage(static_cast<const uint8_t*>(array.data), array.size);
+      const auto* src = static_cast<const uint8_t*>(array.data);
+      if (rec_active())
+        UNLIKELY {
+          if (sRec.logging) {
+            // the array as this draw reads it: a replay reads the copy (the frame may write the array again)
+            AuroraRecEvent ev{.tag = sRec.tag,
+                              .kind = AURORA_REC_ARRAY,
+                              .reg = static_cast<u16>(i),
+                              .offset = rec_keep_array(src, array.size),
+                              .size = array.size,
+                              .vtxSize = array.stride,
+                              .le = static_cast<u8>(array.le ? 1 : 0)};
+            sRec.events->push_back(ev);
+          } else {
+            const u32 k = sRec.counter;
+            const u8* sub = rec_replaced({.kind = AURORA_REC_ARRAY, .reg = static_cast<u16>(i), .size = array.size});
+            if (sub != nullptr) {
+              src = sub;
+            } else if (!sRec.desync && sRec.arrays != nullptr) {
+              src = sRec.arrays[sRec.recorded[k].offset]; // the array as the recorded draw read it
+            }
+          }
+        }
+      array.cachedRange = gfx::push_storage(src, array.size);
     }
     immediates.arrayStart[i - GX_VA_POS] = array.cachedRange.offset;
   }
@@ -661,7 +813,22 @@ static void draw_prim(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, ByteReader&
   const bool canMerge = lastDraw != nullptr && lastDraw->instanceCount == 1;
 
   // Push raw vertex data to buffer. Merged draws must remain contiguous with the previous range.
-  const auto vertexData = reader.take(totalVtxBytes);
+  auto vertexData = reader.take(totalVtxBytes);
+  if (rec_active())
