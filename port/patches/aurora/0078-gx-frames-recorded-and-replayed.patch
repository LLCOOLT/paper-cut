+// Frame recording and replay (GXAurora.h AuroraRecord*). Set by the game thread while the processor is idle.
+struct RecState {
+  bool logging = false;   // a live frame being recorded: its events listed
+  bool replaying = false; // a recording fed again: its events counted, their data maybe replaced
+  bool paused = false;    // GX_AURORA_REC_PAUSE: neither
+  u32 tag = 0;
+  u64 startAbs = 0; // the recording's first byte in the stream
+  std::vector<AuroraRecEvent>* events = nullptr;
+  AuroraRec* rec = nullptr; // (recording) its arrays
+  std::vector<u32>* deferredTexObjs = nullptr; // texture object evictions held until the replays are done
+  std::vector<u32>* deferredTluts = nullptr;
+  const void* const* subst = nullptr;
+  u32 substCount = 0;
+  const AuroraRecEvent* recorded = nullptr; // (replaying) the recording's own events, each checked against
+  u32 recordedCount = 0;
+  const u8* const* arrays = nullptr; // (replaying) the recording's
+  u32 counter = 0;
+  bool desync = false; // (replaying) an event unlike the recording's: nothing more replaced
+  bool sawMove = false;
+};
+RecState sRec;
+
+static bool rec_active() noexcept { return (sRec.logging || sRec.replaying) && !sRec.paused; }
+
+// (replaying) the data replacing the next event, if it is the recording's next (or null)
+static const u8* rec_replaced(const AuroraRecEvent& ev) noexcept {
+  const u32 i = sRec.counter++;
+  if (sRec.desync) {
+    return nullptr;
+  }
+  if (i >= sRec.recordedCount || sRec.recorded[i].kind != ev.kind || sRec.recorded[i].reg != ev.reg ||
+      sRec.recorded[i].size != ev.size) {
+    sRec.desync = true; // (a draw left out of a full frame, say): the rest as recorded
+    Log.warn("replay: event {} is not the recording's; the rest of this replay is drawn as recorded", i);
+    return nullptr;
+  }
+  return i < sRec.substCount ? static_cast<const u8*>(sRec.subst[i]) : nullptr;
+}
+
+// An event whose data is at data (in the chunk being processed): listed while recording; while replaying, the
+// data replacing it (or null)
+static const u8* rec_event(AuroraRecEvent ev, const u8* data) noexcept {
+  if (sRec.logging) {
+    ev.tag = sRec.tag;
+    ev.offset = static_cast<u32>(detail::sProcAbs + static_cast<u64>(data - detail::sProcData) - sRec.startAbs);
+    sRec.events->push_back(ev);
+    return nullptr;
+  }
+  return rec_replaced(ev);
+}
+
+static bool rec_xf_wanted(u16 addr, u32 count) noexcept {
+  // matrices (position, texture: 0x000-0x0FF; normal: 0x400-0x45F; post-transform: 0x500-0x5FF), the channel
+  // colours (0x100A-0x100F) and the projection (0x1020-0x1026)
+  return addr < 0x100 || (addr >= 0x400 && addr < 0x460) || (addr >= 0x500 && addr < 0x600) ||
+         (addr >= 0x100A && addr <= 0x100F) || (addr == 0x1020 && count == 7);
+}
+
+// where a draw's direct position, colour 0 and texture coordinate 0 are in its vertices
+static void rec_draw_layout(AuroraRecEvent& ev, GXVtxFmt fmt) noexcept;
+
+// (recording) an array as a draw reads it, kept: its index in the recording's arrays
+static u32 rec_keep_array(const u8* data, u32 size) noexcept;
+
 ProcessResult process(const u8* data, u32 size) noexcept {
   ZoneScoped;
   ByteReader reader{{data, size}};
@@ -231,7 +298,17 @@ ProcessResult process(const u8* data, u32 size) noexcept {
       continue;
 
     case CP_CMD_LOAD_BP_REG: {
-      const u32 value = reader.read<u32>();
+      const u8* at = reader.data() + reader.offset();
+      u32 value = reader.read<u32>();
+      if (rec_active() && (value >> 24) >= 0xE0 && (value >> 24) <= 0xE7)
+        UNLIKELY {
+          const u8* sub = rec_event({.kind = AURORA_REC_BP, .reg = static_cast<u16>(value >> 24), .size = 4}, at);
+          if (sub != nullptr) {
+            u32 be;
+            std::memcpy(&be, sub, sizeof(be));
+            value = bswap(be);
+          }
+        }
       handle_bp(value);
       if (reg_get(value, 8, 24) == GX_BP_REG_DRAWDONE) {
         return {static_cast<u32>(reader.offset()), true};
@@ -249,7 +326,19 @@ ProcessResult process(const u8* data, u32 size) noexcept {
       const u32 header = reader.read<u32>();
       const u32 count = ((header >> 16) & 0xFFFF) + 1;
       const u16 addr = header & 0xFFFF;
-      handle_xf(addr, reader.take(count * sizeof(u32)));
+      auto data = reader.take(count * sizeof(u32));
+      if (rec_active() && rec_xf_wanted(addr, count))
+        UNLIKELY {
+          const u8* sub = rec_event({.kind = AURORA_REC_XF,
+                                     .reg = addr,
+                                     .size = static_cast<u32>(data.size()),
+                                     .count = static_cast<u16>(count)},
+                                    data.data());
+          if (sub != nullptr) {
+            data = {sub, data.size()};
+          }
+        }
+      handle_xf(addr, data);
       break;
     }
 
@@ -385,6 +474,46 @@ static u32 calc_vtx_size(GXVtxFmt fmt) noexcept {
 }
 
 
+static void rec_draw_layout(AuroraRecEvent& ev, GXVtxFmt fmt) noexcept {
+  ev.posOff = ev.clrOff = ev.texOff = 0xFF;
+  u32 off = 0;
+  const auto& vtxFmt = g_gxState.vtxFmts[fmt];
+  for (int i = GX_VA_PNMTXIDX; i <= GX_VA_TEX7; ++i) {
+    const auto& attrFmt = vtxFmt.attrs[i];
+    const auto attr = static_cast<GXAttr>(i);
+    switch (g_gxState.vtxDesc[i]) {
+    case GX_NONE:
+      break;
+    case GX_DIRECT: {
+      if (off < 0xFF) {
+        if (attr == GX_VA_POS) {
+          ev.posOff = static_cast<u8>(off);
+          ev.posType = static_cast<u8>(attrFmt.type);
+          ev.posCnt = static_cast<u8>(comp_cnt_count(attr, attrFmt.cnt));
+          ev.posFrac = attrFmt.frac;
+        } else if (attr == GX_VA_CLR0) {
+          ev.clrOff = static_cast<u8>(off);
+          ev.clrType = static_cast<u8>(attrFmt.type);
+        } else if (attr == GX_VA_TEX0) {
+          ev.texOff = static_cast<u8>(off);
+          ev.texType = static_cast<u8>(attrFmt.type);
+          ev.texCnt = static_cast<u8>(comp_cnt_count(attr, attrFmt.cnt));
+          ev.texFrac = attrFmt.frac;
+        }
+      }
+      off += comp_type_size(attr, attrFmt.type) * comp_cnt_count(attr, attrFmt.cnt);
+      break;
+    }
+    case GX_INDEX8:
+      off += i == GX_VA_NRM && attrFmt.cnt == GX_NRM_NBT3 ? 3 : 1;
+      break;
+    case GX_INDEX16:
+      off += i == GX_VA_NRM && attrFmt.cnt == GX_NRM_NBT3 ? 6 : 2;
+      break;
+    }
+  }
+}
+
 // Bounding box (GXClearBoundingBox/GXReadBoundingBox). The hardware tracks
