From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LLCOOLT <114613597+LLCOOLT@users.noreply.github.com>
Date: Thu, 12 Nov 2026 11:00:00 -0500
Subject: [PATCH] gx: a frame recorded and replayed

Frame interpolation and stereoscopic 3D drew their extra pictures by running
the application's draw code again, so draw code with side effects (frees,
timers, random numbers) ran more than once a frame. Now a frame can be
recorded (AuroraRecordBegin/End: every FIFO byte, and a list of the events an
interpolator blends: XF matrices, projections and channel colours, the TEV
colour registers, each draw's direct vertices, each vertex array as its draw
read it, copied and shared with the frame before's when unchanged) and fed
through the command processor again from the state it began with
(AuroraReplay*), each event's data maybe replaced by the caller's.

A replay calls no draw-done callback, asks for no readback, evicts no texture
object (a recorded frame's evictions wait until its recording is freed) and
makes its EFB copies into textures of its own, never the live frame's. After
it the state is the live frame's again. Tags (GX_AURORA_REC_TAG) give the
events the application's identities; pauses (GX_AURORA_REC_PAUSE) leave out
a part the application draws again itself. A frame that moved memory under
its draws, or drew outside the FIFO unpaused, says it can't be replayed.
A replay's own EFB copy textures are let go when there are many of them.
AuroraProcessorBusyNs: the command processor's busy time (what a frame or a
replay costs it).
---
diff --git a/include/dolphin/gx/GXAurora.h b/include/dolphin/gx/GXAurora.h
index 9469546..e5673fa 100644
--- a/include/dolphin/gx/GXAurora.h
+++ b/include/dolphin/gx/GXAurora.h
@@ -269,6 +269,86 @@ void AuroraMoveMemory(const void* from, const void* to, u32 size);
  */
 void AuroraSetDrawsBlocking(bool blocking);
 
+//
+// Frame recording and replay (frame interpolation, a second stereo eye: the application's frame drawn again
+// without running its draw code).
+//
+// Between AuroraRecordBegin and AuroraRecordEnd every byte written to the FIFO is kept, and the command processor
+// lists the frame's interpolable events: XF loads (matrices, projections, channel colours), the TEV colour
+// registers, the direct vertices of each draw, and each vertex array as the draw read it (copied, so later writes
+// to it don't reach a replay). AuroraReplay* feeds the kept bytes through the command processor again from the
+// state the frame began with; a table indexed by event may replace each event's data (same size and layout).
+// A replay never queues a readback, calls the draw-done callback, evicts a texture object or touches the copies
+// the live frame made (its own EFB copies go to textures of its own); after the replays the state is the live
+// frame's again (AuroraReplayFinish).
+//
+
+/** Followed by a u32: the identity the following events carry (the application's object). */
+#define GX_AURORA_REC_TAG 0x0080
+/** Followed by a u8: 1, the following commands are not listed or counted (a part the application draws again
+ * itself in a replay); 0, they are again. */
+#define GX_AURORA_REC_PAUSE 0x0081
+
+typedef enum {
+  AURORA_REC_XF = 1,        // reg: XF address; count: words; data: big-endian u32s in the stream
+  AURORA_REC_BP = 2,        // reg: BP register (0xE0-0xE7, TEV colours); data: the big-endian u32 in the stream
+  AURORA_REC_PROJ_FULL = 3, // data: 16 big-endian f32s in the stream
+  AURORA_REC_DRAW = 4,      // reg: the draw command; count: vertices; data: the vertices in the stream
+  AURORA_REC_ARRAY = 5,     // reg: the attribute; data: arrays[offset], the array's bytes as the draw read them
+} AuroraRecEventKind;
+
+typedef struct {
+  u32 tag;
+  u16 kind;
+  u16 reg;
+  u32 offset; // AURORA_REC_ARRAY: its index in arrays; the rest: in the stream
+  u32 size;   // bytes
+  u16 count;
+  u8 vtxSize; // AURORA_REC_DRAW: a vertex's size; AURORA_REC_ARRAY: the stride
+  u8 le;      // AURORA_REC_ARRAY: little-endian data
+  // AURORA_REC_DRAW: the direct position, colour 0 and texture coordinate 0 in a vertex (posOff etc. 0xFF: none)
+  u8 posOff, posType, posCnt, posFrac;
+  u8 clrOff, clrType;
+  u8 texOff, texType, texCnt, texFrac;
+  u8 _pad[2];
+} AuroraRecEvent;
+
+typedef struct AuroraRec AuroraRec;
+
+typedef struct {
+  const u8* stream;
+  u32 streamSize;
+  // the arrays the frame's draws read, as they read them (one the frame before read the same is shared with it)
+  const u8* const* arrays;
+  u32 arrayCount;
+  u32 arrayBytes;    // all of them
+  u32 arrayBytesNew; // those this frame copied (not the frame before's)
+  const AuroraRecEvent* events;
+  u32 eventCount;
+  // why the frame can't be replayed (NULL: it can): a heap move inside it, a direct gfx call outside a pause
+  const char* unreplayable;
+} AuroraRecView;
+
+/** Starts recording (processing what came before first). NULL when one is already recording. */
+AuroraRec* AuroraRecordBegin(void);
+/** Ends it (processing everything first); the state the frame left is kept for AuroraReplayFinish. */
+void AuroraRecordEnd(AuroraRec* rec);
+void AuroraRecordView(const AuroraRec* rec, AuroraRecView* out);
+void AuroraRecordFree(AuroraRec* rec);
+/** The command processor's busy time so far, in nanoseconds (what a frame or a replay costs it). */
+u64 AuroraProcessorBusyNs(void);
+/** The identity of what follows (GX_AURORA_REC_TAG), while recording. */
+void AuroraRecordTag(u32 tag);
+/** GX_AURORA_REC_PAUSE, while recording or replaying; returns the stream position after it (while recording). */
+u32 AuroraRecordPause(GXBool paused);
+/** Replays begin from the state rec began with; subst (count entries; NULL keeps the event's own data) is read
+ * while the bytes written by AuroraReplayWrite are processed, until AuroraReplayEnd. */
+void AuroraReplayBegin(const AuroraRec* rec, const void* const* subst, u32 count);
+void AuroraReplayWrite(const void* data, u32 size);
+void AuroraReplayEnd(void);
+/** After the replays (or none): the live frame's state back, the texture evictions it deferred done. */
+void AuroraReplayFinish(AuroraRec* rec);
+
 /**
  * Sets the actual render viewport in native framebuffer coordinates.
  * Overrides the automatically scaled values set by the logical GXSetViewport.
