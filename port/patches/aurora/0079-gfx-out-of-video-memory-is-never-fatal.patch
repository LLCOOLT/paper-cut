From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LLCOOLT <114613597+LLCOOLT@users.noreply.github.com>
Date: Thu, 12 Nov 2026 12:00:00 -0500
Subject: [PATCH] gfx: out of video memory is never fatal

An OutOfMemory error (a texture, an EFB copy's conversion target or a buffer
the GPU couldn't make, on any backend) went to the uncaptured-error callback,
which ended the game (Paper Cut #56: "Copy Conv Texture" at gor_10 on a 6 GB
card under Vulkan). It is now counted and logged (AuroraOutOfMemoryCount);
the object is an error object whose work is dropped, every texture cache is
let go at the frame's end (the error objects with them, made again when next
drawn) and the decoded textures' budget is halved (at least 64 MiB). After
one, validation errors (from those error objects) are warnings, not fatal.

AURORA_FAKE_TEXTURE_OOM=<from>[:<count>] (tests): the from-th game texture
made and count - 1 after it (default 4) are error objects with an
OutOfMemory error injected, as a full GPU makes them.
---
diff --git a/include/dolphin/gx/GXAurora.h b/include/dolphin/gx/GXAurora.h
index 9469546..45aae79 100644
--- a/include/dolphin/gx/GXAurora.h
+++ b/include/dolphin/gx/GXAurora.h
@@ -218,6 +218,13 @@ void AuroraFlushTextureCaches(void);
  */
 void AuroraFlushStaticTextureCaches(void);
 
+/**
+ * How many times video memory has run out this run (a texture or buffer the GPU couldn't make, on any backend).
+ * Never fatal: the object is an error object whose work is dropped, and every texture cache is let go at the frame's
+ * end, with the decoded textures' budget halved. A guard can turn the picture's settings down when it rises.
+ */
+u32 AuroraOutOfMemoryCount(void);
+
 /**
  * What Aurora holds, for a guard against resources that grow without end (Paper Cut #39). The per-frame counts are
  * the last frame recorded's; the rest is alive now. textureBytes is an estimate (texels by format, with mips).
diff --git a/lib/dolphin/gx/GXAurora.cpp b/lib/dolphin/gx/GXAurora.cpp
index 81f0fd6..a501254 100644
--- a/lib/dolphin/gx/GXAurora.cpp
+++ b/lib/dolphin/gx/GXAurora.cpp
@@ -220,6 +220,8 @@ void AuroraFlushTextureCaches(void) {
 
 void AuroraFlushStaticTextureCaches(void) { aurora::gx::clear_static_texture_cache(); }
 
+u32 AuroraOutOfMemoryCount(void) { return aurora::webgpu::out_of_memory_count(); }
+
 void AuroraGetResourceStats(AuroraResourceStats* out) {
   if (out == nullptr) {
     return;
diff --git a/lib/gfx/texture.cpp b/lib/gfx/texture.cpp
index 847866d..1c77d10 100644
--- a/lib/gfx/texture.cpp
+++ b/lib/gfx/texture.cpp
@@ -14,6 +14,7 @@
 #include <memory>
 #include <utility>
 
+#include <SDL3/SDL_stdinc.h>
 #include <fmt/format.h>
 #include <tracy/Tracy.hpp>
 #include <webgpu/webgpu_cpp.h>
@@ -39,6 +40,34 @@ TextureLiveTotals texture_live_totals() noexcept {
   return {.count = count > 0 ? static_cast<uint64_t>(count) : 0, .bytes = bytes > 0 ? static_cast<uint64_t>(bytes) : 0};
 }
 
+// A game texture made (static, render target, conversion target). Out of video memory, Dawn hands back an error
+// object and reports OutOfMemory: never fatal (webgpu::note_out_of_memory), the caches let it go at the frame's end.
+// AURORA_FAKE_TEXTURE_OOM=<from>[:<count>] (tests): the from-th texture made here and count - 1 after it (default 4
+// in all) are such error objects, with an OutOfMemory error injected, as a full GPU makes them (Paper Cut #56's
+// "Copy Conv Texture" at gor_10).
+static wgpu::Texture create_texture(const wgpu::TextureDescriptor& desc) {
+#ifdef WEBGPU_DAWN
+  static const std::pair<uint64_t, uint64_t> fake = [] {
+    const char* v = SDL_getenv("AURORA_FAKE_TEXTURE_OOM");
+    const int from = v != nullptr ? SDL_atoi(v) : 0;
+    const char* colon = v != nullptr ? SDL_strchr(v, ':') : nullptr;
+    const int count = colon != nullptr ? SDL_atoi(colon + 1) : 4;
+    return std::pair<uint64_t, uint64_t>{from > 0 ? static_cast<uint64_t>(from) : 0,
+                                         count > 0 ? static_cast<uint64_t>(count) : 4};
+  }();
+  static std::atomic<uint64_t> s_made{0};
+  if (fake.first != 0) {
+    const uint64_t n = s_made.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (n >= fake.first && n < fake.first + fake.second) {
+      const auto why = fmt::format("AURORA_FAKE_TEXTURE_OOM: texture {} ({}x{})", n, desc.size.width, desc.size.height);
+      g_device.InjectError(wgpu::ErrorType::OutOfMemory, wgpu::StringView{why.data(), why.size()});
+      return g_device.CreateErrorTexture(&desc);
+    }
+  }
+#endif
+  return g_device.CreateTexture(&desc);
+}
+
 // Texels by format (never format_info, which stops on a format it doesn't know: HDR's, depth's), with every mip
 uint64_t estimate_texture_bytes(wgpu::TextureFormat format, wgpu::Extent3D size, uint32_t mips) noexcept {
   uint64_t num = 4, den = 1; // bytes per texel, as a fraction (compressed formats: under one)
@@ -238,7 +267,7 @@ TextureHandle new_dynamic_texture_2d(uint32_t width, uint32_t height, uint32_t m
       .mipLevelCount = mips,
       .sampleCount = 1,
   };
-  auto texture = g_device.CreateTexture(&textureDescriptor);
+  auto texture = create_texture(textureDescriptor);
   const auto viewLabel = fmt::format("{} view", label);
   wgpu::TextureViewDescriptor textureViewDescriptor{
       .label = viewLabel.c_str(),
@@ -273,7 +302,7 @@ TextureHandle new_render_texture(uint32_t width, uint32_t height, u32 gxFormat,
       .mipLevelCount = 1,
       .sampleCount = 1,
   };
-  auto texture = g_device.CreateTexture(&textureDescriptor);
+  auto texture = create_texture(textureDescriptor);
 
   // Create texture view for color attachments
   const auto viewLabel = fmt::format("{} view", label);
@@ -306,7 +335,7 @@ TextureHandle new_conv_texture(uint32_t width, uint32_t height, u32 gxFormat, co
       .mipLevelCount = 1,
       .sampleCount = 1,
   };
-  auto texture = g_device.CreateTexture(&textureDescriptor);
+  auto texture = create_texture(textureDescriptor);
 
   // Create texture view for color attachments
   const auto viewLabel = fmt::format("{} view", label);
diff --git a/lib/gx/texture.cpp b/lib/gx/texture.cpp
index acd2a61..f7964e9 100644
--- a/lib/gx/texture.cpp
+++ b/lib/gx/texture.cpp
@@ -6,6 +6,7 @@
 #include "../gfx/tex_palette_conv.hpp"
 #include "../gfx/texture_convert.hpp"
 #include "../gfx/texture_replacement.hpp"
+#include "../webgpu/gpu.hpp"
 #include "shader_info.hpp"
 
 #include <absl/container/flat_hash_map.h>
@@ -899,6 +900,23 @@ void end_frame() noexcept {
   s_stats.publishes = streamingStats.publishes;
   s_stats.publishBytes = streamingStats.publishBytes;
   ++s_frameCount;
+  {
+    // Video memory ran out (webgpu::note_out_of_memory): every cached texture let go, the error objects among them
+    // too (each is made again when next drawn), and the decoded textures' budget halved (at least 64 MiB), so the
+    // game goes on in less memory instead of stopping (Paper Cut #56)
+    static uint32_t s_seenOutOfMemory = 0;
+    const uint32_t outOfMemory = webgpu::out_of_memory_count();
+    if (outOfMemory != s_seenOutOfMemory) {
+      s_seenOutOfMemory = outOfMemory;
+      do_clear_static_texture_cache();
+      s_contentCache.clear();
+      s_sourceKeyCache.clear();
+      clear_copy_texture_cache();
+      s_contentCache.set_budget(std::max<uint64_t>(s_contentCache.budget() / 2, uint64_t{64} << 20));
+      Log.warn("Out of video memory: texture caches let go, decoded textures within {} MiB from now on",
+               s_contentCache.budget() >> 20);
+    }
+  }
   apply_pending_invalidations();
   sweep_object_caches();
   s_copyCache.end_frame();
diff --git a/lib/webgpu/gpu.cpp b/lib/webgpu/gpu.cpp
index ad6c798..c246559 100644
--- a/lib/webgpu/gpu.cpp
+++ b/lib/webgpu/gpu.cpp
@@ -84,6 +84,20 @@ static std::atomic_bool g_initialized = false;
 static std::atomic_bool g_vsyncEnabled = true;
 static std::atomic_bool g_vrrEnabled = false; // aurora_set_vrr
 static std::atomic_int g_postFilter = 0;      // aurora_set_post_filter
+// Video memory ran out (an OutOfMemory error, any backend): counted, never fatal (AuroraOutOfMemoryCount)
+static std::atomic_uint32_t g_outOfMemory = 0;
+
+uint32_t out_of_memory_count() noexcept { return g_outOfMemory.load(std::memory_order_acquire); }
+
+// An OutOfMemory error: the object made is an error object (its draws are dropped), the GX caches holding it are
+// let go at the frame's end (gx/texture.cpp), and the application's guard is told through the count. The run goes
+// on; validation errors from the error objects are warnings from now on (a frame's work dropped, not the game).
+void note_out_of_memory(std::string_view message) noexcept {
+  const uint32_t n = g_outOfMemory.fetch_add(1, std::memory_order_acq_rel) + 1;
+  if (n <= 20) {
+    Log.error("Out of video memory ({}): {}; the texture caches are let go and the game goes on", n, message);
+  }
+}
 
 namespace {
 
@@ -1859,6 +1873,20 @@ bool initialize(AuroraBackend auroraBackend, bool allowCpu) {
           (void)device;
           return;
 #endif
+          if (type == wgpu::ErrorType::OutOfMemory) {
+            // (a texture or buffer too many for the GPU's memory: recoverable, never an abort; Paper Cut #56)
+            note_out_of_memory(std::string_view{message.data, message.length});
+            return;
+          }
+          if (g_initialized && type == wgpu::ErrorType::Validation && out_of_memory_count() != 0) {
+            // an error object from running out of memory used in a pass or bind group: that work dropped
+            static std::atomic_int sTold = 0;
+            if (sTold.fetch_add(1) < 20) {
+              Log.warn("WebGPU error {} after running out of video memory (that work dropped): {}", underlying(type),
+                       message);
+            }
+            return;
+          }
           if (g_initialized) {
             FATAL("WebGPU error {}: {}", underlying(type), message);
           } else {
diff --git a/lib/webgpu/gpu.hpp b/lib/webgpu/gpu.hpp
index 7217bcb..83b4171 100644
--- a/lib/webgpu/gpu.hpp
+++ b/lib/webgpu/gpu.hpp
@@ -7,6 +7,7 @@
 
 #include <array>
 #include <cstdint>
+#include <string_view>
 
 struct SDL_Window;
 
@@ -94,6 +95,11 @@ extern bool g_dualSourceBlendingSupported;
 // Decided once at device creation ($AURORA_NO_IMMEDIATES=1 / $AURORA_IMMEDIATES=1 force it).
 extern bool g_immediatesSupported;
 
+// Video memory ran out: how many times this run (never fatal: gpu.cpp's error callback), and one noted (the
+// error callback's, and AURORA_FAKE_TEXTURE_OOM's)
+uint32_t out_of_memory_count() noexcept;
+void note_out_of_memory(std::string_view message) noexcept;
+
 bool initialize(AuroraBackend backend, bool allowCpu);
 void set_post_filter(int mode) noexcept; // aurora_set_post_filter
 void set_vrr(bool enabled) noexcept;     // aurora_set_vrr
