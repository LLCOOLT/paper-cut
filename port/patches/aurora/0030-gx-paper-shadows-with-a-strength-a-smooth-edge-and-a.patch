From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LLCOOLT <114613597+LLCOOLT@users.noreply.github.com>
Date: Fri, 6 Nov 2026 21:33:01 -0500
Subject: [PATCH 30/31] gx: paper shadows with a strength, a smooth edge and a
 soft penumbra

aurora_set_paper_shadow_ex(strength, soft, feetView, length): the shadow
draws' opacity comes from a uniform instead of a fixed 0.45 (so a character
lit by two lamps can cast two lighter shadows); a cut-out's shadow edge is
one pixel smooth instead of an alpha-test step; and soft, the edge widens
into a penumbra (up to the texture filter's whole ramp across a texel) and
the shadow fades away from the feet, given in view space with the shadow's
length. GX_AURORA_SET_PAPER carries the strength, softness and feet.
aurora_set_paper_shadow(on) is the plain shadow as before.
---
 include/aurora/paper.h       | 11 ++++++++++-
 lib/dolphin/gx/GXAurora.cpp  | 29 +++++++++++++++++++++++++----
 lib/gx/command_processor.cpp | 13 +++++++++++--
 lib/gx/gx.cpp                |  3 ++-
 lib/gx/gx.hpp                |  8 ++++++--
 lib/gx/shader.cpp            | 34 +++++++++++++++++++++++++++++++---
 lib/gx/shader_info.cpp       | 10 ++++++++++
 7 files changed, 95 insertions(+), 13 deletions(-)

diff --git a/include/aurora/paper.h b/include/aurora/paper.h
index 14e838d..455828a 100644
--- a/include/aurora/paper.h
+++ b/include/aurora/paper.h
@@ -9,7 +9,8 @@
 extern "C" {
 #endif
 
-/* GX command: u8 edges, u8 shadow, u64 distance-field texture data address */
+/* GX command: u8 edges, u8 shadow strength, u8 shadow softness, f32[4] shadow feet (view space) and length, u64
+ * distance-field texture data address */
 #define GX_AURORA_SET_PAPER 0x0060
 
 /**
@@ -33,6 +34,14 @@ void aurora_set_paper_distance_field(const void* texels);
  */
 void aurora_set_paper_shadow(int on);
 
+/**
+ * Shadow draws as aurora_set_paper_shadow, with their look: strength is the shadow's opacity (0: off, as
+ * aurora_set_paper_shadow(0); 0.45 its plain shadow). A cut-out's edge is always one pixel smooth; soft (0-1, with
+ * feetView: the point the shadow starts from, in view space, and length: how far it reaches, in the same units)
+ * widens that edge into a penumbra and fades the shadow away from the feet, as a shadow cast by a lamp does.
+ */
+void aurora_set_paper_shadow_ex(float strength, float soft, const float* feetView, float length);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/lib/dolphin/gx/GXAurora.cpp b/lib/dolphin/gx/GXAurora.cpp
index b2b34f4..7418f7d 100644
--- a/lib/dolphin/gx/GXAurora.cpp
+++ b/lib/dolphin/gx/GXAurora.cpp
@@ -1,6 +1,8 @@
 #include "dolphin/gx/GXAurora.h"
 #include "aurora/display.h"
 
+#include <algorithm>
+#include <cstring>
 #include <limits>
 
 #include "__gx.h"
@@ -90,12 +92,18 @@ void GXSetProjectionFull(const void* mtx) {
 // aurora/paper.h: kept here, sent whole on each change
 #include "aurora/paper.h"
 static u8 s_paperEdges = 0;
-static u8 s_paperShadow = 0;
+static u8 s_paperShadow = 0;     // strength, 0-255 (0: off)
+static u8 s_paperShadowSoft = 0; // penumbra, 0-255
+static f32 s_paperShadowFeet[4] = {};
 static const void* s_paperSdf = nullptr;
 static void write_paper() {
   GX_WRITE_AURORA(GX_AURORA_SET_PAPER);
   GX_WRITE_U8(s_paperEdges);
   GX_WRITE_U8(s_paperShadow);
+  GX_WRITE_U8(s_paperShadowSoft);
+  for (f32 v : s_paperShadowFeet) {
+    GX_WRITE_F32(v);
+  }
   GX_WRITE_U64(reinterpret_cast<u64>(s_paperSdf));
 }
 void aurora_set_paper_edges(int on) {
@@ -110,9 +118,22 @@ void aurora_set_paper_distance_field(const void* texels) {
     write_paper();
   }
 }
-void aurora_set_paper_shadow(int on) {
-  if (s_paperShadow != (on != 0)) {
-    s_paperShadow = on != 0;
+void aurora_set_paper_shadow(int on) { aurora_set_paper_shadow_ex(on != 0 ? 0.45f : 0.f, 0.f, nullptr, 0.f); }
+void aurora_set_paper_shadow_ex(float strength, float soft, const float* feetView, float length) {
+  const auto unit = [](float v) { return static_cast<u8>(v <= 0.f ? 0 : v >= 1.f ? 255 : static_cast<int>(v * 255.f + 0.5f)); };
+  const u8 shadow = strength > 0.f ? std::max<u8>(unit(strength), 1) : 0;
+  const u8 shadowSoft = shadow != 0 && feetView != nullptr && length > 0.f ? unit(soft) : 0;
+  f32 feet[4] = {};
+  if (shadowSoft != 0) {
+    feet[0] = feetView[0];
+    feet[1] = feetView[1];
+    feet[2] = feetView[2];
+    feet[3] = length;
+  }
+  if (shadow != s_paperShadow || shadowSoft != s_paperShadowSoft || memcmp(feet, s_paperShadowFeet, sizeof(feet)) != 0) {
+    s_paperShadow = shadow;
+    s_paperShadowSoft = shadowSoft;
+    memcpy(s_paperShadowFeet, feet, sizeof(feet));
     write_paper();
   }
 }
