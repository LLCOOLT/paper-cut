+
+// A texture missing from the content cache is keyed and uploaded from one copy of its bytes (and its TLUT's).
+// The FIFO is processed on its own thread while the game runs on, and the game frees, reloads and compacts the
+// memory a queued draw points at: hashed from one read and uploaded from another, a key could hold another
+// picture for good (a Toad wearing Flurrie's face). Per thread, reused; the uploads copy the bytes.
+struct SourceSnapshot {
+  std::vector<u8> texture;
+  std::vector<u8> tlut;
+};
+thread_local SourceSnapshot s_snapshot;
+
+GXTexObj_ snapshot_texture(const GXTexObj_& obj) {
+  const size_t bytes = texture::texture_source_size(obj.format(), obj.width(), obj.height(), obj.mip_count());
+  const auto* src = static_cast<const u8*>(obj.data);
+  s_snapshot.texture.assign(src, src + bytes);
+  GXTexObj_ copy = obj;
+  copy.data = s_snapshot.texture.data();
+  return copy;
+}
+
+GXTlutObj_ snapshot_tlut(const GXTlutObj_& tlut) {
+  const size_t bytes = texture::tlut_source_size(tlut.numEntries);
+  const auto* src = static_cast<const u8*>(tlut.data);
+  s_snapshot.tlut.assign(src, src + bytes);
+  GXTlutObj_ copy = tlut;
+  copy.data = s_snapshot.tlut.data();
+  return copy;
+}
 } // namespace
 
