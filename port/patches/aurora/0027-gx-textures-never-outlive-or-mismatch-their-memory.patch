index f8089ae..f008115 100644
--- a/include/dolphin/gx/GXAurora.h
+++ b/include/dolphin/gx/GXAurora.h
@@ -112,6 +112,12 @@ extern "C" {
 /** Sets whether subsequent draws wait for pipeline compilation. Followed by a u8 boolean. */
 #define GX_AURORA_SET_DRAWS_BLOCKING 0x0042
 
+/** Game memory [lo, hi) was freed (AuroraForgetMemory). Followed by the u64 lo and u64 hi addresses. */
+#define GX_AURORA_FORGET_MEMORY 0x0070
+
+/** Game memory moved (AuroraMoveMemory). Followed by the u64 from and u64 to addresses and a u64 size. */
+#define GX_AURORA_MOVE_MEMORY 0x0071
+
 /**
  * Asynchronous readback of EFB points.
  *
@@ -210,6 +216,19 @@ void AuroraFlushTextureCaches(void);
  */
 void AuroraGXSync(void);
 
+/**
+ * Game memory [lo, hi) was freed: the textures made from it, and the EFB copies made into it, are forgotten, so
+ * that data allocated there later is never drawn as the old (a copy texture is keyed by its address). In order
+ * with the draws: the ones queued before still see what they saw.
+ */
+void AuroraForgetMemory(const void* lo, const void* hi);
+
+/**
+ * size bytes of game memory moved (a heap compacted): EFB copies made into them move with them, and what was
+ * recorded at either place is forgotten. In order with the draws.
+ */
+void AuroraMoveMemory(const void* from, const void* to, u32 size);
+
 /**
  * When true, GX draws block and wait for their pipeline compilation to complete, if not already done.
  * When false, GX draws are skipped if their pipeline is not yet compiled.
diff --git a/lib/dolphin/gx/GXAurora.cpp b/lib/dolphin/gx/GXAurora.cpp
index d717fd8..b2b34f4 100644
--- a/lib/dolphin/gx/GXAurora.cpp
+++ b/lib/dolphin/gx/GXAurora.cpp
@@ -192,3 +192,22 @@ void AuroraFlushTextureCaches(void) {
   aurora::gx::clear_static_texture_cache();
   aurora::gx::clear_copy_texture_cache();
 }
+
+void AuroraForgetMemory(const void* lo, const void* hi) {
+  if (lo == nullptr || hi <= lo) {
+    return;
+  }
+  GX_WRITE_AURORA(GX_AURORA_FORGET_MEMORY);
+  GX_WRITE_U64(reinterpret_cast<u64>(lo));
+  GX_WRITE_U64(reinterpret_cast<u64>(hi));
+}
+
+void AuroraMoveMemory(const void* from, const void* to, u32 size) {
+  if (from == nullptr || to == nullptr || from == to || size == 0) {
+    return;
+  }
+  GX_WRITE_AURORA(GX_AURORA_MOVE_MEMORY);
+  GX_WRITE_U64(reinterpret_cast<u64>(from));
+  GX_WRITE_U64(reinterpret_cast<u64>(to));
+  GX_WRITE_U64(static_cast<u64>(size));
+}
