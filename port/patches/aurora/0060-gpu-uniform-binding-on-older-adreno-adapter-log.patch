   g_stagingSlots.resize(StagingBuffersUsed);
+  // The vertex and storage buffers are bound whole as storage buffers: never past the device's binding limit
+  // (a device that offers less would otherwise fail every GX bind group, and nothing would draw)
+  if (const uint64_t maxBinding = g_resources.limits.maxStorageBufferBindingSize;
+      maxBinding != WGPU_LIMIT_U64_UNDEFINED && maxBinding != 0) {
+    const uint64_t limit = maxBinding & ~uint64_t{255};
+    if (StorageBufferSize > limit || VertexBufferSize > limit) {
+      Log.warn("Storage buffers capped at the device's {} bytes (were {} and {})", limit, StorageBufferSize,
+               VertexBufferSize);
+      StorageBufferSize = std::min(StorageBufferSize, limit);
+      VertexBufferSize = std::min(VertexBufferSize, limit);
+    }
+  }
   Log.info("Staging buffers: {} of {} MiB", StagingBuffersUsed, staging_buffer_size() >> 20);
 
   const auto createBuffer = [](wgpu::Buffer& out, wgpu::BufferUsage usage, uint64_t size, const char* label) {
