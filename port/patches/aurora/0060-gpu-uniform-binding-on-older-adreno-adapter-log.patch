 }
 
+// The Adreno model number from the adapter's name ("Adreno (TM) 710" -> 710), 0 when it isn't one or has no number
+// ("Adreno X1-85": a newer family)
+static int adreno_model(const wgpu::AdapterInfo& info) noexcept {
+  const std::string_view device = info.device.IsUndefined() ? std::string_view{} : std::string_view{info.device};
+  const auto at = device.find("Adreno");
+  if (at == std::string_view::npos && info.vendorID != 0x5143) { // (Qualcomm's PCI vendor id)
+    return 0;
+  }
+  size_t i = at == std::string_view::npos ? 0 : at + 6;
+  while (i < device.size() && (device[i] < '0' || device[i] > '9')) {
+    if (device[i] == 'X' || device[i] == 'x') {
+      return 0;
+    }
+    ++i;
+  }
+  int model = 0;
+  for (; i < device.size() && device[i] >= '0' && device[i] <= '9' && model < 100000; ++i) {
+    model = model * 10 + (device[i] - '0');
+  }
+  return model;
+}
+
+// One line for player reports: the adapter's ids, every feature it offers and the limits GX rendering leans on
+static void log_adapter_capabilities(const wgpu::Limits& limits) {
+  wgpu::SupportedFeatures features;
+  g_adapter.GetFeatures(&features);
+  std::string featureList;
+  for (size_t i = 0; i < features.featureCount; ++i) {
+    if (!featureList.empty()) {
+      featureList += ' ';
+    }
+    const auto name = magic_enum::enum_name(features.features[i]);
+    featureList += name.empty() ? fmt::format("0x{:x}", static_cast<uint32_t>(features.features[i])) : std::string{name};
+  }
+  Log.info("Adapter capabilities: vendor 0x{:04x} device 0x{:04x} adreno {} | features: {} | limits: tex2D {} "
+           "arrayLayers {} bindGroups {} sampledTex/stage {} samplers/stage {} storageBuf/stage {} storageBufBinding {} "
+           "maxBuffer {} uniformBufBinding {} immediates {} colorAttachments {} colorBytes/sample {} "
+           "interStageVars {} uniformAlign {} storageAlign {}",
+           g_adapterInfo.vendorID, g_adapterInfo.deviceID, adreno_model(g_adapterInfo), featureList,
+           limits.maxTextureDimension2D, limits.maxTextureArrayLayers, limits.maxBindGroups,
+           limits.maxSampledTexturesPerShaderStage, limits.maxSamplersPerShaderStage,
+           limits.maxStorageBuffersPerShaderStage, limits.maxStorageBufferBindingSize, limits.maxBufferSize,
+           limits.maxUniformBufferBindingSize, limits.maxImmediateSize, limits.maxColorAttachments,
+           limits.maxColorAttachmentBytesPerSample, limits.maxInterStageShaderVariables,
+           limits.minUniformBufferOffsetAlignment, limits.minStorageBufferOffsetAlignment);
+}
+
 bool initialize(AuroraBackend auroraBackend, bool allowCpu) {
   if (!g_instance) {
     Log.info("Creating WebGPU instance");
@@ -1485,14 +1530,44 @@ bool initialize(AuroraBackend auroraBackend, bool allowCpu) {
   {
     wgpu::Limits supportedLimits{};
     g_adapter.GetLimits(&supportedLimits);
+    std::string immediatesWhy;
+    g_immediatesSupported = supportedLimits.maxImmediateSize != WGPU_LIMIT_U32_UNDEFINED &&
+                            supportedLimits.maxImmediateSize >= sizeof(gx::DrawImmediateData);
+    if (!g_immediatesSupported) {
+      immediatesWhy = fmt::format("maxImmediateSize {} < {}", supportedLimits.maxImmediateSize,
+                                  sizeof(gx::DrawImmediateData));
+    }
 #ifdef __EMSCRIPTEN__
-    g_immediatesSupported =
-        supportedLimits.maxImmediateSize != WGPU_LIMIT_U32_UNDEFINED &&
-        supportedLimits.maxImmediateSize >= sizeof(gx::DrawImmediateData) &&
-        g_instance.HasWGSLLanguageFeature(wgpu::WGSLLanguageFeatureName::ImmediateAddressSpace) &&
-        SDL_getenv("AURORA_NO_IMMEDIATES") == nullptr; // (to try the fallback where immediates are)
-    Log.info("Immediate data: {}", g_immediatesSupported ? "yes" : "no (a uniform binding instead)");
+    if (g_immediatesSupported &&
+        !g_instance.HasWGSLLanguageFeature(wgpu::WGSLLanguageFeatureName::ImmediateAddressSpace)) {
+      g_immediatesSupported = false;
+      immediatesWhy = "no WGSL immediate address space";
+    }
+#else
+    if (g_immediatesSupported && g_backendType == wgpu::BackendType::Vulkan) {
+      // Adreno before the 730 (Snapdragon 6 Gen 1 / 7s Gen 2's 710, the 6xx): with the per-draw values in
+      // push constants, draws with indexed vertex arrays (maps, models) vanished and only 2D drew
+      // (Paper Cut #30; Dusklight's Adreno 710 reports, the same Aurora path). The uniform binding is the
+      // path Aurora took before immediates, which these drivers drew.
+      const int adreno = adreno_model(g_adapterInfo);
+      if (adreno > 0 && adreno < 730) {
+        g_immediatesSupported = false;
+        immediatesWhy = fmt::format("Adreno {} Vulkan driver", adreno);
+      }
+    }
 #endif
+    if (const char* force = SDL_getenv("AURORA_NO_IMMEDIATES"); force != nullptr && force[0] != '0') {
+      g_immediatesSupported = false;
+      immediatesWhy = "$AURORA_NO_IMMEDIATES";
+    } else if (const char* allow = SDL_getenv("AURORA_IMMEDIATES");
+               allow != nullptr && allow[0] != '0' && immediatesWhy.find("Adreno") == 0) {
+      g_immediatesSupported = true;
+      immediatesWhy.clear();
+    }
+    Log.info("Immediate data: {}", g_immediatesSupported
+                                       ? std::string{"yes"}
+                                       : fmt::format("no ({}): a uniform binding instead", immediatesWhy));
+    log_adapter_capabilities(supportedLimits);
     wgpu::CompatibilityModeLimits compatibilityModeLimits{wgpu::CompatibilityModeLimits::Init{
         .maxStorageBuffersInVertexStage = 2,
         .maxStorageBuffersInFragmentStage = 2,
@@ -1515,7 +1590,8 @@ bool initialize(AuroraBackend auroraBackend, bool allowCpu) {
             supportedLimits.minUniformBufferOffsetAlignment < 64 ? 64 : supportedLimits.minUniformBufferOffsetAlignment,
         .minStorageBufferOffsetAlignment =
             supportedLimits.minStorageBufferOffsetAlignment < 16 ? 16 : supportedLimits.minStorageBufferOffsetAlignment,
-        .maxImmediateSize = g_immediatesSupported ? sizeof(gx::DrawImmediateData) : WGPU_LIMIT_U32_UNDEFINED,
+        .maxImmediateSize =
+            g_immediatesSupported ? static_cast<uint32_t>(sizeof(gx::DrawImmediateData)) : WGPU_LIMIT_U32_UNDEFINED,
     };
     Log.info(
         "Using limits:"
@@ -1569,6 +1645,32 @@ bool initialize(AuroraBackend auroraBackend, bool allowCpu) {
       featureList += magic_enum::enum_name(featureName);
     }
     Log.info("Enabling features: {}", featureList);
+    {
+      // What this adapter lacks and what stands in (one line, for player reports)
+      std::string fallbacks;
+      const auto add = [&](std::string_view text) {
+        if (!fallbacks.empty()) {
+          fallbacks += "; ";
+        }
+        fallbacks += text;
+      };
+      if (!g_hasCoreFeatures) {
+        add("compatibility mode (no core features)");
+      }
+      if (!g_bcTexturesSupported) {
+        add("BC textures decoded to RGBA8 on the CPU");
+      }
+      if (!g_textureComponentSwizzleSupported) {
+        add("R8/RG8 textures expanded to RGBA8");
+      }
+      if (!g_dualSourceBlendingSupported) {
+        add("no dual-source blending (destination alpha in a prepass)");
+      }
+      if (!g_immediatesSupported) {
+        add("per-draw values in a uniform binding, not immediates");
+      }
+      Log.info("Graphics fallbacks: {}", fallbacks.empty() ? std::string{"none"} : fallbacks);
+    }
 #ifdef WEBGPU_DAWN
     wgpu::DawnCacheDeviceDescriptor cacheDescriptor({.nextInChain = nullptr});
     cacheDescriptor.SetDawnLoadCacheDataCallback(
diff --git a/lib/webgpu/gpu.hpp b/lib/webgpu/gpu.hpp
index fd16a7f..5761f92 100644
--- a/lib/webgpu/gpu.hpp
+++ b/lib/webgpu/gpu.hpp
@@ -74,13 +74,11 @@ extern bool g_bcTexturesSupported;
 extern bool g_astcTexturesSupported;
 extern bool g_textureComponentSwizzleSupported;
 extern bool g_dualSourceBlendingSupported;
-#ifdef __EMSCRIPTEN__
-// Immediate data (WGSL var<immediate>, 64 bytes a draw): not in every browser yet (Firefox, Safari).
-// Without it, GX draws take those bytes from a second dynamic-offset uniform binding instead.
+// Immediate data (WGSL var<immediate>, 64 bytes a draw): not in every browser yet (Firefox, Safari), and
+// not trusted on older Adreno Vulkan drivers (indexed vertex arrays read from it came out wrong: only 2D
+// drew). Without it, GX draws take those bytes from a second dynamic-offset uniform binding instead.
+// Decided once at device creation ($AURORA_NO_IMMEDIATES=1 / $AURORA_IMMEDIATES=1 force it).
 extern bool g_immediatesSupported;
-#else
-constexpr bool g_immediatesSupported = true; // (Dawn native always has it)
-#endif
 
