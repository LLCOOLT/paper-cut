+
+bool aurora_dvd_open_stream(const AuroraDvdStream* source) {
+  if (source == nullptr || source->readAt == nullptr || source->length == nullptr) {
+    return false;
+  }
+
+  s_worker.stop();
+  clearState();
+
+  const NodDiscStream stream{
+      .user_data = source->userData,
+      .read_at = source->readAt,
+      .stream_len = source->length,
+      .close = source->close,
+  };
+  return open_nod_stream(stream);
+}
+
+static bool open_nod_stream(const NodDiscStream& stream) {
   const NodDiscOptions options{
+#if defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
+      .preloader_threads = 0, // one thread (the browser)
+#else
       .preloader_threads = 1,
+#endif
   };
 
   NodHandle* discHandle;
