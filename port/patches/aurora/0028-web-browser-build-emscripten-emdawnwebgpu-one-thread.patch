+/**
+ * A disc image read through callbacks rather than from a path (the browser: a file the page was given).
+ * readAt returns the bytes read (fewer at the end), or -1; length the image's size, or -1. close, if set, is
+ * called once the image is closed.
+ */
+typedef struct AuroraDvdStream {
+  void* userData;
+  int64_t (*readAt)(void* userData, uint64_t offset, void* out, size_t len);
+  int64_t (*length)(void* userData);
+  void (*close)(void* userData);
+} AuroraDvdStream;
+
+/**
+ * Open a disc image through a stream, as aurora_dvd_open does a path.
+ */
+bool aurora_dvd_open_stream(const AuroraDvdStream* stream);
+
 /**
  * Close the disc image and free all resources.
  */
