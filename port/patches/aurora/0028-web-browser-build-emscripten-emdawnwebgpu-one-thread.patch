diff --git a/cmake/AuroraDawnProvider.cmake b/cmake/AuroraDawnProvider.cmake
index 184d0ee..fa27f5b 100644
--- a/cmake/AuroraDawnProvider.cmake
+++ b/cmake/AuroraDawnProvider.cmake
@@ -76,6 +76,28 @@ function(_aurora_dawn_fix_android_link_interface)
   endif ()
 endfunction()
 
+# Emscripten: no Dawn at all. The browser's own WebGPU, through Dawn's
+# Emscripten bindings (emdawnwebgpu, an Emscripten port: same webgpu.h and
+# webgpu_cpp.h as Dawn native).
+if (EMSCRIPTEN)
+  if (NOT TARGET dawn::webgpu_dawn)
+    # A Dawn release's emdawnwebgpu (pinned, with its hash, in the "remote port" file) rather than the one
+    # Emscripten bundles: render passes' SetImmediates (gx/pipeline.cpp) came after Emscripten 6.0.13's.
+    set(AURORA_EMDAWNWEBGPU_PORT "${CMAKE_CURRENT_LIST_DIR}/emdawnwebgpu.remoteport.py" CACHE STRING
+      "emdawnwebgpu port for --use-port (a remote port file, a package's port file, or emdawnwebgpu)")
+    add_library(aurora_emdawnwebgpu INTERFACE)
+    target_compile_options(aurora_emdawnwebgpu INTERFACE "--use-port=${AURORA_EMDAWNWEBGPU_PORT}")
+    target_link_options(aurora_emdawnwebgpu INTERFACE "--use-port=${AURORA_EMDAWNWEBGPU_PORT}")
+    add_library(dawn::webgpu_dawn ALIAS aurora_emdawnwebgpu)
+    add_library(dawn::dawncpp_headers ALIAS aurora_emdawnwebgpu)
+  endif ()
+  foreach (_backend D3D12 D3D11 VULKAN METAL DESKTOP_GL OPENGLES NULL)
+    set(DAWN_ENABLE_${_backend} OFF CACHE INTERNAL "")
+  endforeach ()
+  set(AURORA_DAWN_IS_SHARED FALSE)
+  return()
+endif ()
+
 aurora_get_target_arch(_dawn_target_arch)
 string(TOLOWER "${CMAKE_SYSTEM_NAME}" _dawn_system)
 string(TOLOWER "${_dawn_target_arch}" _dawn_arch)
