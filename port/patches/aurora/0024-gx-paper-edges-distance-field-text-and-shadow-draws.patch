@@ -1598,7 +1605,18 @@ std::string build_shader_source(const ShaderConfig& config, DstAlphaMode dstAlph
       break;
     }
     const auto discard = alpha_compare_not(pass);
-    if (discard.constant == 1) {
+    const float cutout = config.edgeAA != 0 ? paper_cutout_threshold(config.alphaCompare) : -1.f;
+    if (cutout >= 0.f) {
+      // aurora/paper.h: the cut-out's edge one pixel wide instead of a step; as the samples covered (alpha to
+      // coverage, the draw not blending) or faded into the draw's alpha blend
+      fragmentFn += fmt::format(
+          "\n    // Alpha compare, smooth edge"
+          "\n    let edge_w = max(fwidth(prev.a), 1.0 / 255.0);"
+          "\n    let edge_cov = clamp((prev.a - {:.6f}) / edge_w + 0.5, 0.0, 1.0);"
+          "\n    if (edge_cov <= 0.0) {{ discard; }}",
+          cutout);
+      fragmentFn += config.edgeAA == 1 ? "\n    prev.a = edge_cov;" : "\n    prev.a = prev.a * edge_cov;";
+    } else if (discard.constant == 1) {
       fragmentFn += "\n    // Alpha compare\n    discard;";
     } else if (discard.constant != 0) {
       fragmentFn +=
@@ -1611,6 +1629,10 @@ std::string build_shader_source(const ShaderConfig& config, DstAlphaMode dstAlph
     fragmentFn += "\n    prev = vec4f(in.mv_nrm, prev.a);";
   }
 
+  if (config.shadowFill) {
+    // aurora/paper.h: the draw as its own shadow, dark and translucent, its shape from its alpha
+    fragmentFn += "\n    prev = vec4f(0.0, 0.0, 0.0, clamp(prev.a, 0.0, 1.0) * 0.45);";
+  }
   if (dstAlphaMode == DstAlphaMode::Replace) {
     // GX destination alpha is set via the blend constant
     fragmentFn += "\n    prev.a = 1.0;";
