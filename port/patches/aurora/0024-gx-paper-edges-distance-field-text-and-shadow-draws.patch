 lib/dolphin/gx/GXAurora.cpp  | 30 ++++++++++++++++++++++
 lib/gx/command_processor.cpp | 27 ++++++++++++++++++++
 lib/gx/gx.cpp                | 44 +++++++++++++++++++++++++++++++-
 lib/gx/gx.hpp                | 49 ++++++++++++++++++++++++++++++++++--
 lib/gx/shader.cpp            | 24 +++++++++++++++++-
