-      fragmentFn += "\n        fogBase *= bitcast<f32>(abuf[imm.fog_range_base + u32(in.pos.x)]);";
+      // (through load_word's bounds check, as every other storage read: the table is the target's width at
+      // the draw, and a pixel past it must not read past the buffer, #39)
+      fragmentFn += "\n        fogBase *= bitcast<f32>(load_word(&abuf, imm.fog_range_base + u32(in.pos.x)));";
     }
     fragmentFn += "\n    var fogF = clamp(fogBase - ubuf.fog.c, 0.0, 1.0);";
     switch (config.fogType) {
@@ -2096,6 +2098,24 @@ fn fs_main(in: VertexOutput) -> {10} {{{6}{5}{11}
 )""",
                   uniBufAttrs, texBindings, vtxOutAttrs, vtxInAttrs, vtxXfrAttrs, fragmentFn, fragmentFnPre,
                   vtxXfrAttrsPre, uniformPre, fragmentOutput, fragmentOutputType, fragmentReturn);
+  // A matrix by GX's index (a vertex's, a texgen's, the current one; gx.hpp's MaxPosTexMtx): an index past
+  // the matrices is the identity (a normal matrix: the last), and the load itself is clamped, so no compiler
+  // hoisting it past the branch reads past the array. With robustness off, a read past a uniform array is a
+  // read past its buffer, which resets an Adreno (#39).
+  shaderSource += fmt::format(R"""(
+fn gx_postex_mtx(idx: u32) -> mat3x4f {{
+  let m = ubuf.postex_mtx[min(idx, {0}u)];
+  if (idx > {0}u) {{
+    return mat3x4f(vec4f(1.0, 0.0, 0.0, 0.0), vec4f(0.0, 1.0, 0.0, 0.0), vec4f(0.0, 0.0, 1.0, 0.0));
+  }}
+  return m;
+}}
+
+fn gx_nrm_mtx(idx: u32) -> mat3x4f {{
+  return ubuf.nrm_mtx[min(idx, {1}u)];
+}}
+)""",
+                              MaxPosTexMtx - 1, MaxPnMtx - 1);
   if (dstAlphaMode == DstAlphaMode::DualSource) {
     shaderSource.insert(0, "enable dual_source_blending;\n");
   }
