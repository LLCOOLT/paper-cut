+               : qualcomm ? "a Qualcomm GPU"
+               : mobile   ? "a phone or tablet"
+               : on       ? "a debug build or $AURORA_VALIDATE"
+                          : "a computer's release build");
+    }
     std::vector<const char*> disableToggles{
         "timestamp_quantization",
         // Adreno strikes again!
