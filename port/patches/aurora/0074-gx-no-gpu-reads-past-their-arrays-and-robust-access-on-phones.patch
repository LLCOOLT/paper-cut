           "\n    out.tex{0}_uv = tc{2}_proj.xy + vec2f(dot(bump_ldir{0}, bump_tan{0}), dot(bump_ldir{0}, "
           "bump_bin{0}));",
           i, lightIdx, tcg.embossSrc);
@@ -1221,9 +1222,8 @@ std::string build_shader_source(const ShaderConfig& config, DstAlphaMode dstAlph
       vtxXfrAttrs += fmt::format("\n    var tc{} = vec4f({}, 1.0);", i, nbt_slice_local(NbtSlice::T));
     } else if (tcg.src == GX_MAX_TEXGENSRC) {
       // A TEV stage samples a texcoord at or beyond numTexGens: the hardware gives (0, 0), as Dolphin does.
-      static bool warned = false;
-      if (!warned) {
-        warned = true;
+      static std::atomic_bool warned = false; // (shaders build on several threads)
+      if (!warned.exchange(true, std::memory_order_relaxed)) {
         Log.warn("texcoord {} sampled but not generated (numTexGens too low): using (0, 0)", i);
       }
       vtxXfrAttrs += fmt::format("\n    var tc{} = vec4f(0.0, 0.0, 1.0, 1.0);", i);
@@ -1231,8 +1231,9 @@ std::string build_shader_source(const ShaderConfig& config, DstAlphaMode dstAlph
       UNLIKELY FATAL("unhandled tcg src {}", underlying(tcg.src));
     if (tcg.type == GX_TG_MTX2x4 || tcg.type == GX_TG_MTX3x4) {
       if (info.indexAttr.test(GX_VA_TEX0MTXIDX + i)) {
-        vtxXfrAttrs += fmt::format("\n    var tc{0}_tmp = tc{0} * ubuf.postex_mtx[in_texmtxidx{0} / 3u];", i);
-      } else if (tcg.mtx == GX_IDENTITY) {
+        vtxXfrAttrs += fmt::format("\n    var tc{0}_tmp = tc{0} * gx_postex_mtx((in_texmtxidx{0} & 63u) / 3u);", i);
+      } else if (tcg.mtx == GX_IDENTITY || tcg.mtx / 3u >= MaxPosTexMtx) {
+        // (and the rows past it, gx.hpp's MaxPosTexMtx)
         vtxXfrAttrs += fmt::format("\n    var tc{0}_tmp = tc{0}.xyz;", i);
       } else {
         u32 texMtxIdx = (tcg.mtx) / 3;
@@ -1247,10 +1248,9 @@ std::string build_shader_source(const ShaderConfig& config, DstAlphaMode dstAlph
     if (tcg.normalize) {
