From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LLCOOLT <114613597+LLCOOLT@users.noreply.github.com>
Date: Wed, 11 Nov 2026 12:00:00 -0500
Subject: [PATCH] gx: no shader reads past their arrays; robust buffer access on phones

#39: an AYN Thor (Adreno 740) reset the whole device at Rogueport's harbour.
Release builds turn Dawn's robustness off (disable_robustness), and some
shader reads had no bounds of their own; on an Adreno a read past a buffer
with robustness off can reset the GPU instead of giving a wrong value.

The matrices: a vertex's position matrix index (PNMTXIDX), its texture matrix
indices and the current matrix are GX's 6-bit row indices; divided by 3 they
reach 21 (85 from an unmasked byte) against the 20 matrices the uniform holds
(postex_mtx: 10 position, 10 texture) and the 10 normal matrices. Indices are
masked to 6 bits as GX's are, and read through gx_postex_mtx/gx_nrm_mtx: a
matrix past the arrays (GX_IDENTITY's rows 60-63) is the identity, a normal
matrix the last one, the load itself clamped. A texgen's constant matrix past
them is the identity too, and a post-transform matrix past the 20
(gx::pt_tex_mtx_index), where the shader info's bitset set() was out of range.
In-range indices draw exactly as before.

The range fog's table read (abuf at the pixel's x) goes through load_word's
bounds check as every other storage read. The palette conversion clamps its
source coordinate and gives zero for an index past the TLUT (what D3D's and
robust Vulkan's loads past a texture give), never loading past it.

Robust buffer access stays on for Qualcomm GPUs (vendor 0x5143 or an Adreno
name) and on every phone and tablet; $AURORA_ROBUST=1/0 says. The log says
which and why ("Robust buffer access: on (a Qualcomm GPU)").
---
diff --git a/lib/gfx/tex_palette_conv.cpp b/lib/gfx/tex_palette_conv.cpp
index 392dcc8..169a0a5 100644
--- a/lib/gfx/tex_palette_conv.cpp
+++ b/lib/gfx/tex_palette_conv.cpp
@@ -36,6 +36,15 @@ var<private> uvs: array<vec2f, 3> = array(
     return out;
 }
 
+// A TLUT entry, or zero for an index past the TLUT loaded (a CI8 texture drawn with a 16-entry palette): what
+// a load past a texture gives on D3D and robust Vulkan, never a read past it (#39: an Adreno with robustness
+// off resets). The load itself is clamped, so no compiler moving it past the check reads outside.
+fn tlut_load(i: i32) -> vec4f {
+    let n = i32(textureDimensions(tlut).x);
+    let c = textureLoad(tlut, vec2i(clamp(i, 0, n - 1), 0), 0);
+    return select(c, vec4f(0.0), i < 0 || i >= n);
+}
+
 fn intensity(rgb: vec3f) -> f32 {
     // ITU-R BT.601 luma coefficients
     return dot(rgb, vec3f(0.257, 0.504, 0.098)) + 16.0 / 255.0;
@@ -50,9 +59,9 @@ static constexpr std::string_view ShaderDirect = R"(
 
 @fragment fn fs_main(in: VertexOutput) -> @location(0) vec4f {
     let texSize = vec2f(textureDimensions(src));
-    let coord = vec2i(floor(in.uv * texSize));
+    let coord = clamp(vec2i(floor(in.uv * texSize)), vec2i(0), vec2i(textureDimensions(src)) - vec2i(1));
     let idx = textureLoad(src, coord, 0).r;
-    return textureLoad(tlut, vec2i(idx, 0), 0);
+    return tlut_load(idx);
 }
 )"sv;
 
@@ -64,9 +73,9 @@ static constexpr std::string_view ShaderFromFloat8 = R"(
 
 @fragment fn fs_main(in: VertexOutput) -> @location(0) vec4f {
     let texSize = vec2f(textureDimensions(src));
-    let coord = vec2i(floor(in.uv * texSize));
+    let coord = clamp(vec2i(floor(in.uv * texSize)), vec2i(0), vec2i(textureDimensions(src)) - vec2i(1));
     let r = textureLoad(src, coord, 0).r;
-    return textureLoad(tlut, vec2i(i32(r * 255.0), 0), 0);
+    return tlut_load(i32(r * 255.0));
 }
 )"sv;
 
@@ -78,9 +87,9 @@ static constexpr std::string_view ShaderFromFloat4 = R"(
 
 @fragment fn fs_main(in: VertexOutput) -> @location(0) vec4f {
     let texSize = vec2f(textureDimensions(src));
-    let coord = vec2i(floor(in.uv * texSize));
+    let coord = clamp(vec2i(floor(in.uv * texSize)), vec2i(0), vec2i(textureDimensions(src)) - vec2i(1));
     let r = textureLoad(src, coord, 0).r;
-    return textureLoad(tlut, vec2i(i32(r * 15.0), 0), 0);
+    return tlut_load(i32(r * 15.0));
 }
 )"sv;
 
diff --git a/lib/gx/gx.hpp b/lib/gx/gx.hpp
index d72d634..6897a9f 100644
--- a/lib/gx/gx.hpp
+++ b/lib/gx/gx.hpp
@@ -64,6 +64,21 @@ constexpr u32 MaxIndStages = GX_MAX_INDTEXSTAGE;
 constexpr u32 MaxIndTexMtxs = 3;
 constexpr u32 MaxVtxFmt = GX_MAX_VTXFMT;
 constexpr u32 MaxPnMtx = (GX_PNMTX9 / 3) + 1;
+// The shaders' matrices: MaxPnMtx position matrices (rows 0-29 of GX's matrix memory, 3 a matrix) and the
+// MaxTexMtx texture ones after them (rows 30-59). GX's 6-bit matrix indices (a vertex's, a texgen's, the
+// current one) can name rows 60-63 too: GX_IDENTITY (60), which the shaders give as the identity, and the
+// rest of it. Those are read as the identity as well, never past the array (an out-of-bounds GPU read: on
+// an Adreno with robustness off, a device reset, #39).
+constexpr u32 MaxPosTexMtx = MaxPnMtx + MaxTexMtx;
+// A texgen's post-transform matrix (GX_PTTEXMTX0 + 3n, a 6-bit row index past 64) as its n in ptTexMtxs, or
+// UINT32_MAX for the identity: GX_PTIDENTITY, and the rows the index can name past the last matrix
+constexpr u32 pt_tex_mtx_index(u32 postMtx) noexcept {
+  if (postMtx < GX_PTTEXMTX0 || postMtx == GX_PTIDENTITY) {
+    return UINT32_MAX;
+  }
+  const u32 idx = (postMtx - GX_PTTEXMTX0) / 3;
+  return idx < MaxPTTexMtx ? idx : UINT32_MAX;
+}
 constexpr u32 MaxIndexAttr = 12; // VA_POS -> VA_TEX7
 constexpr u32 MaxUniformSize = 3840;
 constexpr u32 XfRegCount = 0x58; // 0x1000-0x1057
