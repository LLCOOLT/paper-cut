From 2601bf8eb0b880659ecb6bad57d3eb3daa1f596d Mon Sep 17 00:00:00 2001
From: LLCOOLT <114613597+LLCOOLT@users.noreply.github.com>
Date: Sun, 8 Nov 2026 04:43:54 -0500
Subject: [PATCH] gfx: a full frame buffer leaves the draw out, never an abort

The frame's vertex, index, uniform and storage buffers are fixed-size
mapped staging ranges, and a ByteBuffer over them aborted when a push
went past them; lowMemoryGfx makes them smaller still (a crowded map on a
2 GB handheld). Now a GX draw checks first that its vertices, indices,
indexed arrays and uniforms fit (worst cases) and is left out when they
don't, before anything of it is pushed, so a merge never sees half of
it; any other push that doesn't fit gives an empty range and drops the
draw it was for. A warning once a buffer. The uniforms keep
MaxUniformSize free for finish's tail.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/aurora/aurora.h      |  3 +-
 lib/gfx/recording.cpp        | 73 +++++++++++++++++++++++++++++++++---
 lib/gfx/recording.hpp        |  4 ++
 lib/gx/command_processor.cpp | 25 +++++++++++-
 lib/internal.hpp             |  4 ++
 5 files changed, 101 insertions(+), 8 deletions(-)

diff --git a/include/aurora/aurora.h b/include/aurora/aurora.h
index ea4e1d4..7a97618 100644
--- a/include/aurora/aurora.h
+++ b/include/aurora/aurora.h
@@ -119,7 +119,8 @@ typedef struct {
 
   /*
    * Smaller graphics buffers (about 210 MiB rather than 714 MiB of staging and frame buffers), for devices with
-   * 1-2 GB of memory shared by the CPU and GPU. A frame with more geometry than they hold aborts.
+   * 1-2 GB of memory shared by the CPU and GPU. A frame with more geometry than they hold leaves
+   * the draws that do not fit out (a warning once a buffer), as a full frame does at any size.
    */
   bool lowMemoryGfx;
 
diff --git a/lib/gfx/recording.cpp b/lib/gfx/recording.cpp
index 190a1f5..c717938 100644
--- a/lib/gfx/recording.cpp
+++ b/lib/gfx/recording.cpp
@@ -283,7 +283,32 @@ void seal_pass(FramePacket& frame, uint32_t passIndex) {
   pass.sealed = true;
 }
 
-Range push(ByteBuffer& target, const uint8_t* data, size_t length, size_t alignment) {
+// The frame's buffers are fixed-size mapped staging ranges (a ByteBuffer over them aborts when it would grow
+// past them). What doesn't fit is left out instead: a warning once a buffer, an empty range, and the draw it
+// was for dropped (push_draw_command). The uniforms keep MaxUniformSize free for finish's tail.
+bool g_pushFull = false;
+uint32_t g_fullWarned = 0;
+
+size_t push_needs(const ByteBuffer& target, size_t length, size_t alignment) noexcept {
+  const size_t begin = target.size();
+  return (alignment != 0 ? AURORA_ALIGN(begin, alignment) - begin : 0) + length;
+}
+
+void warn_full(uint32_t bit, const char* what, size_t want, size_t room) {
+  if ((g_fullWarned & bit) == 0) {
+    g_fullWarned |= bit;
+    Log.warn("Frame {} buffer full ({} bytes wanted, {} free): draws left out of such frames", what, want, room);
+  }
+}
+
+Range push(ByteBuffer& target, const uint8_t* data, size_t length, size_t alignment, uint32_t bit, const char* what,
+           size_t reserve = 0) {
+  const size_t want = push_needs(target, length, alignment) + reserve;
+  if (!target.fits(want)) {
+    warn_full(bit, what, want, target.room());
+    g_pushFull = true;
+    return {};
+  }
   if (alignment != 0) {
     const size_t begin = target.size();
     const size_t alignedBegin = AURORA_ALIGN(begin, alignment);
@@ -376,6 +401,10 @@ DrawCommand make_draw_command(const T& data) {
 }
 
 void push_draw_command(DrawCommand data) {
+  if (g_pushFull) {
+    g_pushFull = false; // (its data didn't fit: push)
+    return;
+  }
   push_command(CommandType::Draw, Command::Data{.draw = data});
   ++g_recorder.drawCallCount;
 }
@@ -1220,9 +1249,12 @@ void finish() {
     return;
   }
   AURORA_ASSERT(!g_recorder.inOffscreen, "finish called while offscreen rendering is active");
+  g_pushFull = false;
   if (g_recorder.currentRenderPass != UINT32_MAX) {
     auto& frame = current_frame_packet();
-    frame.uniforms.append_zeroes(gx::MaxUniformSize);
+    if (frame.uniforms.fits(gx::MaxUniformSize)) { // (kept free by push: always, unless the frame began full)
+      frame.uniforms.append_zeroes(gx::MaxUniformSize);
+    }
     enqueue_pass(frame, g_recorder.currentRenderPass);
     g_recorder.currentRenderPass = UINT32_MAX;
   }
@@ -1233,7 +1265,7 @@ Range push_verts(const uint8_t* data, size_t length, size_t alignment) {
   if (!check_recording("push_verts")) {
     return {};
   }
-  return push(current_frame_packet().verts, data, length, alignment);
+  return push(current_frame_packet().verts, data, length, alignment, 1, "vertex");
 }
 
 Range push_indices(const uint8_t* data, size_t length, size_t alignment) {
@@ -1241,7 +1273,7 @@ Range push_indices(const uint8_t* data, size_t length, size_t alignment) {
   if (!check_recording("push_indices")) {
     return {};
   }
-  return push(current_frame_packet().indices, data, length, alignment);
+  return push(current_frame_packet().indices, data, length, alignment, 2, "index");
 }
 
 Range push_uniform(const uint8_t* data, size_t length) {
@@ -1249,7 +1281,8 @@ Range push_uniform(const uint8_t* data, size_t length) {
   if (!check_recording("push_uniform")) {
     return {};
   }
-  return push(current_frame_packet().uniforms, data, length, resources().limits.minUniformBufferOffsetAlignment);
+  return push(current_frame_packet().uniforms, data, length, resources().limits.minUniformBufferOffsetAlignment, 4,
+              "uniform", gx::MaxUniformSize);
 }
 
 Range push_storage(const uint8_t* data, size_t length) {
@@ -1257,7 +1290,35 @@ Range push_storage(const uint8_t* data, size_t length) {
   if (!check_recording("push_storage")) {
     return {};
   }
-  return push(current_frame_packet().storage, data, length, resources().limits.minStorageBufferOffsetAlignment);
+  return push(current_frame_packet().storage, data, length, resources().limits.minStorageBufferOffsetAlignment, 8,
+              "storage");
+}
+
+bool frame_has_room(size_t verts, size_t indices, size_t storage, size_t uniforms) noexcept {
+  if (!g_recorder.active()) {
+    return true; // (the pushes warn and do nothing)
+  }
+  auto& frame = current_frame_packet();
+  const auto& limits = resources().limits;
+  const struct {
+    const ByteBuffer& buf;
+    size_t want;
+    uint32_t bit;
+    const char* what;
+  } wants[] = {
+      {frame.verts, push_needs(frame.verts, verts, 4), 1, "vertex"},
+      {frame.indices, push_needs(frame.indices, indices, 4), 2, "index"},
+      {frame.storage, push_needs(frame.storage, storage, limits.minStorageBufferOffsetAlignment), 8, "storage"},
+      {frame.uniforms, push_needs(frame.uniforms, uniforms, limits.minUniformBufferOffsetAlignment) + gx::MaxUniformSize,
+       4, "uniform"},
+  };
+  for (const auto& w : wants) {
+    if (!w.buf.fits(w.want)) {
+      warn_full(w.bit, w.what, w.want, w.buf.room());
+      return false;
+    }
+  }
+  return true;
 }
 
 Range push_texture_data(const uint8_t* data, u32 bytesPerRow, u32 rowsPerImage) {
diff --git a/lib/gfx/recording.hpp b/lib/gfx/recording.hpp
index b36d729..6ce34e2 100644
--- a/lib/gfx/recording.hpp
+++ b/lib/gfx/recording.hpp
@@ -100,6 +100,10 @@ Range push_storage(const T& data) {
   return push_storage(reinterpret_cast<const uint8_t*>(&data), sizeof(T));
 }
 Range push_texture_data(const uint8_t* data, uint32_t bytesPerRow, uint32_t rowsPerImage);
+// Whether the frame's buffers still hold a draw of this many bytes of vertices, indices, storage and uniforms
+// (worst cases, alignment included). When one doesn't, the draw is left out of the frame (a warning, once a
+// buffer), never an abort: the buffers are a fixed size, smaller still with AuroraConfig.lowMemoryGfx.
+bool frame_has_room(size_t verts, size_t indices, size_t storage, size_t uniforms) noexcept;
 
 template <typename DrawData>
 void push_draw_command(DrawData data);
diff --git a/lib/gx/command_processor.cpp b/lib/gx/command_processor.cpp
index 19dc47f..e69cbd3 100644
--- a/lib/gx/command_processor.cpp
+++ b/lib/gx/command_processor.cpp
@@ -519,6 +519,20 @@ void bbox_add_vertices(const u8* data, u32 vtxCount, u32 vtxSize, GXVtxFmt fmt)
   }
 }
 
+// Whether the frame's buffers hold a draw of vertBytes of vertices and idxBytes of indices, with the indexed arrays
+// it still has to upload and its uniforms (worst cases): when not, the draw is left out (gfx::frame_has_room)
+// before anything of it is pushed, so a merge with the last draw never sees half of it
+static bool draw_fits(size_t vertBytes, size_t idxBytes) noexcept {
+  const auto& state = g_gxState;
+  size_t storage = 0;
+  for (int i = GX_VA_POS; i <= GX_VA_TEX7; ++i) {
+    if ((state.vtxDesc[i] == GX_INDEX8 || state.vtxDesc[i] == GX_INDEX16) && state.arrays[i].cachedRange.size == 0) {
+      storage += state.arrays[i].size + 256;
+    }
+  }
+  return gfx::frame_has_room(vertBytes + 4, idxBytes + 8, storage, 2 * MaxUniformSize + 512);
+}
+
 static void push_gx_draw(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, gfx::Range vertRange, gfx::Range idxRange,
                          u32 numIndices) noexcept {
   auto& state = g_gxState;
@@ -650,6 +664,12 @@ static void draw_prim(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, ByteReader&
   const auto vertexData = reader.take(totalVtxBytes);
   if (sBbox.armed)
     UNLIKELY { bbox_add_vertices(vertexData.data(), vtxCount, vtxSize, fmt); }
+  // (indices, at most: one a vertex for triangles, two for quads, three for strips and fans, six for lines and
+  // points (quads); a merge into an unindexed draw also indexes the last draw's vertices, one each)
+  const size_t perVtx = prim == GX_TRIANGLES ? 1 : prim == GX_QUADS ? 2 : prim == GX_TRIANGLESTRIP || prim == GX_TRIANGLEFAN ? 3 : 6;
+  const size_t lastIdx = canMerge && lastDraw->indexCount == 0 && prim != GX_TRIANGLES ? lastDraw->vtxCount : 0;
+  if (!draw_fits(vertexData.size(), (static_cast<size_t>(vtxCount) * perVtx + lastIdx) * sizeof(u16)))
+    UNLIKELY { return; }
   gfx::Range vertRange = gfx::push_verts(vertexData.data(), vertexData.size(), canMerge ? 0 : 4);
 
   // Try to merge with previous draw call
@@ -939,7 +959,6 @@ void handle_aurora(ByteReader& reader) noexcept {
     const size_t idxBytes = static_cast<size_t>(indexCount) * sizeof(u16);
     // Index data is always host-endian; push it to the GPU buffer as-is
     const auto indexData = reader.take(idxBytes);
-    const gfx::Range idxRange = gfx::push_indices(indexData.data(), indexData.size(), 4);
     u32 vtxSize;
     if (g_gxState.lastVtxFmt == fmt) {
       vtxSize = g_gxState.lastVtxSize;
@@ -948,6 +967,10 @@ void handle_aurora(ByteReader& reader) noexcept {
     }
     const u32 totalVtxBytes = vtxCount * vtxSize;
     const auto vertexData = reader.take(totalVtxBytes);
+    if (!draw_fits(totalVtxBytes, idxBytes)) {
+      return; // (the frame's buffers are full: left out)
+    }
+    const gfx::Range idxRange = gfx::push_indices(indexData.data(), indexData.size(), 4);
     if (sBbox.armed && indexCount != 0) {
       bbox_add_vertices(vertexData.data(), vtxCount, vtxSize, fmt);
     }
diff --git a/lib/internal.hpp b/lib/internal.hpp
index d1adb6c..18e7949 100644
--- a/lib/internal.hpp
+++ b/lib/internal.hpp
@@ -284,6 +284,10 @@ public:
   [[nodiscard]] const uint8_t* data() const noexcept { return m_data; }
   [[nodiscard]] size_t size() const noexcept { return m_length; }
   [[nodiscard]] bool empty() const noexcept { return m_length == 0; }
+  // Whether size more bytes fit: always for a buffer of its own (it grows); for one over memory it was given (a
+  // frame's mapped staging range) only within that memory, where a resize past it aborts
+  [[nodiscard]] bool fits(size_t size) const noexcept { return m_owned || m_length + size <= m_capacity; }
+  [[nodiscard]] size_t room() const noexcept { return m_owned ? std::numeric_limits<size_t>::max() : m_capacity - m_length; }
 
   void append(const void* data, size_t size) {
     resize(m_length + size, false);
