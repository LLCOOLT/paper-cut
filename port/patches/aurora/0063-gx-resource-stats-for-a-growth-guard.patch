+  g_lastOffscreenEntries.store(static_cast<uint32_t>(g_offscreenCache.cached_count()), std::memory_order_relaxed);
   TracyPlot("aurora: offscreenCacheBytes", static_cast<int64_t>(g_offscreenCache.cached_bytes()));
   TracyPlot("aurora: offscreenCacheEntries", static_cast<int64_t>(g_offscreenCache.cached_count()));
   return recorded;
 }
 
+void fill_frame_resource_stats(AuroraResourceStats& out) noexcept {
+  out.frame = g_framesRecorded.load(std::memory_order_relaxed);
+  out.renderPasses = g_lastRenderPasses.load(std::memory_order_relaxed);
+  out.textureCopies = g_lastTextureCopies.load(std::memory_order_relaxed);
+  out.readbacks = g_lastReadbacks.load(std::memory_order_relaxed);
+  out.textureUploads = g_lastTextureUploads.load(std::memory_order_relaxed);
+  out.overflowUploads = g_lastOverflowUploads.load(std::memory_order_relaxed);
+  out.offscreenEntries = g_lastOffscreenEntries.load(std::memory_order_relaxed);
+  out.passSnapshots = g_lastPassSnapshots.load(std::memory_order_relaxed);
+  const auto live = texture_live_totals();
+  out.textures = static_cast<uint32_t>(std::min<uint64_t>(live.count, UINT32_MAX));
+  out.textureBytes = live.bytes;
+}
