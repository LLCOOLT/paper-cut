+/**
+ * What Aurora holds, for a guard against resources that grow without end (Paper Cut #39). The per-frame counts are
+ * the last frame recorded's; the rest is alive now. textureBytes is an estimate (texels by format, with mips).
+ */
+typedef struct AuroraResourceStats {
+  u64 frame;           // frames recorded so far
+  u32 renderPasses;    // in the last frame: render passes
+  u32 textureCopies;   // texture-to-texture copies
+  u32 readbacks;       // readback tasks
+  u32 textureUploads;  // texture uploads
+  u32 overflowUploads; // texture uploads too big for the staging buffer (a buffer of their own)
+  u32 textures;        // alive: GX textures, EFB copies, conversions, replacements
+  u64 textureBytes;
+  u32 bindGroups;      // cached bind groups
+  u32 samplers;        // cached samplers
+  u32 textureObjects;  // GX texture objects with a texture cached
+  u32 contentEntries;  // the texture content cache
+  u64 contentBytes;
+  u32 copyEntries;     // the EFB copy cache
+  u64 copyBytes;
+  u64 copyPinnedBytes; // of those, the current copies (held)
+  u32 offscreenEntries; // offscreen pass targets cached
+  u32 passSnapshots;    // resolve_pass snapshot targets pooled
+} AuroraResourceStats;
+void AuroraGetResourceStats(AuroraResourceStats* out);
+
 /**
  * Flush pending GX state and wait for FIFO processing without signaling a draw-done callback.
  */
