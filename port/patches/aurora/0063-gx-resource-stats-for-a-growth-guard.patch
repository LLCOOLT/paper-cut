+// AuroraGetResourceStats (any thread): the caches as each frame ended
+std::atomic<uint32_t> s_lastObjectEntries{0};
+std::atomic<uint32_t> s_lastContentEntries{0};
+std::atomic<uint64_t> s_lastContentBytes{0};
+std::atomic<uint32_t> s_lastCopyEntries{0};
+std::atomic<uint64_t> s_lastCopyBytes{0};
+std::atomic<uint64_t> s_lastCopyPinnedBytes{0};
+
+void publish_cache_stats() {
+  s_lastObjectEntries.store(static_cast<uint32_t>(s_textureObjectCaches.size()), std::memory_order_relaxed);
+  s_lastContentEntries.store(static_cast<uint32_t>(s_contentCache.cached_count()), std::memory_order_relaxed);
+  s_lastContentBytes.store(s_contentCache.cached_bytes(), std::memory_order_relaxed);
+  s_lastCopyEntries.store(static_cast<uint32_t>(s_copyCache.cached_count()), std::memory_order_relaxed);
+  s_lastCopyBytes.store(s_copyCache.cached_bytes(), std::memory_order_relaxed);
+  s_lastCopyPinnedBytes.store(s_copyCache.pinned_bytes(), std::memory_order_relaxed);
+}
+
 void retire_copy_texture(const GXState::CopyTextureRef& copy) {
   for (auto& [_, cache] : s_tlutObjectCaches) {
     absl::erase_if(cache.dynamicPaletteTextures,
@@ -860,6 +878,16 @@ void end_frame() noexcept {
   s_copyCache.end_frame();
   s_contentCache.end_frame();
   update_cache_stats();
+  publish_cache_stats();
+}
+
+void fill_resource_stats(AuroraResourceStats& out) noexcept {
+  out.textureObjects = s_lastObjectEntries.load(std::memory_order_relaxed);
+  out.contentEntries = s_lastContentEntries.load(std::memory_order_relaxed);
+  out.contentBytes = s_lastContentBytes.load(std::memory_order_relaxed);
+  out.copyEntries = s_lastCopyEntries.load(std::memory_order_relaxed);
+  out.copyBytes = s_lastCopyBytes.load(std::memory_order_relaxed);
+  out.copyPinnedBytes = s_lastCopyPinnedBytes.load(std::memory_order_relaxed);
 }
 
 void shutdown() noexcept {
