diff --git a/lib/gfx/texture.cpp b/lib/gfx/texture.cpp
index ef30e55..847866d 100644
--- a/lib/gfx/texture.cpp
+++ b/lib/gfx/texture.cpp
@@ -9,6 +9,7 @@
 #include "../gx/gx_fmt.hpp"
 
 #include <algorithm>
+#include <atomic>
 #include <cstdint>
 #include <memory>
 #include <utility>
@@ -24,6 +25,63 @@ using webgpu::g_queue;
 static u16 s_forcedAnisotropy = 1; // AuroraSetTextureAnisotropy
 static float s_lodBias = 0.f;      // AuroraSetTextureLodBias
 
+static std::atomic<int64_t> s_liveTextures{0};
+static std::atomic<int64_t> s_liveTextureBytes{0};
+
+void count_texture(int64_t sign, uint64_t bytes) noexcept {
+  s_liveTextures.fetch_add(sign, std::memory_order_relaxed);
+  s_liveTextureBytes.fetch_add(sign * static_cast<int64_t>(bytes), std::memory_order_relaxed);
+}
+
+TextureLiveTotals texture_live_totals() noexcept {
+  const int64_t count = s_liveTextures.load(std::memory_order_relaxed);
+  const int64_t bytes = s_liveTextureBytes.load(std::memory_order_relaxed);
+  return {.count = count > 0 ? static_cast<uint64_t>(count) : 0, .bytes = bytes > 0 ? static_cast<uint64_t>(bytes) : 0};
+}
+
+// Texels by format (never format_info, which stops on a format it doesn't know: HDR's, depth's), with every mip
+uint64_t estimate_texture_bytes(wgpu::TextureFormat format, wgpu::Extent3D size, uint32_t mips) noexcept {
+  uint64_t num = 4, den = 1; // bytes per texel, as a fraction (compressed formats: under one)
+  switch (format) {
+  case wgpu::TextureFormat::R8Unorm:
+    num = 1;
+    break;
+  case wgpu::TextureFormat::RG8Unorm:
+  case wgpu::TextureFormat::R16Sint:
+  case wgpu::TextureFormat::R16Float:
+    num = 2;
+    break;
+  case wgpu::TextureFormat::RGBA16Float:
+  case wgpu::TextureFormat::RG32Float:
+    num = 8;
+    break;
+  case wgpu::TextureFormat::RGBA32Float:
+    num = 16;
+    break;
+  case wgpu::TextureFormat::BC1RGBAUnorm:
+    num = 1;
+    den = 2;
+    break;
+  case wgpu::TextureFormat::BC3RGBAUnorm:
+  case wgpu::TextureFormat::BC5RGUnorm:
+  case wgpu::TextureFormat::BC7RGBAUnorm:
+  case wgpu::TextureFormat::ASTC4x4Unorm:
+  case wgpu::TextureFormat::ASTC4x4UnormSrgb:
+    num = 1;
+    break;
+  default:
+    break;
+  }
+  uint64_t total = 0;
+  const uint32_t layers = std::max(size.depthOrArrayLayers, 1u);
+  for (uint32_t mip = 0; mip < std::max(mips, 1u); ++mip) {
+    const uint64_t w = std::max(size.width >> mip, 1u);
+    const uint64_t h = std::max(size.height >> mip, 1u);
+    total += w * h * layers * num / den;
+  }
+  return total;
+}
+
 void set_texture_anisotropy(u8 maxAniso) noexcept { s_forcedAnisotropy = std::clamp<u16>(maxAniso, 1, 16); }
 void set_texture_lod_bias(float bias) noexcept { s_lodBias = bias; }
 float texture_lod_bias() noexcept { return s_lodBias; }
diff --git a/lib/gfx/texture.hpp b/lib/gfx/texture.hpp
index 6a00d11..97bcd15 100644
--- a/lib/gfx/texture.hpp
+++ b/lib/gfx/texture.hpp
@@ -33,6 +33,29 @@ uint64_t calc_texture_size(wgpu::TextureFormat format, uint32_t width, uint32_t
 bool is_block_aligned(wgpu::TextureFormat format, uint32_t width, uint32_t height) noexcept;
 
 constexpr u32 InvalidTextureFormat = -1;
+
+// TextureRefs alive and their estimated bytes (AuroraGetResourceStats): a member of each, counted as it is made,
+// copied and let go
+void count_texture(int64_t sign, uint64_t bytes) noexcept;
+uint64_t estimate_texture_bytes(wgpu::TextureFormat format, wgpu::Extent3D size, uint32_t mips) noexcept;
+struct TextureLiveCount {
+  uint64_t bytes;
+  explicit TextureLiveCount(uint64_t bytes) noexcept : bytes(bytes) { count_texture(1, bytes); }
+  TextureLiveCount(const TextureLiveCount& other) noexcept : bytes(other.bytes) { count_texture(1, bytes); }
+  TextureLiveCount& operator=(const TextureLiveCount& other) noexcept {
+    count_texture(1, other.bytes);
+    count_texture(-1, bytes);
+    bytes = other.bytes;
+    return *this;
+  }
+  ~TextureLiveCount() { count_texture(-1, bytes); }
+};
+struct TextureLiveTotals {
+  uint64_t count;
+  uint64_t bytes;
+};
+TextureLiveTotals texture_live_totals() noexcept;
+
 struct TextureRef {
   wgpu::Texture texture;
   wgpu::TextureView sampleTextureView;
@@ -43,6 +66,7 @@ struct TextureRef {
   u32 gxFormat;
