                                          bool wantNormal) {
   auto& pool = g_passSnapshotPools[g_recorder.frameSlot];
@@ -611,6 +627,7 @@ void begin_recording(FramePacket& packet, size_t frameSlot) {
   g_recorder.frameSlot = frameSlot;
   g_pushFull = false; // (a push after finish, an overlay's, never drops this frame's first draw)
   g_passSnapshotPools[frameSlot].used = 0;
+  g_overflowUploads = 0;
   g_recorder.drawCallCount = 0;
   g_recorder.mergedDrawCallCount = 0;
   g_recorder.suspendedEfbPass.reset();
@@ -641,6 +658,19 @@ RecordedFrame end_recording() {
   frame.stats.lastIndexSize = frame.indices.size();
   frame.stats.lastStorageSize = frame.storage.size();
   frame.stats.lastTextureUploadSize = frame.textureUpload.size();
+  g_lastRenderPasses.store(static_cast<uint32_t>(frame.renderPasses.size()), std::memory_order_relaxed);
+  g_lastTextureCopies.store(static_cast<uint32_t>(frame.textureCopies.size()), std::memory_order_relaxed);
+  g_lastReadbacks.store(static_cast<uint32_t>(frame.readbackTasks.size()), std::memory_order_relaxed);
+  g_lastTextureUploads.store(static_cast<uint32_t>(frame.textureUploads.size()), std::memory_order_relaxed);
+  g_lastOverflowUploads.store(g_overflowUploads, std::memory_order_relaxed);
+  {
+    size_t snapshots = 0;
+    for (const auto& pool : g_passSnapshotPools) {
+      snapshots += pool.entries.size();
+    }
+    g_lastPassSnapshots.store(static_cast<uint32_t>(snapshots), std::memory_order_relaxed);
