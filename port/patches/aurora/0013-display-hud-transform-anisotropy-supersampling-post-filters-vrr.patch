@@ -179,13 +186,70 @@ fn sample_area(frag_position: vec4<f32>) -> vec4<f32> {
 
 // END AREA SAMPLER REGION
 
+// Post filters (aurora_set_post_filter), in the presented picture's pixels
+
+fn hash12(p: vec2<f32>) -> f32 {
+    var p3 = fract(vec3<f32>(p.xyx) * 0.1031);
+    p3 += dot(p3, p3.yzx + 33.33);
+    return fract((p3.x + p3.y) * p3.z);
+}
+
+fn value_noise(p: vec2<f32>) -> f32 {
+    let i = floor(p);
+    let f = fract(p);
+    let u = f * f * (3.0 - 2.0 * f);
+    return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), u.x),
+               mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), u.x), u.y);
+}
+
+// CRT: the game's 480 lines as scanlines, an aperture-grille mask, a soft vignette
+fn post_crt(color: vec3<f32>, uv: vec2<f32>, frag: vec2<f32>) -> vec3<f32> {
+    let line = uv.y * 480.0;
+    let scan = 0.72 + 0.28 * pow(abs(cos(line * 3.14159265)), 1.6);
+    let lineScale = uniforms.frame_height / 480.0;
+    var mask = vec3<f32>(1.0);
+    if (lineScale >= 2.0) {
+        let m = u32(frag.x) % 3u;
+        mask = select(select(vec3(0.9, 0.9, 1.08), vec3(0.9, 1.08, 0.9), m == 1u), vec3(1.08, 0.9, 0.9), m == 0u);
+    }
+    let d = uv - vec2(0.5);
+    let vignette = clamp(1.0 - dot(d, d) * 0.9, 0.0, 1.0);
+    return color * select(1.0, scan, lineScale >= 1.5) * mask * vignette * 1.12;
+}
+
+// Paper grain: still fibres and speckle over the picture, a little warmer
+fn post_paper(color: vec3<f32>, frag: vec2<f32>) -> vec3<f32> {
+    let scale = max(uniforms.frame_height / 480.0, 1.0);
+    let p = frag / scale;
+    let fibres = value_noise(p * vec2(0.08, 0.5)) * 0.5 + value_noise(p * vec2(0.5, 0.06)) * 0.5;
+    let speckle = hash12(floor(p * 1.5));
+    let grain = 0.93 + 0.05 * fibres + 0.03 * speckle;
+    return color * grain * vec3(1.02, 1.0, 0.95);
+}
+
+// Sharpen: an unsharp mask from the four neighbours
+fn post_sharpen(color: vec3<f32>, uv: vec2<f32>) -> vec3<f32> {
+    let px = vec2(1.0 / max(uniforms.frame_width, 1.0), 1.0 / max(uniforms.frame_height, 1.0));
+    let n = textureSample(t, s, uv + vec2(0.0, -px.y)).rgb + textureSample(t, s, uv + vec2(0.0, px.y)).rgb +
+            textureSample(t, s, uv + vec2(-px.x, 0.0)).rgb + textureSample(t, s, uv + vec2(px.x, 0.0)).rgb;
+    return clamp(color + (color - n * 0.25) * 0.6, vec3(0.0), vec3(1.0));
+}
+
