-    return vec4(color.rgb, 1.0);
+    var rgb = color.rgb;
+    if (uniforms.post_mode == 1u) {
+        rgb = post_crt(rgb, in.uv, in.position.xy);
+    } else if (uniforms.post_mode == 2u) {
+        rgb = post_paper(rgb, in.position.xy);
+    } else if (uniforms.post_mode == 3u) {
+        rgb = post_sharpen(rgb, in.uv);
+    }
+    return vec4(rgb, 1.0);
 }
