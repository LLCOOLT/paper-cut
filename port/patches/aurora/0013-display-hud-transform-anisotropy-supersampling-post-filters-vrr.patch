+    // GXSetProjectionTransform: the box moved as the draws are, in the viewport's NDC (the x offset after
+    // GXSetProjectionScaleX, as in fill_uniform), and kept at least as large as it was: smaller draws stay
+    // inside it, larger ones are not cut (a full-screen box stays full-screen)
+    const auto& vp = g_gxState.renderViewport;
+    if (vp.width > 0.f && vp.height > 0.f) {
+      const float ox = t[2] * g_gxState.projScaleX;
+      const auto mapX = [&](float x) {
+        const float ndc = (x - vp.left) / vp.width * 2.f - 1.f;
+        return vp.left + (ndc * t[0] + ox + 1.f) * 0.5f * vp.width;
+      };
+      const auto mapY = [&](float y) {
+        const float ndc = 1.f - (y - vp.top) / vp.height * 2.f;
+        return vp.top + (1.f - (ndc * t[1] + t[3])) * 0.5f * vp.height;
+      };
+      const float l = mapX(left), r = mapX(right), tp = mapY(top), b = mapY(bottom);
+      left = std::min({left, l, r});
+      right = std::max({right, l, r});
+      top = std::min({top, tp, b});
+      bottom = std::max({bottom, tp, b});
