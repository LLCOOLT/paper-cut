diff --git a/lib/webgpu/copy_present.cpp b/lib/webgpu/copy_present.cpp
new file mode 100644
index 0000000..9f9605f
--- /dev/null
+++ b/lib/webgpu/copy_present.cpp
@@ -0,0 +1,265 @@
+// Copy present: the frame read back from the GPU and shown through an SDL renderer, for screens Dawn has no
+// surface for. Linux handhelds (PortMaster: Knulli, muOS, ROCKNIX, the makers' own firmwares) often run without X11
+// or Wayland, SDL3 drawing straight to the screen with KMSDRM (GBM and EGL), and Dawn's OpenGL ES backend can only
+// present to X11, Wayland or Android windows. There, Dawn renders into a texture on SDL's own EGL display, the
+// texture is copied into one of two buffers each frame, and the buffer from the frame before is mapped and drawn
+// with SDL's OpenGL ES renderer (one frame later, so the GPU never waits for the copy), which flips it to the screen.
+//
+// Chosen for the OpenGL ES backend on Linux when SDL's video driver is kmsdrm (or AURORA_PRESENT=copy; =surface
+// turns it off). Everything here runs on the thread that ends frames (the render worker), the SDL renderer included:
+// the main thread lets go of its GL context after making it.
+#include "copy_present.hpp"
+
+#include "gpu.hpp"
+#include "../internal.hpp"
+#include "../window.hpp"
+
+#include <array>
+#include <cstring>
+
+#include <SDL3/SDL.h>
+#if defined(AURORA_COPY_PRESENT) && defined(WEBGPU_DAWN)
+#include <dawn/native/OpenGLBackend.h>
+#endif
+
+namespace aurora::webgpu {
+namespace {
+Module Log("aurora::webgpu::copy_present");
+
+#ifdef AURORA_COPY_PRESENT
+bool g_active = false;
+SDL_Renderer* g_renderer = nullptr;
+SDL_Texture* g_sdlTexture = nullptr;
+wgpu::Texture g_target;
+uint32_t g_width = 0;
+uint32_t g_height = 0;
+uint32_t g_bytesPerRow = 0;
+int g_rendererVsync = -1;
+
+struct Readback {
+  wgpu::Buffer buffer;
+  bool copied = false; // a frame's copy is in it, not yet shown
+};
+std::array<Readback, 2> g_readbacks;
+size_t g_next = 0;
+
+bool env_is(const char* name, const char* value) {
+  const char* env = SDL_getenv(name);
+  return env != nullptr && SDL_strcasecmp(env, value) == 0;
+}
+#endif
+} // namespace
+
+bool copy_present_wanted(AuroraBackend backend) noexcept {
+#ifdef AURORA_COPY_PRESENT
+  if (backend != BACKEND_OPENGLES || env_is("AURORA_PRESENT", "surface")) {
+    return false;
+  }
+  if (env_is("AURORA_PRESENT", "copy")) {
+    return true;
+  }
+  const char* driver = SDL_GetCurrentVideoDriver();
+  return driver != nullptr && (SDL_strcmp(driver, "kmsdrm") == 0 || SDL_strcmp(driver, "offscreen") == 0);
+#else
+  (void)backend;
+  return false;
+#endif
+}
+
+bool copy_present_active() noexcept {
+#ifdef AURORA_COPY_PRESENT
+  return g_active;
+#else
+  return false;
+#endif
+}
+
+bool copy_present_start(SDL_Window* window) noexcept {
+#ifdef AURORA_COPY_PRESENT
+  if (g_renderer == nullptr) {
+    // SDL's OpenGL ES renderer first (it flips KMSDRM's buffers itself), then whatever SDL has
+    for (const char* name : {"opengles2", static_cast<const char*>(nullptr)}) {
+      g_renderer = SDL_CreateRenderer(window, name);
+      if (g_renderer != nullptr) {
+        break;
+      }
+      Log.warn("SDL renderer {} unavailable: {}", name != nullptr ? name : "(default)", SDL_GetError());
+    }
+    if (g_renderer == nullptr) {
+      return false;
+    }
+    Log.info("Copy present through SDL renderer {}", SDL_GetRendererName(g_renderer));
+    // the render worker draws with it from now on: the GL context must not stay current here
+    SDL_GL_MakeCurrent(window, nullptr);
+    g_rendererVsync = -1;
+  }
+  g_active = true;
+  return true;
+#else
+  (void)window;
+  return false;
+#endif
+}
+
+void copy_present_adapter_options(wgpu::RequestAdapterOptions& options) noexcept {
+#if defined(AURORA_COPY_PRESENT) && defined(WEBGPU_DAWN)
+  // Dawn on SDL's EGL display (KMSDRM: the GBM one), not EGL_DEFAULT_DISPLAY: one display for both, on drivers
+  // whose default display is not the screen's (or none without X11)
+  static dawn::native::opengl::RequestAdapterOptionsGetGLProc glProc;
+  if (!g_active) {
+    return;
+  }
+  const auto display = SDL_EGL_GetCurrentDisplay();
+  const auto getProc = SDL_EGL_GetProcAddress("eglGetProcAddress");
+  if (display == nullptr || getProc == nullptr) {
+    Log.info("No SDL EGL display; Dawn opens its own");
+    return;
+  }
+  glProc.getProc = reinterpret_cast<dawn::native::opengl::EGLGetProcProc>(getProc);
+  glProc.display = display;
+  // (in place of gpu.cpp's libEGL.so.1 one, if any: this one names the display too)
+  glProc.nextInChain = nullptr;
+  options.nextInChain = &glProc;
+#else
+  (void)options;
+#endif
+}
+
+void copy_present_resize(uint32_t width, uint32_t height) noexcept {
+#ifdef AURORA_COPY_PRESENT
+  if (!g_active || (g_target && width == g_width && height == g_height)) {
+    return;
+  }
+  g_width = width;
+  g_height = height;
+  g_bytesPerRow = (width * 4 + 255) & ~255u;
+  const wgpu::TextureDescriptor textureDescriptor{
+      .label = "Copy present target",
+      .usage = wgpu::TextureUsage::RenderAttachment | wgpu::TextureUsage::CopySrc,
+      .size = {width, height, 1},
+      .format = wgpu::TextureFormat::RGBA8Unorm,
+  };
+  g_target = g_device.CreateTexture(&textureDescriptor);
+  for (auto& readback : g_readbacks) {
+    const wgpu::BufferDescriptor bufferDescriptor{
+        .label = "Copy present readback",
+        .usage = wgpu::BufferUsage::CopyDst | wgpu::BufferUsage::MapRead,
+        .size = static_cast<uint64_t>(g_bytesPerRow) * height,
+    };
+    readback.buffer = g_device.CreateBuffer(&bufferDescriptor);
+    readback.copied = false;
+  }
+  if (g_sdlTexture != nullptr) {
+    SDL_DestroyTexture(g_sdlTexture);
+  }
+  // RGBA bytes in memory, as the GPU wrote them
+  g_sdlTexture = SDL_CreateTexture(g_renderer, SDL_PIXELFORMAT_RGBA32, SDL_TEXTUREACCESS_STREAMING,
+                                   static_cast<int>(width), static_cast<int>(height));
+  if (g_sdlTexture == nullptr) {
+    Log.error("Failed to create the copy present texture: {}", SDL_GetError());
+  } else {
+    SDL_SetTextureScaleMode(g_sdlTexture, SDL_SCALEMODE_NEAREST);
+  }
+#else
+  (void)width;
+  (void)height;
+#endif
+}
+
+wgpu::Texture copy_present_target() noexcept {
+#ifdef AURORA_COPY_PRESENT
+  return g_active ? g_target : wgpu::Texture{};
+#else
+  return {};
+#endif
+}
+
+void copy_present_encode(const wgpu::CommandEncoder& encoder) noexcept {
+#ifdef AURORA_COPY_PRESENT
+  if (!g_active || !g_target) {
+    return;
+  }
+  auto& readback = g_readbacks[g_next];
+  if (readback.copied) {
+    return; // (not shown yet: this frame is dropped rather than wait)
+  }
+  const wgpu::TexelCopyTextureInfo source{.texture = g_target};
+  const wgpu::TexelCopyBufferInfo destination{
+      .layout = {.bytesPerRow = g_bytesPerRow, .rowsPerImage = g_height},
+      .buffer = readback.buffer,
+  };
+  const wgpu::Extent3D size{g_width, g_height, 1};
+  encoder.CopyTextureToBuffer(&source, &destination, &size);
+  readback.copied = true;
+#else
+  (void)encoder;
+#endif
+}
+
+bool copy_present_show(bool vsync) noexcept {
+#ifdef AURORA_COPY_PRESENT
+  if (!g_active || g_renderer == nullptr) {
+    return false;
+  }
+  // this frame's copy waits in its buffer while the one before is drawn (the first frame: nothing yet), and the
+  // next frame copies into the buffer just drawn
+  const size_t previous = (g_next + 1) % g_readbacks.size();
+  g_next = previous;
+  auto& readback = g_readbacks[previous];
+  if (!readback.copied) {
+    return true;
+  }
+  bool mapped = false;
+  const auto future = readback.buffer.MapAsync(wgpu::MapMode::Read, 0, wgpu::kWholeMapSize,
+                                               wgpu::CallbackMode::WaitAnyOnly,
+                                               [&mapped](wgpu::MapAsyncStatus status, wgpu::StringView message) {
+                                                 mapped = status == wgpu::MapAsyncStatus::Success;
+                                                 if (!mapped) {
+                                                   Log.warn("Copy present map failed: {}", message);
+                                                 }
+                                               });
+  if (g_instance.WaitAny(future, UINT64_MAX) != wgpu::WaitStatus::Success || !mapped) {
+    readback.copied = false;
+    return false;
+  }
+  const void* pixels = readback.buffer.GetConstMappedRange(0, wgpu::kWholeMapSize);
+  if (pixels != nullptr && g_sdlTexture != nullptr) {
+    SDL_UpdateTexture(g_sdlTexture, nullptr, pixels, static_cast<int>(g_bytesPerRow));
+  }
+  readback.buffer.Unmap();
+  readback.copied = false;
+  if (g_rendererVsync != (vsync ? 1 : 0)) {
+    g_rendererVsync = vsync ? 1 : 0;
+    SDL_SetRenderVSync(g_renderer, g_rendererVsync);
+  }
+  SDL_SetRenderDrawColor(g_renderer, 0, 0, 0, 255);
+  SDL_RenderClear(g_renderer);
+  if (g_sdlTexture != nullptr) {
+    SDL_RenderTexture(g_renderer, g_sdlTexture, nullptr, nullptr);
+  }
+  return SDL_RenderPresent(g_renderer);
+#else
+  (void)vsync;
+  return false;
+#endif
+}
+
+void copy_present_shutdown() noexcept {
+#ifdef AURORA_COPY_PRESENT
+  for (auto& readback : g_readbacks) {
+    readback = {};
+  }
+  g_target = {};
+  if (g_sdlTexture != nullptr) {
+    SDL_DestroyTexture(g_sdlTexture);
+    g_sdlTexture = nullptr;
+  }
+  if (g_renderer != nullptr) {
+    SDL_DestroyRenderer(g_renderer);
+    g_renderer = nullptr;
+  }
+  g_active = false;
+  g_width = g_height = 0;
+#endif
+}
+} // namespace aurora::webgpu
