+#pragma once
+
+// Copy present (copy_present.cpp): frames read back and shown through an SDL renderer where Dawn has no surface
+// (Linux KMSDRM: handhelds without X11 or Wayland).
+#include <aurora/aurora.h>
+
+#include "wgpu.hpp"
+
+#if defined(__linux__) && !defined(__ANDROID__) && !defined(__EMSCRIPTEN__) && defined(DAWN_ENABLE_BACKEND_OPENGLES)
+#define AURORA_COPY_PRESENT 1
+#endif
+
+struct SDL_Window;
+
+namespace aurora::webgpu {
+// The backend presents this way on this window system (a window made for it needs OpenGL: window.cpp)
+bool copy_present_wanted(AuroraBackend backend) noexcept;
+bool copy_present_active() noexcept;
+// The SDL renderer made (on the main thread, which then lets go of its GL context); the mode on
+bool copy_present_start(SDL_Window* window) noexcept;
+// Dawn's adapter on SDL's EGL display
+void copy_present_adapter_options(wgpu::RequestAdapterOptions& options) noexcept;
+// The target and readback buffers for a surface this size
+void copy_present_resize(uint32_t width, uint32_t height) noexcept;
+// What the frame is drawn into instead of a surface texture
+wgpu::Texture copy_present_target() noexcept;
+// The target's copy into a readback buffer, last in the frame's commands
+void copy_present_encode(const wgpu::CommandEncoder& encoder) noexcept;
+// After the submit: the frame before drawn and flipped to the screen
+bool copy_present_show(bool vsync) noexcept;
+void copy_present_shutdown() noexcept;
+} // namespace aurora::webgpu
