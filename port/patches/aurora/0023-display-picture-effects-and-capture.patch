 lib/webgpu/picture.cpp   | 546 +++++++++++++++++++++++++++++++++++++++
 6 files changed, 611 insertions(+)
 create mode 100644 include/aurora/picture.h
 create mode 100644 lib/webgpu/picture.cpp

