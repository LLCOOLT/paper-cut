From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LLCOOLT <114613597+LLCOOLT@users.noreply.github.com>
Date: Wed, 11 Nov 2026 12:00:00 -0500
Subject: [PATCH] gfx: pipelines compile on several threads on Vulkan, Metal and D3D12

The pipeline queue had one compile thread. On Vulkan, Metal and D3D12 there
are now a third of the CPU's threads, 1 to 3 (4 threads: 1, as before; 6-8:
2; 9 and more: 3); OpenGL and D3D11 keep one. $AURORA_PIPELINE_THREADS=N
(1-8) says, and the log names the count ("Pipeline compile threads: 3").
Each worker waits on the queue through its predicate (another may have taken
what was left); what a create touches was already per-pipeline, and the one
static flag in the shader builder is an atomic.
---
diff --git a/lib/gfx/pipeline_cache.cpp b/lib/gfx/pipeline_cache.cpp
index 0ed3681..64b0faf 100644
--- a/lib/gfx/pipeline_cache.cpp
+++ b/lib/gfx/pipeline_cache.cpp
@@ -26,7 +26,9 @@
 #include <ranges>
 #include <variant>
 #include <thread>
+#include <vector>
 
+#include <SDL3/SDL_cpuinfo.h>
 #include <SDL3/SDL_iostream.h>
 #include <SDL3/SDL_stdinc.h>
 #include <absl/container/flat_hash_map.h>
@@ -83,7 +85,9 @@ constexpr size_t BuildPipelinesPerFrame = 5;
 #else
 constexpr size_t BuildPipelinesPerFrame = 1;
 #endif
-static std::thread g_pipelineThread;
+// The compile threads: several where the backend builds pipelines on any thread at once (Vulkan, Metal,
+// D3D12), one elsewhere (OpenGL's contexts, D3D11)
+static std::vector<std::thread> g_pipelineThreads;
 static std::atomic_bool g_pipelineThreadEnd = false;
 static std::condition_variable g_pipelineQueueCv;
 static std::condition_variable g_pipelineReadyCv;
@@ -1020,17 +1024,15 @@ static void pipeline_worker() {
   tracy::SetThreadName("Pipeline compilation thread");
 #endif
 
-  bool hasMore = false;
   while (g_hasPipelineThread || g_pipelinesPerFrame < BuildPipelinesPerFrame) {
     PendingPipeline pending;
     {
       std::unique_lock lock{g_pipelineMutex};
       if (g_hasPipelineThread) {
-        if (!hasMore) {
-          g_pipelineQueueCv.wait(lock, [] {
-            return !g_pipelineQueue.empty() || !g_backgroundPipelineQueue.empty() || g_pipelineThreadEnd;
-          });
-        }
+        // (always through the predicate: with several threads, another may have taken what was left)
+        g_pipelineQueueCv.wait(lock, [] {
+          return !g_pipelineQueue.empty() || !g_backgroundPipelineQueue.empty() || g_pipelineThreadEnd;
+        });
       } else if (g_pipelineQueue.empty() && g_backgroundPipelineQueue.empty()) {
         return;
       }
@@ -1047,7 +1049,6 @@ static void pipeline_worker() {
       std::lock_guard lock{g_pipelineMutex};
       g_pipelines.try_emplace(pending.hash, std::move(result));
       g_pendingPipelines.erase(pending.hash);
-      hasMore = !g_pipelineQueue.empty() || !g_backgroundPipelineQueue.empty();
     }
     if (!g_hasPipelineThread) {
       g_pipelinesPerFrame += std::max(1u, pipelineCount);
@@ -1199,6 +1200,23 @@ void rebuild_pipeline_cache() {
   }
 }
 
+// Vulkan, Metal and D3D12 compile on any thread at once: a third of the CPU's threads, 1 to 3 (4 threads: 1, as
+// before, 6-8: 2, 9 and more: 3), so a new room's pipelines build sooner without taking the game's own threads.
+// OpenGL (its contexts) and D3D11 keep one. $AURORA_PIPELINE_THREADS=N (1-8) says.
+static size_t pipeline_thread_count() {
+  if (const char* env = SDL_getenv("AURORA_PIPELINE_THREADS"); env != nullptr && env[0] != '\0') {
+    return static_cast<size_t>(std::clamp(SDL_atoi(env), 1, 8));
+  }
+  switch (webgpu::g_backendType) {
+  case wgpu::BackendType::Vulkan:
+  case wgpu::BackendType::Metal:
+  case wgpu::BackendType::D3D12:
+    return static_cast<size_t>(std::clamp(SDL_GetNumLogicalCPUCores() / 3, 1, 3));
+  default:
+    return 1;
+  }
+}
+
 void initialize_pipeline_cache() {
   g_pipelineCacheBroken = false;
   g_pipelineCacheWriterStop = false;
@@ -1209,7 +1227,11 @@ void initialize_pipeline_cache() {
     g_hasPipelineThread = false;
   } else {
     g_hasPipelineThread = true;
-    g_pipelineThread = std::thread(pipeline_worker);
+    const size_t threads = pipeline_thread_count();
+    Log.info("Pipeline compile threads: {}", threads);
+    for (size_t i = 0; i < threads; ++i) {
+      g_pipelineThreads.emplace_back(pipeline_worker);
+    }
   }
 
   const size_t loadedCount = load_pipeline_cache();
@@ -1228,7 +1250,10 @@ void shutdown_pipeline_cache() {
     g_pipelineThreadEnd = true;
     g_pipelineQueueCv.notify_all();
     g_pipelineReadyCv.notify_all();
-    g_pipelineThread.join();
+    for (auto& thread : g_pipelineThreads) {
+      thread.join();
+    }
+    g_pipelineThreads.clear();
   }
   g_hasPipelineThread = false;
 
