<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Configured by port/ios/ios.cmake (@ONLY). One app per game version. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>@TTYD_EXE_NAME@</string>
	<key>CFBundleIdentifier</key>
	<string>@TTYD_IOS_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@TTYD_EXE_NAME@</string>
	<key>CFBundleDisplayName</key>
	<string>@TTYD_IOS_DISPLAY_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@TTYD_IOS_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@TTYD_IOS_BUILD@</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>@TTYD_IOS_PLATFORM_NAME@</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>@TTYD_IOS_DEPLOYMENT_TARGET@</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>

	<!-- Icons: Paper Cut's logo (port/assets/icon/ios), no game art. -->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon60x60</string>
			</array>
		</dict>
	</dict>
	<key>CFBundleIcons~ipad</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon60x60</string>
				<string>AppIcon76x76</string>
				<string>AppIcon83.5x83.5</string>
			</array>
		</dict>
	</dict>

	<!-- Full screen, landscape or portrait (the settings' Orientation narrows it
	     at run time, SDL_HINT_ORIENTATIONS: port/src/aurora/layout_aurora.c). A
	     launch screen entry is what gives the app the device's full screen size
	     instead of a letterboxed compatibility mode. -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- The app's Documents folder appears in the Files app (On My iPhone/iPad)
	     and in Finder's file sharing: the disc image goes there, saves are in
	     its Saves folder. -->
	<key>UIFileSharingEnabled</key>
	<true/>

	<!-- Screenshots (the settings page) are added to Photos. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Screenshots you take in the game are saved to your photo library.</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- Game controllers (MFi, Xbox, PlayStation, Switch Pro) through SDL3. -->
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<!-- ProMotion: without it iOS caps an iPhone app at 60 Hz (the in-between
	     frames of framerate=120/display, port/src/aurora/interp_aurora.c). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
