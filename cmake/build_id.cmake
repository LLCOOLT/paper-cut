# The build's commit, for telling two builds of the same version apart
# (port/include/port/build_id.h): run at every build by the ttyd_build_id
# target, it writes OUT only when the commit changed, so nothing rebuilds
# otherwise. Without git (a source archive) the id is empty.
#   cmake -DSRC=<source dir> -DOUT=<generated .c> -P build_id.cmake
set(_id "")
find_program(_git git)
if(_git)
    execute_process(COMMAND ${_git} rev-parse --short=9 HEAD WORKING_DIRECTORY ${SRC}
        OUTPUT_VARIABLE _id OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result ERROR_QUIET)
    if(NOT _result EQUAL 0 OR NOT _id MATCHES "^[0-9a-f]+$")
        set(_id "")
    endif()
endif()
set(_c "/* GENERATED by cmake/build_id.cmake at each build. Do not edit. */\nconst char portBuildIdText[] = \"${_id}\";\n")
set(_old "")
if(EXISTS ${OUT})
    file(READ ${OUT} _old)
endif()
if(NOT _old STREQUAL _c)
    file(WRITE ${OUT} "${_c}")
endif()
