# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py   text

# Enforce platform-specific encodings
*.bat  text eol=crlf
*.sh   text eol=lf
*.sha1 text eol=lf
# read by Linux tools in the release container (appimagetool refuses a CRLF desktop entry)
*.desktop      text eol=lf
*.metainfo.xml text eol=lf

# decomp-toolkit writes files with LF
config/**/*.txt  text eol=lf

# Patches apply byte for byte (port/patches)
*.patch -text

# Binary assets (port/assets): never line-ending converted
*.ttf  binary
*.png  binary
*.ico  binary
*.icns binary
*.rgba binary

# Binary data (port/assets): never line-ending converted
*.bin binary
